<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_send_survey_view" model="ir.ui.view">
        <field name="name">Enviar Encuesta de Salida</field>
        <field name="model">send.survey</field>
        <field name="arch" type="xml">
            <form string="Enviar Formulario">
                <group col="2">
                    <field name="emails" required="1" placeholder="separe los correos por coma"/>
                    <field name="employee_id" invisible="1"/>
                </group>
                <label for="body_email" string="Contenido del correo"/>
                <field name="body_email"/>
                <footer>
                    <button string="Enviar" type="object" class="oe_highlight" name="send_email_form"/>
                    <button string="Cancelar" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_send_survey_wizard" model="ir.actions.act_window">
        <field name="name">Enviar Formulario</field>
        <field name="res_model">send.survey</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_send_survey_view"/>
        <field name="target">new</field>
    </record>
</odoo>