<odoo>
    <data noupdate="1">
        <record id="hr_employee_export_name_field" model="ir.exports.line">
            <field name="name">name</field>
        </record>
        <record id="hr_employee_export_birthday_field" model="ir.exports.line">
            <field name="name">birthday</field>
        </record>
        <record id="hr_employee_export_next_birthday_field"
                model="ir.exports.line">
            <field name="name">next_birthday</field>
        </record>
        <record id="hr_employee_custom_export" model="ir.exports">
            <field name="name">Cumpleaños</field>
            <field name="resource">hr.employee</field>
            <field name="export_fields"
                   eval="[(6, 0, [ref('hr_employee_export_name_field'), ref('hr_employee_export_birthday_field'), ref('hr_employee_export_next_birthday_field')])]"/>
        </record>
    </data>


    <record id="hr_employee_birthday_filter" model="ir.ui.view">
        <field name="name">hr.employee.hremployeeinfo.filter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Cumpleaños del Mes"
                        name="this_month_birthdays"
                        domain="[('birthday', 'like', context_today().strftime('-%m-%'))]"/>
                <filter string="Cumpleaños del Próximo Mes"
                        name="next_month_birthdays"
                        domain="[('birthday','!=',False),('birthday_month', '=', context_today().month + 1)]"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_gamification_inh" model="ir.ui.view">
        <field name="name">hr.employee.gami.inh</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_gamification.hr_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <page name="received_badges" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>
        </field>
    </record>

    <record id="cm_employee_birthday_view_form" model="ir.ui.view">
        <field name="name">hr_payroll_cm.hremployeeinfo.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- PRINCIPAL -->
            <xpath expr="//h5[./field[@name='mobile_phone']]" position="after">
                <h5 class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-star fa-fw me-1 text-primary" title="Custom Field"/>
                    <field name="employee_no" placeholder="Custom Field" class="w-100 w-sm-75"/>
                </h5>
            </xpath>

            <page name="resume" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>

            <field name="parent_id" position="replace">
                <field name="parent_id" widget="many2one_avatar_employee" string="Superior inmediato" options="{'no_create': True}"/>
            </field>

            <!-- NOTEBOOK INFORMACION PRIVADA -->

            <xpath expr="//field[@name='identification_id']" position="after">
                <field name="format_identification_id"/>
            </xpath>

            <group name="hr_birth_group" position="replace">
                <group string="Informacion Personal" name="hr_birth_group">
                    <field name="legal_name"/>
                    <label for="birthday"/>
                    <div class="o_row" name="div_km_home_work">
                        <field name="birthday" class="o_hr_narrow_field"/>
                        <span invisible="not birthday" >
                            <label for="birthday_public_display" class="fw-bold text-900 form-check-label ms-3"/>
                            <field name="birthday_public_display" class="ms-3"/>
                        </span>
                    </div>
                    <field name="next_birthday"/>
                    <label for="place_of_birth"/>
                    <div class="o_row" name="birth_location">
                        <field name="place_of_birth" class="oe_inline o_hr_narrow_field" nolabel="1" placeholder="Ciudad"/>
                        <div class="mx-3 flex-grow-0">─</div>
                        <field name="country_of_birth" class="oe_inline o_hr_narrow_field" nolabel="1" placeholder="Pais"/>
                    </div>
                    <field name="sex" string="Genero"/>
                    <field name="birthday_month" invisible="1"/>
                </group>
            </group>

            <!-- CIUDADANÍA -->
            <xpath expr="//field[@name='distance_home_work']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='distance_home_work_unit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ESTADO FAMILIAR-->
            <xpath expr="//field[@name='spouse_birthdate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='personal_information']/group/group[4]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- PESTAÑA AJUSTES DE RR.HH-->
            <!-- <xpath
                expr="//sheet/notebook/page[@name='hr_settings']/group/group[@name='active_group']/field[@name='user_id']"
                position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath> -->
            <field name="department_id" position="after">
                <field name="branch_id"/>
            </field>
        </field>
    </record>

</odoo>
