<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_digital_sign_creator_form" model="ir.ui.view">
        <field name="name">digital.creator.form</field>
        <field name="model">digital.sign.creator</field>
        <field name="arch" type="xml">
            <form string="Firma Digital" create="false">
                <header>
                    <button string="Descargar Firma" name="action_download_sign" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="job" readonly="1" force_save="1"/>
                            <field name="mobile" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="address" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_digital_sign_creator" model="ir.actions.act_window">
        <field name="name">Creador Firma Digital</field>
        <field name="res_model">digital.sign.creator</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
