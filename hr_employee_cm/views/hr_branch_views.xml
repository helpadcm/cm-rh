<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_branch_form" model="ir.ui.view">
        <field name="name">hr.branch.form</field>
        <field name="model">hr.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id"/>
                        <field name="city_id"/>
                        <field name="parent_id"/>
                        <field name="manager_id"/>
                        <field name="active"/>
                        <field name="color"/>
                    </group>
                    <notebook>
                        <page string="Child Branches">
                            <field name="child_ids"/>
                        </page>
                        <page string="Employees">
                            <field name="employee_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_hr_branch_tree" model="ir.ui.view">
        <field name="name">hr.branch.tree</field>
        <field name="model">hr.branch</field>
        <field name="arch" type="xml">
            <tree string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="city_id"/>
                <field name="manager_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_branch_search" model="ir.ui.view">
        <field name="name">hr.branch.search</field>
        <field name="model">hr.branch</field>
        <field name="arch" type="xml">
            <search string="Search Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="city_id"/>
                <group expand="1" string="Group By">
                    <filter string="City" name="group_by_city" context="{'group_by':'city_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">hr.branch</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_hr_branch"
            name="Branches"
            parent="hr.menu_config_employee"
            groups="hr.group_hr_user"
            sequence="90"
            action="action_hr_branch"/>
</odoo>
