<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_talento" model="ir.ui.view">
        <field name="name">product.template.form.inherit.talento</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Ubicamos el check y su etiqueta exactamente después del texto/etiqueta de Compras -->
            <xpath expr="//label[@for='purchase_ok']" position="after">
                <field name="is_talento_humano"/>
                <label for="is_talento_humano" string="Para TH"/>
            </xpath>
        </field>
    </record>
</odoo>