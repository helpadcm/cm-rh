<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_create_portal_user_to_employee" model="ir.cron">
            <field name="name">Creacion de Usuarios del Portal</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.cron_create_portal_user_to_employee()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=7) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
     </record>
    </data>
</odoo>