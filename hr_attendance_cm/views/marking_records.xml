<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_real_marking_form" model="ir.ui.view">
        <field name="name">real.marking.employees.form</field>
        <field name="model">real.marking.employees</field>
        <field name="arch" type="xml">
            <form string="Attendance Device">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button string="Asistencias" name="show_absences" type="object" class="oe_stat_button" icon="fa-calendar"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="marking" string="Marcajes">
                            <field name="marking_ids" readonly="1" create="false" delete="false">
                                <list>
                                    <field name="date"/>
                                    <field name="clock_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_real_marking_tree" model="ir.ui.view">
        <field name="name">real.marking.employees.tree</field>
        <field name="model">real.marking.employees</field>
        <field name="arch" type="xml">
            <list string="Marcajes Reales">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="qty_marks"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_real_marking_search" model="ir.ui.view">
        <field name="name">real.marking.employees.search</field>
        <field name="model">real.marking.employees</field>
        <field name="arch" type="xml">
            <search string="Busqueda de marcajes reales">
                <field name="employee_id"/>
                <group>
                    <filter string="Empleado" name="group_by_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Fecha" name="group_by_date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_marking" model="ir.actions.act_window">
        <field name="name">Marcajes Reales</field>
        <field name="res_model">real.marking.employees</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_group_by_employee":1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the list
            </p>
        </field>
    </record>
</odoo>
