<odoo>
    <data noupdate="1">
        <record id="ir_cron_get_marking" model="ir.cron">
            <field name="name">Marcajes: Obtener marcajes de reloj</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.connect_ws()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="ir_cron_create_attendance" model="ir.cron">
            <field name="name">Marcajes: Crear asistencias</field>
            <field name="model_id" ref="hr_attendance_cm.model_real_marking_employees"/>
            <field name="state">code</field>
            <field name="code">model.create_attendance()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
