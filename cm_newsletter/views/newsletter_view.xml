<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="newsletter_list_view" model="ir.ui.view">
            <field name="name">Lista de Newsletter</field>
            <field name="model">cm.newsletter.list</field>
            <field name="arch" type="xml">
                <list string="Newsletter" editable="bottom">
                    <field name="name"/>
                    <field name="lenguage"/>
                    <field name="date"/>
                    <field name="country"/>
                </list>
            </field>
        </record>

        <record id="action_newsletter_list" model="ir.actions.act_window">            
            <field name="name">Newsletter</field>
            <field name="res_model">cm.newsletter.list</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>