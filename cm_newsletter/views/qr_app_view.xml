<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_qr_generator_form" model="ir.ui.view">
            <field name="name">qr.generator.form</field>
            <field name="model">qr.generator</field>
            <field name="arch" type="xml">
                <form string="Generador de Código QR">
                    <header>
                        <button name="download_qr"
                            type="object"
                            string="Download QR"
                            class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="qr_url" widget="url" readonly="1"/>
                            <field name="qr_filename" />
                        </group>

                        <group>
                            <field name="qr_image"
                                widget="image"
                                options="{'size': [500, 500]}"
                                filename="qr_filename"
                                readonly="1"
                                class="oe_avatar"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_qr_generator_tree" model="ir.ui.view">
            <field name="name">qr.generator.tree</field>
            <field name="model">qr.generator</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="qr_url"/>
                </list>
            </field>
        </record>

        <record id="action_qr_generator" model="ir.actions.act_window">
            <field name="name">Generador de QR</field>
            <field name="res_model">qr.generator</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>