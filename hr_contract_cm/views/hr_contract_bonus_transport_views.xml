<odoo>
    <record id="hr_contract_bonus_trasport" model="ir.ui.view">
        <field name="name">hr_contract_cm.hr_contract_bonus_transport.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hr_responsible_id']" position="after">
                <field name="early_checkin_bonus_time"/>
                <field name="late_checkout_bonus_time"/>
                <field name="max_extra_hours"/>
                <field name="maximus_performance_bonus"/>
                <field name="monthly_wage"/>
                <field name="transportation_bonus"/>
                <field name="value_bonus" />
            </xpath>
        </field>
    </record>
</odoo>