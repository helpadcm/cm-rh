<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_payslip_cm_line_tree" model="ir.ui.view">
        <field name="name">hr.payslip_cm.line.tree</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <tree string="Salary Structure" edit="0" create="0" delete="0">
                <field name="slip_id"/>
                <field name="name"/>
                <field name="code" readonly="1" force_save="1" optional="hide"/>
                <field name="category_id" readonly="1" force_save="1"/>
                <field name="sequence" readonly="1" column_invisible="True" force_save="1"/>
                <field name="quantity" readonly="1" force_save="1"/>
                <field name="rate" readonly="1" force_save="1"/>
                <field name="salary_rule_id" groups="base.group_no_one" readonly="1" force_save="1"/>
                <field name="amount" readonly="1" force_save="1"/> 
                <field name="total" readonly="1" force_save="1" sum="Total Neto"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_view_payslip_lines" model="ir.actions.act_window">
        <field name="name">Lineas de nomina</field>
        <field name="res_model">hr.payslip.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_payslip_cm_line_tree"/>
    </record>
</odoo>
