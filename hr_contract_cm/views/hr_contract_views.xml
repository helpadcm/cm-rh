<odoo>
    <record id="hr_contract_bonus_transport_inherit" model="ir.ui.view">
        <field name="name">hr_contract_cm.hr_contract_bonus_transport_inherit
        </field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hr_responsible_id']" position="after">
                <field name="early_checkin_bonus_time" widget="float_time"/>
                <field name="late_checkout_bonus_time" widget="float_time"/>
                <field name="max_extra_hours"/>
                <field name="max_performance_bonus"/>
                <field name="max_transportation_bonus"/>
                <field name="value_bonus"/>
            </xpath>
        </field>
    </record>
</odoo>
