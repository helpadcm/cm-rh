<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="general_invoice_vizard_view" model="ir.ui.view">
        <field name="name">Reporte de Facturas</field>
        <field name="model">cm_reports.invoice_reports</field>
        <field name="arch" type="xml">
            <form string="Opciones de reporte">
                <group col="2">
                    <group>
                        <field name="type_of"  required="1"/>
                        <field name="date_from"/>
                        <field name="show_detail"/>
                    </group>
                    <group>
                        <field name="group_ledger"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company" required="1"/>
                    </group>
                </group>
                <label for="partner_ids"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <footer>
                    <button name="check_report" string="Imprimir" type="object" default_focus="1" class="oe_highlight"/>
                    <button name="check_report" string="Excel" type="object" default_focus="0" class="oe_highlight" context="{'export_excel':True}"/>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_wizard_menu" model="ir.actions.act_window">
        <field name="name">Reporte de Facturas</field>
        <field name="res_model">cm_reports.invoice_reports</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="general_invoice_vizard_view"/>
        <field name="target">new</field>
    </record>
</odoo>
