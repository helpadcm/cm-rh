<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_check_list_view" model="ir.ui.view">
        <field name="name">Check List</field>
        <field name="model">report_check.wizard_check_list</field>
        <field name="arch" type="xml">
        <form string="Report Options">
            <group>
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="payment_date_start" />
                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                </group>
                <group>
                    <field name="journal_id" domain="[('type','=','bank')]" options="{'no_create': True}"/>
                    <field name="payment_date_end" />
                    <field name="state" />
                </group>
            </group>
            <footer>
                <button name="check_report" string="Imprimir"  type="object" class="oe_highlight"/>
                <button name="check_report" string="Excel" type="object" class="oe_highlight" context="{'export_excel':True}"/>
                <button string="Cancelar" class="oe_link" special="cancel" />
            </footer>
        </form>
        </field>
    </record>

    <record id="action_check_list_wizard_menu" model="ir.actions.act_window">
        <field name="name">Report Check List</field>
        <field name="res_model">report_check.wizard_check_list</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_check_list_view"/>
        <field name="target">new</field>
    </record>

</odoo>
