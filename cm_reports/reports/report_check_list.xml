<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_check_list">
            <t t-call="web.html_container">
                <head>
                    <meta charset="utf-8"/>
                </head>
                <t t-set="company" t-value="res_company"></t>	
                <div class="page" style="font-size:15px sans-serif;">
                    <t t-if="len(info_report)>0">
                        <style>
                            td{
                                font-size:11px;
                                text-align:center
                            }
                            .td_filter{
                                text-align:left;
                                border:0px;
                            }

                        </style>
                        <div>
                            <table style="align:center;width:100%">
                                <tbody>
                                    <tr style="height: 20px;padding:0px;border:0px ;" >
                                        <td style="width:20%;" rowspan="4">
                                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="height: 150px;" alt="Logo"/>
                                        </td>
                                        <td style="text-align:center;font-size:28px"><strong><span t-field="company.name"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:center;font-size:20px"><strong><span t-field="company.company_motto"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:center;font-size:20px"><strong>LISTA DE CHEQUES</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <table style="width:100%;">
                            <t t-foreach="info_wizard" t-as="a">
                                <tr>
                                    <t t-if="a.partner_id">
                                        <td class="td_filter" ><strong>Beneficiario: <t t-esc="a.partner_id.name"/></strong></td>
                                    </t>
                                    <t t-if="a.payment_date_start">
                                        <td class="td_filter" ><strong>Fecha Inicio: <t t-esc="a.payment_date_start"/></strong></td>
                                    </t>
                                    <t t-if="a.payment_date_end">
                                        <td class="td_filter" ><strong>Fecha Fin: <t t-esc="a.payment_date_end"/></strong></td>
                                    </t>
                                    <t t-if="a.journal_id">
                                        <td class="td_filter" ><strong>Diario: <t t-esc="a.journal_id.name"/></strong></td>
                                    </t>
                                </tr>
                            </t>
                        </table>
                        <table style="width:100%;border-collapse:collapse;margin-top:1%">
                            <tbody>
                                <tr>
                                    <td style="width:10%;border-bottom:1px solid black"><strong>Número</strong></td>
                                    <td style="width:23%;border-bottom:1px solid black"><strong>Beneficiario</strong></td>
                                    <td style="width:15%;border-bottom:1px solid black"><strong>Asunto</strong></td>
                                    <td style="width:12%;border-bottom:1px solid black"><strong>Diario</strong></td>
                                    <td style="width:11%;border-bottom:1px solid black"><strong>Cuenta Bancaria</strong></td>
                                    <td style="width:10%;border-bottom:1px solid black"><strong>Monto</strong></td>
                                    <td style="width:9%;border-bottom:1px solid black"><strong>Fecha</strong></td>
                                    <td style="width:9%;border-bottom:1px solid black"><strong>Estado</strong></td>
                                </tr>
                                <t t-foreach="info_report" t-as="o">
                                    <tr>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)"><t t-esc="o.get('number')"/></td>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)"><t t-esc="o.get('beneficiary')"/></td>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)"><t t-esc="o.get('affair')"/></td>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)"><t t-esc="o.get('journal')"/></td>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)" ><t t-esc="o.get('bank_account')"/></td>
                                        <td style="text-align:right;padding-right:2px;border-bottom:1px solid rgb(218, 218, 218)"><t t-esc="o.get('currency')"/> <t t-esc="'{0:,.2f}'.format(o.get('amount'))"/></td>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)" ><t t-esc="o.get('date')"/></td>
                                        <td style="border-bottom:1px solid rgb(218, 218, 218)" ><t t-esc="o.get('state')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
                <div class="footer" style="border-top:1px solid black">
                    sdfsdfsd
                    <div class="text-center">
                        <t t-if="company.street">
                            <strong>Calle: <span t-field="company.street"/></strong>
                        </t>
                        <t t-if="company.website">
                            <strong>Sitio Web: <span t-field="company.website"/></strong>
                        </t>
                        <t t-if="company.phone">
                            <strong>Teléfono: <span t-field="company.phone"/></strong>
                        </t>
                        <t t-if="company.company_registry">
                            <strong>RTN: <span t-field="company.company_registry"/></strong>
                        </t>
                    </div> 
                </div>
            </t>
        </template>
    </data>
</odoo>