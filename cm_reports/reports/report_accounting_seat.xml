<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="accounting_seat">
            <t t-call="web.html_container">
                <head>
                    <meta charset="utf-8"/>
                </head>
                <t t-set="company" t-value="res_company"></t>	
                <t t-set="symbol" t-value="company.currency_id.symbol"/>	
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="font-size:11px sans-serif;">
                        <table style="align:center;width:100%">
                            <tbody>
                                <tr style="height: 20px;padding:0px;border:0px ;" >
                                    <td style="width:20%;" rowspan="4">
                                        <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="width:230px;height:100px" alt="Logo"/>
                                    </td>
                                    <td style="text-align:center;font-size:28px"><strong><span t-field="company.name"/></strong></td>
                                </tr>
                                <tr>
                                    <td style="text-align:center;font-size:20px"><strong><span t-field="company.company_motto"/></strong></td>
                                </tr>
                                <tr>
                                    <td style="text-align:center;font-size:20px"><strong>Asiento Contable</strong></td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="width:100%;margin-top:1%">
                            <tbody>
                                <tr>
                                    <td><strong>Número de registro: <span t-field="o.name"/></strong></td>
                                    <td>Fecha: <span t-field="o.date"/></td>
                                </tr>
                                <tr>
                                    <td><strong><span t-field="o.partner_id.name"/></strong></td>
                                </tr>
                                <tr>
                                    <td><span t-field="o.ref"/></td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <table style="width:100%;margin-top:4%;border-collapse: collapse">
                            <style>
                                td{
                                    font-size:11px;
                                }
                            </style>
                            <t t-set="total_credit" t-value="0.00"/>
                            <t t-set="total_debit" t-value="0.00"/>
                            <t t-set="total_secondary" t-value="0.00"/>
                              <t t-set="symbol_secondary" t-value="''"/>
                            <tbody>
                                <tr>
                                    <td style="width:23%;border-bottom:1px solid black"><strong>Cuenta</strong></td>
                                    <td style="width:15%;border-bottom:1px solid black"><strong>C.Analitica</strong></td>
                                    <td style="width:17%;border-bottom:1px solid black"><strong>Descripción</strong></td>
                                    <td style="width:15%;border-bottom:1px solid black;text-align:right"><strong>Debitos</strong></td>
                                    <td style="width:15%;border-bottom:1px solid black;text-align:right"><strong>Creditos</strong></td>
                                    <td style="width:15%;border-bottom:1px solid black;text-align:right"><strong>Moneda Secundaria</strong></td>
                                </tr>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-set="symbol_secondary" t-value="line.currency_id.symbol" t-if="line.currency_id"/>
                                    <t t-set="total_debit" t-value="total_debit+line.debit"/>
                                    <t t-set="total_credit" t-value="total_credit+line.credit"/>
                                    <t t-set="total_secondary" t-value="total_secondary+line.amount_currency"/>
                                    <tr>
                                        <td style=""><span t-field="line.account_id.display_name"/></td>
                                        <td>
                                            <br></br>
                                        </td>
                                        <td style=""><span t-field="line.name"/></td>
                                        <td style="text-align:right"><span t-esc="symbol+'{0:,.2f}'.format(line.debit)"/></td>
                                        <td style="text-align:right"><span t-esc="symbol+'{0:,.2f}'.format(line.credit)"/></td>
                                        <td style="text-align:right"><span t-esc="symbol_secondary+'{0:,.2f}'.format(line.amount_currency)"/></td>
                                    </tr>
                                    <t t-if="line.analytic_distribution">
                                        <t t-foreach="line.analytic_distribution.items()" t-as="dist">
                                            <tr>
                                                <td><br></br></td>
                                                <td><span t-esc="line.env['account.analytic.account'].browse(int(dist[0])).name"/></td>
                                                <td><span t-esc="round((dist[1]/100)*line.amount_currency, 2)"/></td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                                <tr style="border-top:1px solid black">
                                    <td style="border-top:1px solid black"></td>
                                    <td style="border-top:1px solid black"></td>
                                    <td style="border-top:1px solid black">Total</td>
                                    <td style="text-align:right;border-top:1px solid black"><span t-esc="symbol+'{0:,.2f}'.format(total_debit)"/></td>
                                    <td style="text-align:right;border-top:1px solid black"><span t-esc="symbol+'{0:,.2f}'.format(total_credit)"/></td>
                                    <td style="text-align:right;border-top:1px solid black"><span t-esc="symbol_secondary+'{0:,.2f}'.format(total_secondary)"/></td>
                                </tr>
                            </tbody>
                            <table style="margin-top:5%;width:100%">
                                <tbody>
                                    <tr>
                                        <td>Impreso el: <span t-esc="datetime.datetime.strftime(datetime.datetime.now()-datetime.timedelta(hours=6),'%d/%m/%y %H:%M:%S %P')"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </table>

                    </div>
                    <div class="footer" style="border-top:1px solid black">
                        <div class="text-center">
                            Pág. <span class="page"/> de <span class="topage"/>
					    </div>
                        <div class="text-center" style="word-spacing: 10px">
                            <strong>Calle:</strong> <span t-field="company.street"/>   <strong>Sitio Web:</strong> <span t-field="company.website"/>   <strong>Teléfono:</strong> <span t-field="company.phone"/>   <strong>RTN:</strong> <span t-field="company.company_registry"/>
					    </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
