<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="company_view_inherit" model="ir.ui.view">
            <field name="name">res company inh</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <div class="oe_title" position="inside">
                    <label for="company_motto"/>
                    <h3>
                        <field name="company_motto" />
                    </h3>
                </div>
            </field>
        </record>

        <record id="view_move_line_inherit" model="ir.ui.view">
            <field name="name">account.move.customer.year.budget.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page/field[@name='invoice_line_ids']/list/field[@name='analytic_distribution']" position="after">
                    <field name="YQAmount" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="TAAmount" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="YRAmount" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="TDAmount" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="TIAmount" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="YZAmount" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="donate" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                    <field name="sub_invoice" optional="hide" groups="cm_sales.group_ws_sale_manager"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>