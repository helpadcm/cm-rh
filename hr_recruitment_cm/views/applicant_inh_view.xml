<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="cm_applicant_view_inh">
            <field name="name">applicant.inh.form</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
            <field name="arch" type="xml">
                <field name="department_id" position="after">
                    <field name="requirement_id" domain="[('new_position','=',job_id),('state','=','in_progress')]" options="{'no_create': True}"/>
                </field>
                <field name="availability" position="replace">
                </field>
                <xpath expr="//form/sheet/group/group[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/sheet/group/group[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <group name="recruitment_contract" position="inside">
                    <field name="negotiable" />
                </group>
                <page name="application_details" position="before">
                    <page string="DATOS GENERALES">
                        <group col="3">
                            <group>
                                <field name="identity" />
                                <field name="birthday" />
                                <field name="marital_status" />
                                <field name="address" />
                            </group>
                            <group>
                                <field name="immediate_availability" />
                                <field name="age" readonly="1" force_save="1"/>
                                <field name="email_from" />
                                <field name="city" />
                            </group>
                            <group>
                                <field name="availability" />
                                <field name="partner_phone" />
                                <field name="children" />
                            </group>
                        </group>
                        <group string="Ultimo Grado Academico">
                            <group>
                                <field name="academic_level" />
                                <field name="graduation_year" />
                            </group>
                            <group>
                                <field name="last_institute" />
                                <field name="career_name" />
                            </group>
                        </group>
                        <separator/>
                        <group col="3">
                            <group>
                                <field name="currently_studying" />
                                <field name="own_vehicle" />
                                <field name="excel_level" />
                                <field name="english_level" />
                            </group>
                            <group>
                                <field name="current_institute" invisible="not currently_studying"/>
                                <field name="has_with" />
                                <field name="banpais_relation" />
                            </group>
                            <group>
                                <field name="career_promedy" invisible="not currently_studying"/>
                                <field name="availability_travel" />
                                <field name="vigent_licence" />
                            </group>
                        </group>
                    </page>
                    <page string="CUESTIONARIO">
                        <notebook>
                            <page string="Historial Laboral">
                                <field name="laboral_history_ids">
                                    <list>
                                        <field name="company_name" />
                                        <field name="position_name" />
                                        <field name="time_worked" />
                                        <field name="salary" />
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="company_name" />
                                                <field name="time_worked" />
                                                <field name="reason" />
                                                <field name="tastes" />
                                            </group>
                                            <group>
                                                <field name="position_name" />
                                                <field name="salary" />
                                                <field name="functions" />
                                                <field name="no_tastes" />
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Relaciones Colaboradores">
                                <field name="relations_ids">
                                    <list editable="bottom">
                                        <field name="name" />
                                        <field name="relationship" />
                                        <field name="currently_work" />
                                        <field name="branch" />
                                        <field name="department" />
                                    </list>
                                </field>
                            </page>
                            <page string="Referencias Laborales">
                                <field name="laboral_reference_ids">
                                    <list editable="bottom">
                                        <field name="name" />
                                        <field name="company" />
                                        <field name="position" />
                                        <field name="phone" />
                                    </list>
                                </field>
                            </page>
                            <page string="Referencias Personales">
                                <field name="personal_reference_ids">
                                    <list editable="bottom">
                                        <field name="name" />
                                        <field name="relationship" />
                                        <field name="phone" />
                                        <field name="company" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <group>
                                <field name="unemployed" string="¿Desde cuando esta sin empleo y por que?"/>
                                <field name="expectatives" string="¿Cual es su expectativa en CM Airlines?"/>
                            </group>
                            <group>
                                <field name="knowledge_position" string="¿Que conocimientos tiene del puesto que solicita?"/>
                                <field name="experience" string="¿Experiencia en otras areas?"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="banpais_situation" string="¿Cual es su situacion economica actual con el banco BANPAIS?"/>
                                <field name="personal_experience" string="¿Tiene experiencia en el manejo de personal y cuantas personas?"/>
                                <field name="free_time" string="¿Que hace en su tiempo libre?"/>
                                <field name="plans" string="¿Cuales son sus planes a mediano y largo plazo?"/>
                            </group>
                            <group>
                                <field name="disease" string="¿Padece o ha padecido de alguna enfermedad?"/>
                                <field name="other_responsabilities" string="¿Que otras responsabilidades tiene aparte de trabajar?"/>
                                <field name="with_life" string="¿Con quien vive?"/>
                            </group>
                        </group>
                    </page>
                </page>
            </field>
        </record>
    </data>
</odoo>
