<?xml version = "1.0" encoding = "utf-8"?>
<odoo>
    <data>
        <record id="staff_requirement_tree_view" model="ir.ui.view">
            <field name="name">staff.requirement.tree</field>
            <field name="model">hr.staff.requirement</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="number"/>
                    <field name="name"/>
                    <field name="requested_by"/>                         
                    <field name="department_id"/>
                    <field name="position_type" optional="hide"/>
                    <field name="city"/>
                    <field name="requested_qty"/>
                    <field name="date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="staff_requirement_form_view" model="ir.ui.view">
            <field name="name">staff.requirement.form</field>
            <field name="model">hr.staff.requirement</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form string="Requerimiento de Personal">
                    <header>
                        <button name="change_state" class="oe_highlight" context="{'state_type': 'approval'}" type="object" string="Enviar a aprobacion" invisible="state != 'draft'"/>
                        <button name="change_state" class="oe_highlight" context="{'state_type': 'draft'}" type="object" groups="hr_recruitment.group_hr_recruitment_manager" string="Enviar a Borrador" invisible="state != 'approval'"/>
                        <button name="change_state" class="oe_highlight" context="{'state_type': 'in_progress'}" groups="hr_recruitment.group_hr_recruitment_manager" type="object" string="En Progreso" invisible="state != 'approval'"/>
                        <button name="change_state" class="oe_highlight" context="{'state_type': 'finalized'}" groups="hr_recruitment.group_hr_recruitment_manager" type="object" string="Finalizar" invisible="state != 'in_progress'"/>
                        <button name="change_state" class="oe_highlight" context="{'state_type': 'refused'}" groups="hr_recruitment.group_hr_recruitment_manager" type="object" string="Rechazar" invisible="state != 'approval'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_postulations" string="Postulaciones" class="oe_stat_button" type="object" icon="fa-users" invisible="state not in ['in_progress','finalized']">
                                
                                <!-- div class="o_stat_info">
                                    <field name="calendar_event_count" class="o_stat_value"/>
                                </div -->
                            </button>
                        </div>
                        <label for="number"/>
                        <field name="number" readonly="1"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" required="1" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group col="2">
                            <group>
                                <field name="requested_by" readonly="1"/>                                
                                <field name="department_id" options="{'no_create': True}" readonly="1" force_save="1"/>
                                <field name="aprobation_date" readonly="1" invisible="state == 'draft'"/>
                                <field name="rotation" readonly="state != 'draft'"/>
                                <field name="promotion" required="1" readonly="state != 'draft'"/>
                                <field name="promotion_name" readonly="state != 'draft'" invisible="promotion != 'yes'" required="promotion != 'yes'"/>
                                <field name="salarial_range" readonly="state != 'draft'"/>
                                <field name="requested_qty" readonly="state != 'draft'" invisible="1"/>
                                <field name="hired_qty" readonly="1" invisible="1"/>
                                <field name="manager_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="date" readonly="1" force_save="1"/>
                                <field name="job_id" options="{'no_create': True}" readonly="1" force_save="1"/>
                                <field name="city" options="{'no_create': True, 'no_open': True}" required="1" readonly="state != 'draft'"/>
                                <field name="replate_to" readonly="state != 'draft'" invisible="rotation == False" required="rotation == True"/>
                                <field name="replace_job_id" options="{'no_create': True}" readonly="state != 'draft'" invisible="rotation == False" required="rotation == True"/>
                                <field name="new_position" options="{'no_create': True}" readonly="state != 'draft'" invisible="rotation == True" required="rotation == False"/>
                                <field name="position_type" required="1" readonly="state != 'draft'"/>
                                <field name="postulation_id" invisible="1"/>
                                <field name="postulation_created" invisible="1"/>
                            </group>
                            <field name="description" placeholder="Ingrese el motivo por el que realiza la solicitud..." readonly="state != 'draft'"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="requeriment_staff_search_view" model="ir.ui.view">
            <field name="name">requeriment.staff.search.view</field>
            <field name="model">hr.staff.requirement</field>
            <field name="arch" type="xml">
                <search string="Requerimiento de personal">
                    <field name="name"/>
                    <field name="number"/>
                    <field name="requested_by"/>
                    <group expand="0" string="Group By">
                        <filter string="Estado" name="state" context="{'group_by':'state'}"/>
                        <filter string="Solicitado por" name="requested_by" context="{'group_by':'requested_by'}"/>
                        <filter string="Area Solicitante" name="department_id" context="{'group_by':'department_id'}"/>
                        <filter string="Fecha envio a RRHH" name="aprobation_date" context="{'group_by':'aprobation_date'}"/>
                        <filter string="Fecha de solicitud" name="date" context="{'group_by':'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_sstaff_requirement">
            <field name="name">Requerimiento de Personal</field>
            <field name="res_model">hr.staff.requirement</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nuevo Requerimiento
                </p>
            </field>
        </record>
    </data>
</odoo>
