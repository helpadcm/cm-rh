<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--##############################  RULES  ####################################-->
        <record id="requirement_staff_user_rule" model="ir.rule">
            <field name="name">Regla para usuario RRHH</field>
            <field ref="hr_recruitment_cm.model_hr_staff_requirement" name="model_id"/>
            <field name="domain_force">[('requested_by','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_create" eval="True"/>   
        </record>

        <record id="requirement_staff_responsable_rule" model="ir.rule">
            <field name="name">Regla para Responsables RRHH</field>
            <field ref="hr_recruitment_cm.model_hr_staff_requirement" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_create" eval="True"/>   
        </record>
    </data>
    
</odoo>