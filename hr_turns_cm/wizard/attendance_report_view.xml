<?xml version="1.0"?>
<odoo>
    <record id="view_attendance_equip_report" model="ir.ui.view">
        <field name="name">attendance.equip.form</field>
        <field name="model">attendance.team.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistencia de equipo">
                <group>
                    <group >
                        <field name="user_id" options="{'no_create': True, 'no_open': True}" readonly="is_manager == False"/>
                        <field name="start_date" required="1"/>
                        <field name="is_manager" invisible="1"/>
                    </group>                
                    <group >
                        <field name="team_id" required="1" options="{'no_create': True}" domain="['|',('leader_id.user_id','=',user_id),('responsible_id.user_id','=',user_id)]"/>
                        <field name="end_date" required="1"/>
                    </group>             
                </group>
                <label for="employee_ids" string="Empleados" invisible="1"/>
                <field name="employee_ids" domain="[('attendance_manager_id','=',user_id)]" required="1" widget="many2many_tags" options="{'no_create': True}" invisible="1"/>
                <footer>
                    <button string="Obtener" name="get_attendance" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_team_wizard" model="ir.actions.act_window">
        <field name="name">Asistencia de equipos</field>
        <field name="res_model">attendance.team.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_attendance_equip_report"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>