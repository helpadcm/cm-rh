<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="planification_format_cm">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <style>
                        body {
                            font-family: Arial, sans-serif;
                            font-size: 10px;
                            margin: 0;
                            padding: 0;
                        }
                        .header {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            padding: 10px;
                            background-color: #f2f2f2;
                            border-bottom: 1px solid #ccc;
                        }
                        .header img {
                            height: 80px;
                        }
                        .header .title {
                            text-align: center;
                            flex-grow: 1;
                        }
                        .header .title h1 {
                            margin: 0;
                            font-size: 14px;
                        }
                        .header .title p {
                            margin: 0;
                            font-size: 12px;
                        }
                        table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        table, th, td {
                            border: 1px solid #000;
                        }
                        th, td {
                            padding: 5px;
                            text-align: center;
                        }
                        th {
                            background-color: #C0C0C0;
                        }
                        .yellow {
                            background-color: #C0C0C0;
                        }
                    </style>

                    <body>
                        <table>
                            <thead>
                                <tr>
                                    <td style="width:15%;">
                                        <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="width:100%;height:150px" alt="Logo"/>
                                    </td>
                                    <td>
                                        <h1>Registro de Turnos Semanal</h1>
                                        <div style="font-size:13px" class="title">
                                            Código: AE-RG-07
                                        </div>
                                    </td>
                                </tr>
                            </thead>
                        </table>
                        <table>
                            <thead>
                                <tr>
                                    <th>Periodo</th>
                                    <td><span t-esc="docs.get('turn')"/></td>
                                    <th>Equipo</th>
                                    <td><span t-esc="docs.get('team_name')"/></td>
                                </tr>
                            </thead>
                        </table>
                        <table style="margin-top:1%">
                            <tr>
                                <th rowspan="2">#</th>
                                <th style="vertical-align:middle" rowspan="2">Nombre</th>
                                <t t-foreach="docs.get('days')" t-as="d">
                                    <th colspan="4"><span t-esc="d"/></th>
                                </t>
                            </tr>
                            <tr>
                                <th colspan="4">Lunes</th>
                                <th colspan="4">Martes</th>
                                <th colspan="4">Miércoles</th>
                                <th colspan="4">Jueves</th>
                                <th colspan="4">Viernes</th>
                                <th colspan="4">Sábado</th>
                                <th colspan="4">Domingo</th>
                            </tr>
                            <t t-foreach="docs.get('jobs')" t-as="job">
                                <tr>
                                    <td colspan="2"><strong><span t-esc="job.get('job_name')"/></strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                    <td colspan="2" class="yellow"><strong>A</strong></td>
                                    <td colspan="2" class="yellow"><strong>B</strong></td>
                                </tr>
                                <t t-set="cont" t-value="1"/>
                                <t t-foreach="job.get('employee_array')" t-as="emp">
                                    <tr>
                                        <td><span t-esc="cont"/></td>
                                        <td style="text-align:left"><span t-esc="emp.get('employee_name')"/></td>
                                        <t t-set="total_oh" t-value="0"/>
                                        <t t-set="total_ah" t-value="0"/>
                                        <t t-foreach="emp.get('turns')" t-as="day">
                                            <td t-att-style="'background-color: %s;' % day.get('entry_color')"><span t-esc="day.get('entry1')"/></td>
                                            <td t-att-style="'background-color: %s;' % day.get('entry_color')"><span t-esc="day.get('out1')"/></td>
                                            <td t-att-style="'background-color: %s;' % day.get('exit_color')"><span t-esc="day.get('entry2')"/></td>
                                            <td t-att-style="'background-color: %s;' % day.get('exit_color')"><span t-esc="day.get('out2')"/></td>
                                        </t>
                                    </tr>
                                    <t t-set="cont" t-value="cont + 1"/>
                                </t>
                            </t>
                        </table>
                        <table t-if="docs.get('colors')" style="margin-top:1%;width:13%">
                            <t t-foreach="docs.get('colors')" t-as="color">
                                <t t-foreach="color.get('names')" t-as="color_name">
                                    <tr>
                                        <td style="width:90%;text-align:left"><span t-esc="color_name"/></td>
                                        <td t-att-style="'background-color: %s;' % color.get('color')"><br></br></td>
                                    </tr>
                                </t>
                            </t>
                        </table>
                    </body>
                </div>
            </t>
        </t>
    </template>
</odoo>