<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fortnights" model="ir.ui.view">
        <field name="name">hr.fortnights.form</field>
        <field name="model">hr.fortnights</field>
        <field name="arch" type="xml">
            <form string="Equipos de trabajo">
                <header>
                    <button string="Calcular quincenas" name="get_fortnights" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="actual"/>
                        </group>
                        <group>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quincenas">
                            <field name="line_ids" readonly="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fortnights_search" model="ir.ui.view">
        <field name="name">hr.fortnights.search</field>
        <field name="model">hr.fortnights</field>
        <field name="arch" type="xml">
            <search string="Busqueda">
                <field name="name"/>
            </search>
        </field>
    </record>
    
    <record id="view_fortnights_tree" model="ir.ui.view">
        <field name="name">hr.fortnights.tree</field>
        <field name="model">hr.fortnights</field>
        <field name="arch" type="xml">
            <list string="Registro de Asistencias">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="action_fortnights" model="ir.actions.act_window">
        <field name="name">Creador Quincenas</field>
        <field name="res_model">hr.fortnights</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
