<odoo>
    <record id="hr_employee_inh_form" model="ir.ui.view">
        <field name="name">hr.turn.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="pin" position="before">
                <field name="notify_validate_turns"/>
            </field>
            <field name="registration_number" position="after">
                <field name="weekend_hours"/>
            </field>
        </field>
    </record>
</odoo>
