<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_turn_work_teams" model="ir.ui.view">
        <field name="name">turn.work.teams.form</field>
        <field name="model">hr.work.teams</field>
        <field name="arch" type="xml">
            <form string="Equipos de trabajo">
                <sheet>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="leader_id" required="1"/>
                        </group>
                        <group>
                            <field name="responsible_id" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lineas de Asistencia">
                            <field name="members_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

