<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="turn_registration_tree_view" model="ir.ui.view">
        <field name="name">turn.registration.view.tree</field>
        <field name="model">hr.turn.registration</field>
        <field name="arch" type="xml">
            <tree string="Horarios" editable="bottom">
                <field name="name" column_invisible="1"/>
                <field name="employee_id" readonly="1" widget="many2one_avatar_user"/>
                <field name="date" readonly="1"/>
                <field name="schedule1_in_id" options="{'no_create': True}" required="1"/>
                <field name="schedule1_out_id" options="{'no_create': True}" required="1"/>
                <field name="schedule2_in_id" options="{'no_create': True}" required="1"/>
                <field name="schedule2_out_id" options="{'no_create': True}" required="1"/>
                <field name="ordinary_hours" readonly="1" force_save="1" sum="HO Laboradas"/>
            </tree>
        </field>
    </record>

    <record id="view_turn_registration_search" model="ir.ui.view">
        <field name="name">hr.turn.registration.search</field>
        <field name="model">hr.turn.registration</field>
        <field name="arch" type="xml">
            <search string="Search Branches">
                <field name="name"/>
                <group expand="1" string="Group By">
                    <filter string="Nombre" name="group_name" context="{'group_by':'name'}"/>
                    <filter string="Fecha" name="date" context="{'group_by':'date'}"/>
                    <filter string="Empleado" name="employee_group" context="{'group_by':'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_turn_registration" model="ir.actions.act_window">
        <field name="name">Turnos de trabajo</field>
        <field name="res_model">hr.turn.registration</field>
        <field name="view_mode">tree</field>
        <field name="context">{"search_default_group_name": 1, "search_default_employee_group":1}</field>
    </record>
</odoo>
