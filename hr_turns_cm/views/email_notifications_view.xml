<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_notifications_email" model="ir.ui.view">
        <field name="name">notifications.email.form</field>
        <field name="model">turn.email.notifications</field>
        <field name="arch" type="xml">
            <form string="Configuracion para notificaciones">
                <sheet>
                    <h1>
                        <field name="name" required="1" placeholder="Nombre de registro"/>
                    </h1>
                    <notebook>
                        <page string="Lineas">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="employee_id" widget="many2one_avatar_user" options="{'no_create': True}" required="1"/>
                                    <field name="email" required="1"/>
                                </tree>
                            </field>
                        </page> 
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_notification_email_tree" model="ir.ui.view">
        <field name="name">email.notifications.tree</field>
        <field name="model">turn.email.notifications</field>
        <field name="arch" type="xml">
            <tree string="Lista">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_notification_email" model="ir.actions.act_window">
        <field name="name">Plantilla de turnos</field>
        <field name="res_model">turn.email.notifications</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
