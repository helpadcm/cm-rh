<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- ############################  PRIVILEGES  ######################################## -->

        <record id="privilege_retentions" model="res.groups.privilege">
            <field name="name">Retenciones</field>
            <field name="category_id" ref="cm_banks.module_category_banks"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_print_retentions" model="res.groups.privilege">
            <field name="name">Imprimir Retenciones</field>
            <field name="category_id" ref="cm_banks.module_category_banks"/>
            <field name="sequence">10</field>
        </record>

		<!-- ############################  GROUPS  ######################################## -->

		<record id="group_retention" model="res.groups">
			<field name="name">Retenciones</field>
            <field name="privilege_id" ref="privilege_retentions"/>
		</record>

		<record id="grp_ret_print" model="res.groups">
	        <field name="name">Ver e imprimir retenciones</field>
            <field name="privilege_id" ref="privilege_print_retentions"/>
        </record>
	</data>
</odoo>



