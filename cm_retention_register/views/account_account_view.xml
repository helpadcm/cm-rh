<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_ap_account_account_form_retentions" model="ir.ui.view">
			<field name="name">account_account_inherit_banks</field>
			<field name="model">account.account</field>
			<field name="inherit_id" ref="cm_banks.view_bank_account_account_form_reconciliation"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='use_4_retention']" position="after" >
					<field name="retention_concept" invisible="use_4_retention != True"/>
					<field name="retention_porcent" invisible="use_4_retention != True"/>
				</xpath>
			</field>
		</record>
	</data>
</odoo>