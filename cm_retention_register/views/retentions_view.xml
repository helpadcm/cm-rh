<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="retentions_form_view" model="ir.ui.view">
            <field name="name">retentions_form_view</field>
            <field name="model">retentions</field>
            <field name="arch" type="xml">
                <form string="Retenciones" create="false" delete="false" edit="false">
                    <header>
                        <field name='state' widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Describe the item..." /></h1>
                        </div>
                            
                        <group string="Datos del asunto y recibo de venta">
                            <group>
                                <field name="pay_number"/>
                                <field name="invoice_id"/>
                                <field name="partner_name"/>
                                <field name="partner_rtn"/>
                                <field name="cai_shot"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="min_number_shot"/>
                                <field name="max_number_shot"/>
                                <field name="cai_ret"/>
                                <field name="cai_expires_shot"/>
                            </group>
                            
                            
                        </group>
                        
                        <group string="Detalles de retencion">
                            <field name="doc_issue_date"/>
                            <field name="ref_doc_type"/>
                            <field name="description"/>
                        </group>

                        <notebook>
                            <page string="Retenciones aplicadas">
                                <field name="retention_lines">
                                    <tree string="retention_lines" create="false" delete="false" edit="false">
                                        <field name="base_amount" />
                                        <field name="account_id" />
                                        <field name="name" />
                                        <field name="amount" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
                
            </field>
        </record>

        <record id="retention_tree_view" model="ir.ui.view">
            <field name="name">retentions</field>
            <field name="model">retentions</field>
            <field name="arch" type="xml">
				<tree string="Retenciones" create="false" delete="false" edit="false">
					<field name="name"/>
					<field name="pay_number"/>
                    <field name="invoice_id"/>
                    <field name="partner_name"/>
                    <field name="partner_rtn"/>
                    <field name="date"/>
                    <field name="cai_shot"/>
				</tree>			    
          	</field>
        </record>

        <record id="retention_search_view" model="ir.ui.view">
		    <field name="name">retentions</field>
		    <field name="model">retentions</field>
            <field name="type">search</field>
		    <field name="arch" type="xml">
                <search>
                    <field name='name'/>
                    <field name='pay_number'/>
                    <field name='invoice_id'/>
                    <field name='partner_name'/>
                    <group expand="0" string="Group By">
                        <filter name="name" string="Numero de retencion" context="{'group_by':'name'}"/>
                        <filter name="pay_number" string="Pago" context="{'group_by':'pay_number'}"/>
                        <filter name="invoice_id" string="Factura" context="{'group_by':'invoice_id'}"/>
                        <filter name="partner_name" string="Nombre del Socio" context="{'group_by':'partner_name'}"/>
                        <filter name="date" string="Fecha" context="{'group_by':'date'}"/>
                    </group>
                </search>
            </field>
		</record>

        <record id="retentions_form_view_action" model="ir.actions.act_window">
            <field name="name">Retenciones</field>
            <field name="res_model">retentions</field>
            <field name="view_mode">tree,form</field>
        </record>
	</data>
</odoo>