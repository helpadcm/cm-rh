<?xml version="1.0"?>
<odoo>
    <record id="view_manual_sync" model="ir.ui.view">
        <field name="name">validate.turns.form</field>
        <field name="model">manual.synchronization</field>
        <field name="arch" type="xml">
            <form string="Sincronizar Manualmente">
                <group>
                    <group >
                        <field name="model_selection" required="1"/>
                        <field name="start_date" required="1"/>
                    </group>
                    <group >
                        <field name="type_selection" required="1"/>
                        <field name="end_date" invisible="model_selection == 'rate'" required="model_selection != 'rate'"/>
                        <field name="limit" invisible="model_selection not in ['customer_inv','supplier_inv']"/>
                    </group>                    
                </group>
                <footer>
                    <button string="Sincronizar" name="synchronization_manual" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_manual_sinchronization" model="ir.actions.act_window">
        <field name="name">Sincronizacion Manual</field>
        <field name="res_model">manual.synchronization</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_manual_sync"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="manual_sync_menuitem"
        name="Sincronizacion Manual"
        action="action_manual_sinchronization"
        parent="account.menu_finance_entries"
        groups="base.group_no_one"
        sequence="12"/>
</odoo>