<odoo>
    <data noupdate="1">
        <record id="ir_cron_get_debit_credit" model="ir.cron">
            <field name="name">Sincronizacion Odoo 10 y 17: Sincronizar debitos y creditos</field>
            <field name="model_id" ref="cm_banks.model_debit_credit"/>
            <field name="state">code</field>
            <field name="code">model.sync_debit_credit()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

