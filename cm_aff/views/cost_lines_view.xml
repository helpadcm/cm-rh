<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="aff_cost_sheets_line_form_view" model="ir.ui.view">
            <field name="name">Rubros</field>
            <field name="model">aff.cost.sheets.lines</field>
            <field name="arch" type="xml">
                <form string="Linea hoja de costos">
                    <sheet>
                        <group>
                            <group>
                                <field name="sheet_id" required="1"/>
                                <field name="trimester" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="aircraft_id" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="fixed" string="Costos Fijos">
                                <field name="fixed_cost_ids"> 
                                    <list create="false">
                                        <field name="trimester" column_invisible="1"/>
                                        <field name="cost_id" readonly="1"/>
                                        <field name="description" />
                                        <field name="january" column_invisible="parent.trimester != '1'"/>
                                        <field name="february" column_invisible="parent.trimester != '1'"/>
                                        <field name="march" column_invisible="parent.trimester != '1'"/>
                                        <field name="april" column_invisible="parent.trimester != '2'"/>
                                        <field name="may" column_invisible="parent.trimester != '2'"/>
                                        <field name="june" column_invisible="parent.trimester != '2'"/>
                                        <field name="july" column_invisible="parent.trimester != '3'"/>
                                        <field name="august" column_invisible="parent.trimester != '3'"/>
                                        <field name="september" column_invisible="parent.trimester != '3'"/>
                                        <field name="october" column_invisible="parent.trimester != '4'"/>
                                        <field name="november" column_invisible="parent.trimester != '4'"/>
                                        <field name="december" column_invisible="parent.trimester != '4'"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="cost_id" readonly="1"/>
                                                <field name="description" />
                                                <field name="trimester" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="january" invisible="parent.trimester != '1'"/>
                                                <field name="february" invisible="parent.trimester != '1'"/>
                                                <field name="march" invisible="parent.trimester != '1'"/>
                                                <field name="april" invisible="parent.trimester != '2'"/>
                                                <field name="may" invisible="parent.trimester != '2'"/>
                                                <field name="june" invisible="parent.trimester != '2'"/>
                                                <field name="july" invisible="parent.trimester != '3'"/>
                                                <field name="august" invisible="parent.trimester != '3'"/>
                                                <field name="september" invisible="parent.trimester != '3'"/>
                                                <field name="october" invisible="parent.trimester != '4'"/>
                                                <field name="november" invisible="parent.trimester != '4'"/>
                                                <field name="december" invisible="parent.trimester != '4'"/>
                                            </group>
                                        </group>
                                        <group string="Cálculo Estadístico / Variables de Plantilla" invisible="not template_id">
                                            <field name="template_id" readonly="1"/>
                                            <field name="value_ids" nolabel="1">
                                                <list editable="bottom" create="0" delete="0">
                                                    <field name="variable_id"/>
                                                    <field name="field_type" invisible="1"/>
                                                    <field name="value_float" invisible="field_type == 'integer'"/>
                                                    <field name="value_integer" invisible="field_type != 'integer'"/>
                                                </list>
                                            </field>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page name="variable" string="Costos Variables">
                                <field name="variable_cost_ids">
                                    <list create="false">
                                        <field name="trimester" column_invisible="1"/>
                                        <field name="cost_id" readonly="1"/>
                                        <field name="description" />
                                        <field name="january" column_invisible="parent.trimester != '1'"/>
                                        <field name="february" column_invisible="parent.trimester != '1'"/>
                                        <field name="march" column_invisible="parent.trimester != '1'"/>
                                        <field name="april" column_invisible="parent.trimester != '2'"/>
                                        <field name="may" column_invisible="parent.trimester != '2'"/>
                                        <field name="june" column_invisible="parent.trimester != '2'"/>
                                        <field name="july" column_invisible="parent.trimester != '3'"/>
                                        <field name="august" column_invisible="parent.trimester != '3'"/>
                                        <field name="september" column_invisible="parent.trimester != '3'"/>
                                        <field name="october" column_invisible="parent.trimester != '4'"/>
                                        <field name="november" column_invisible="parent.trimester != '4'"/>
                                        <field name="december" column_invisible="parent.trimester != '4'"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="cost_id" readonly="1"/>
                                                <field name="description" />
                                                <field name="trimester" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="january" invisible="parent.trimester != '1'"/>
                                                <field name="february" invisible="parent.trimester != '1'"/>
                                                <field name="march" invisible="parent.trimester != '1'"/>
                                                <field name="april" invisible="parent.trimester != '2'"/>
                                                <field name="may" invisible="parent.trimester != '2'"/>
                                                <field name="june" invisible="parent.trimester != '2'"/>
                                                <field name="july" invisible="parent.trimester != '3'"/>
                                                <field name="august" invisible="parent.trimester != '3'"/>
                                                <field name="september" invisible="parent.trimester != '3'"/>
                                                <field name="october" invisible="parent.trimester != '4'"/>
                                                <field name="november" invisible="parent.trimester != '4'"/>
                                                <field name="december" invisible="parent.trimester != '4'"/>
                                            </group>
                                        </group>
                                        <group string="Cálculo Estadístico / Variables de Plantilla" invisible="not template_id">
                                            <field name="template_id" readonly="1"/>
                                            <field name="value_ids" nolabel="1">
                                                <list editable="bottom" create="0" delete="0">
                                                    <field name="variable_id"/>
                                                    <field name="field_type" invisible="1"/>
                                                    <field name="value_float" invisible="field_type == 'integer'"/>
                                                    <field name="value_integer" invisible="field_type != 'integer'"/>
                                                </list>
                                            </field>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>
        
        <record id="aff_cost_sheets_line_list_view" model="ir.ui.view">
            <field name="name">Hojas de costo</field>
            <field name="model">aff.cost.sheets.lines</field>
            <field name="arch" type="xml">
                <list string="Lineas hojas de costo">
                    <field name="aircraft_id"/>
                    <field name="sheet_id"/>
                    <field name="trimester"/>
                </list>
            </field>
        </record>

