        <record id="action_aff_cost_line_sheets" model="ir.actions.act_window">            
            <field name="name">Lineas hojas de costo</field>
            <field name="res_model">aff.cost.sheets.lines</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
