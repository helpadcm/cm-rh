<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="aff_cost_sheets_line_form_view" model="ir.ui.view">
            <field name="name">Rubros</field>
            <field name="model">aff.cost.sheets.lines</field>
            <field name="arch" type="xml">
                <form string="Linea hoja de costos">
                    <sheet>
                        <group>
                            <group>
                                <field name="sheet_id" invisible="1" required="1"/>
                                <field name="aircraft_id" required="1"/>
                                <!-- <field name="period" readonly="1" force_save="1"/> -->
                            </group>
                            <group>
                                <field name="start_date" />
                                <field name="final_date" />
                                <!-- <field name="months_duration" /> -->
                            </group>
                        </group>

                        <group>
                            <group string="DATOS DE ESTIMACION">
                                <field name="cycles" readonly="1" force_save="1"/>
                                <field name="bt" readonly="1" force_save="1"/>
                                <field name="ft" readonly="1" force_save="1"/>
                                <field name="ratio" readonly="1" force_save="1"/>
                                <field name="penalty" readonly="1" force_save="1"/>
                                <field name="update_data" invisible="1"/>
                            </group>
                            <group string="DATOS REALES">
                                <field name="real_cycles" string="Ciclos"/>
                                <field name="real_bt" string="Horas Bloque (BT)"/>
                                <field name="real_ft" string="Horas Vuelo (FT)"/>
                                <field name="real_ratio" string="Ratios"/>
                                <field name="real_penalty" string="Penalidad"/>
                                <button name="update_lines" invisible="not update_data" string="Actualizar datos" type="object"/>
                            </group>
                        </group>

                        <group string="TOTALES">
                            <group>
                                <field name="estimated_amount" />
                            </group>
                            <group>
                                <field name="amount_made" />
                            </group>
                        </group>
                        <notebook>
                            <page name="fixed" string="Costos Fijos">
                                <field name="fixed_cost_ids"/>
                            </page>
                            <page name="variable" string="Costos Variables">
                                <field name="variable_cost_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>
        
        <record id="aff_cost_sheets_line_list_view" model="ir.ui.view">
            <field name="name">Hojas de costo</field>
            <field name="model">aff.cost.sheets.lines</field>
            <field name="arch" type="xml">
                <list string="Lineas hojas de costo">
                    <field name="aircraft_id"/>
                    <field name="sheet_id"/>
                    <field name="estimated_amount"/>
                    <field name="amount_made"/>
                </list>
            </field>
        </record>

