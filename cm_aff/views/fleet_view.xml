<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="fleet_form_view" model="ir.ui.view">
            <field name="name">Flota</field>
            <field name="model">aff.fleet</field>
            <field name="arch" type="xml">
                <form string="Flota">
                    <sheet>
                        <h1>
                            <field name="name" placeholder="Nombre de flota" required="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="code" required="1"/>
                            </group>
                            <group>
                                <field name="fleet_type" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="aircraft" string="Aeronaves">
                                <field name="aircraft_ids"/>                            
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>
        
        <record id="aff_fleet_list_view" model="ir.ui.view">
            <field name="name">Lista Flotas</field>
            <field name="model">aff.fleet</field>
            <field name="arch" type="xml">
                <list string="Lista Guias de Carga">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="fleet_type"/>
                </list>
            </field>
        </record>

