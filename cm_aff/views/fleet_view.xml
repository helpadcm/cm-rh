        <record id="action_aff_fleet" model="ir.actions.act_window">            
            <field name="name">Flota</field>
            <field name="res_model">aff.fleet</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="domain" eval="[]"/>
