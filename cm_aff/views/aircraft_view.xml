<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="aircraft_form_view" model="ir.ui.view">
            <field name="name">Aeronaves</field>
            <field name="model">aff.aircraf</field>
            <field name="arch" type="xml">
                <form string="Aeronaves">
                    <sheet>
                        <h1>
                            <field name="msn" placeholder="MSN" required="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="tuition" required="1"/>
                                <field name="seats_qty"/>
                                <field name="fleet_id" options="{'no_create': True}"/>
                                <field name="brand" required="1"/>
                                <field name="year_of_manufacture" required="1"/>
                            </group>
                            <group>
                                <field name="renewal_sequence" />
                                <field name="contract_type" />
                                <field name="start_date" />
                                <field name="final_date" />
                                <field name="months_duration" />
                            </group>
                        </group>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>
        
        <record id="aff_aircraft_list_view" model="ir.ui.view">
            <field name="name">Lista Aeronaves</field>
            <field name="model">aff.aircraf</field>
            <field name="arch" type="xml">
                <list string="Lista Aeronaves">
                    <field name="msn"/>
                    <field name="tuition"/>
                    <field name="seats_qty"/>
                    <field name="brand"/>
                    <field name="year_of_manufacture"/>
                </list>
            </field>
        </record>

