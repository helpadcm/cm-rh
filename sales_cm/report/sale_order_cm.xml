<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cotizacion_cm_document">
        <t t-call="web.basic_layout">
            <head>
                <meta charset="utf-8"/>
            </head>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #333;">
                    
                    <!-- Estilos inline para garantizar formato en PDF (wkhtmltopdf) -->
                    <style type="text/css">
                        .info-table, .data-table, .totals-table, .bank-table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .header-table {
                            width: 100%;
                        }
                        .data-table th {
                            background-color: #0d3b2e;
                            color: #ffffff;
                            padding: 6px;
                            font-weight: bold;
                            text-align: center;
                        }
                        .data-table td {
                            padding: 5px;
                            border-bottom: 1px solid #ddd;
                        }
                        .gray-bg {
                            background-color: #f2f2f2;
                        }
                        .text-right { text-align: right; }
                        .text-center { text-align: center; }
                        .bold { font-weight: bold; }
                    </style>

                    <!-- Encabezado -->
                    <!-- Encabezado Corregido -->
                    <div style="width: 100%; border: 0px none transparent !important; margin-bottom: 25px; padding: 0;">
                        <table style="width: 100% !important; border-collapse: collapse !important; border: 0px none transparent !important; table-layout: fixed;">
                            <tr style="border: 0px none transparent !important;">
                                <!-- Logo a la izquierda -->
                                <td style="width: 40%; vertical-align: middle; text-align: left; padding: 0; border: 0px none transparent !important;">
                                    <img t-if="doc.company_id.logo" 
                                        t-att-src="image_data_uri(doc.company_id.logo)" 
                                        style="max-height: 120px; width: auto; max-width: 100%; display: block;" 
                                        alt="Logo"/>
                                </td>
                                
                                <!-- Dirección a la derecha -->
                                <td style="width: 60%; vertical-align: middle; text-align: center; padding: 0; border: 0px none transparent !important; font-size: 15px; line-height: 1.3; color: #333;">
                                    <div><b><span t-field="doc.company_id.street"/>, <span t-field="doc.company_id.street2"/></b></div>
                                    <div><span t-field="doc.company_id.city"/>, <span t-field="doc.company_id.country_id.name"/></div>
                                    <div>RTN: <span t-field="doc.company_id.vat"/></div>
                                    <div>Teléfonos: <span t-field="doc.company_id.phone"/></div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Título -->
                    <div class="text-center" style="margin-bottom: 15px;">
                        <h2 style="margin: 0; font-weight: normal; letter-spacing: 2px;">COTIZACIÓN</h2>
                        <span style="font-size: 13px;" t-field="doc.name"/>
                    </div>

                    <!-- Información de Cliente y Agente -->
                    <table class="info-table" style="margin-bottom: 15px;">
                        <tr>
                            <td style="width: 10%;padding:3px; font-weight: bold;">Cliente:</td>
                            <td style="width: 40%;padding:3px;"><span t-field="doc.partner_id.name"/></td>
                            <td style="width: 12%;padding:3px; font-weight: bold;">Agente:</td>
                            <td style="width: 38%;padding:3px;"><span t-field="doc.user_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;padding:3px">RTN:</td>
                            <td style="padding:3px"><span t-field="doc.partner_id.vat"/></td>
                            <td style="font-weight: bold;padding:3px">Contacto:</td>
                            <td style="padding:3px"><span t-field="doc.user_id.phone"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;padding:3px">Mail:</td>
                            <td style="padding:3px"><span t-field="doc.partner_id.email"/></td>
                            <td style="font-weight: bold;padding:3px">Fecha:</td>
                            <td style="padding:3px"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                        </tr>
                    </table>

                    <!-- Tabla Principal de Productos/Vuelos -->
                    <table class="data-table" style="margin-bottom: 15px;">
                        <thead>
                            <tr>
                                <th style="width: 8%;">Cantidad</th>
                                <th style="width: 42%;">Descripción</th>
                                <th style="width: 10%;">Ida</th>
                                <th style="width: 10%;">Regreso</th>
                                <th style="width: 10%;">Valor sin Imp</th>
                                <th style="width: 10%;">YQ</th>
                                <th style="width: 10%;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-field="line.product_uom_qty"/></td>
                                    <td><span t-esc="line.name"/></td>
                                    <!-- Campos personalizados (si existen en tu modelo) o vacíos -->
                                    <td class="text-center"><span t-field="line.departure_date"/></td>
                                    <td class="text-center"><span t-field="line.return_date"/></td>
                                    <td class="text-right"><span t-field="line.price_subtotal"/></td>
                                    <td class="text-right"><span t-field="line.yq_amount"/></td>
                                    <td class="text-right"><span t-field="line.price_total"/></td>
                                </tr>
                            </t>
                            <!-- <tr class="gray-bg">
                                <td colspan="4" class="bold" colspan="7">Servicios Adicionales (si angunon)</td>
                            </tr> -->
                        </tbody>
                    </table>

                    <!-- Resumen de Totales y Observaciones -->
                    <table class="info-table" style="margin-bottom: 20px;">
                        <tr>
                            <td style="width: 60%; vertical-align: top;padding:3px">
                                <div style="font-style: italic; margin-top: 20px;">
                                    Observaciones: Precio valido solo por un dia, varia de acuerdo al Tipo de cambio de VENTA, que proporciona el BCH
                                </div>
                                <div style="margin-top: 10px; font-weight: bold;">
                                    Tipo de cambio (Venta) L<span t-out="doc.currency_rate"/>
                                </div>
                            </td>
                            <td style="width: 40%; vertical-align: top;">
                                <table class="totals-table gray-bg">
                                    <tr>
                                        <td style="padding: 3px 5px;">Gravado</td>
                                        <td class="text-right" style="padding: 3px 5px;"><span t-field="doc.amount_untaxed"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 5px;">Imp. Aeroportuario</td>
                                        <td class="text-right" style="padding: 3px 5px;"><span t-field="doc.airport_tax"/></td>
                                    </tr>
                                    <tr class="bold">
                                        <td style="padding: 3px 5px;">Sub Total</td>
                                        <td class="text-right" style="padding: 3px 5px;"><span t-esc="doc.amount_untaxed + doc.airport_tax"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 3px 5px;">Impuesto 15%</td>
                                        <td class="text-right" style="padding: 3px 5px;"><span t-field="doc.amount_tax"/></td>
                                    </tr>
                                    <tr class="bold" style="border-top: 1px solid #333; border-bottom: 1px solid #333;">
                                        <td style="padding: 4px 5px;">Total</td>
                                        <td class="text-right" style="padding: 4px 5px;"><span t-esc="doc.currency_id.symbol"/> <span t-esc="doc.amount_total"/></td>
                                    </tr>
                                    <tr style="border-top: 1px solid #333; border-bottom: 1px solid #333;">
                                        <td style="padding: 4px 5px;">Descuento</td>
                                        <td class="text-right" style="padding: 4px 5px;"><span t-esc="doc.currency_id.symbol"/> 0.00</td>
                                    </tr>
                                    <tr class="bold" style="border-top: 1px solid #333; border-bottom: 1px solid #333;">
                                        <td style="padding: 4px 5px;">Total a pagar</td>
                                        <td class="text-right" style="padding: 4px 5px;"><span t-esc="doc.currency_id.symbol"/> <span t-esc="doc.amount_total"/></td>
                                    </tr>
                                    <tr class="bold" style="background-color: #d9d9d9;">
                                        <td style="padding: 4px 5px;">Lempiras</td>
                                        <td class="text-right" style="padding: 4px 5px;">L <span t-out="'{:,.2f}'.format(doc.amount_local_company)"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Cuentas Bancarias -->
                    <table class="bank-table gray-bg" style="border: 1px solid #ccc; text-align: center; font-size: 10px;">
                        <tr>
                            <td rowspan="2" class="bold" style="width: 35%; border-right: 1px solid #ccc;padding:3px">Cuentas de cheques a nombre de CM Airlines:</td>
                            <td class="bold" style="width: 15%;padding:3px">Lempiras</td>
                            <td style="width: 16%;padding:3px">730049441</td>
                            <td style="width: 17%;padding:3px">008-102-332041</td>
                            <td style="width: 17%;padding:3px">10111035431</td>
                        </tr>
                        <tr>
                            <td style="padding:3px" class="bold">Dólares</td>
                            <td style="padding:3px">701134921</td>
                            <td style="padding:3px">001-107-51646</td>
                            <td style="padding:3px">1016993790</td>
                        </tr>
                        <tr class="bold" style="background-color: #e6e6e6; border-top: 1px solid #ccc;">
                            <td style="padding:3px" colspan="2"></td>
                            <td style="padding:3px">BAC</td>
                            <td style="padding:3px">FICOHSA</td>
                            <td style="padding:3px">ATLANTIDA</td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>