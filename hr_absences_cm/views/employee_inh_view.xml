<odoo>
    <data>
        <record id="hr_absences_man_form_cm" model="ir.ui.view">
            <field name="name">hr.absences.man.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <field name="study_field" position="after">
                    <field name="aeronatical_license" />
                </field>

                <page name="hr_settings" position="before">
                    <page name="personal_time" string="Tiempo Personal">
                        <group col="3">
                            <group>
                                <field name="compensatory_hours" readonly="0"/>
                                <field name="compensatory_day_string" />
                                <field name="compensatory_day" invisible="1"/>
                            </group>
                            <group>
                                <field name="vacations_day" readonly="0"/>
                                <field name="early_vacations" readonly="0"/>
                            </group>
                            <group>
                                <field name="program_to_fly" readonly="0"/>
                                <field name="first_year" invisible="1"/>
                                <field name="second_year" invisible="1"/>
                                <field name="years_old" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detalle de vacaciones">
                                <field name="vacation_details_ids">
                                    <list create="false" delete="false">
                                        <field name="name" />
                                        <field name="assigned_days" />
                                        <field name="pending_days" />
                                    </list>
                                </field>
                            </page>
                            <page string="Beneficiarios PV">
                                <field name="beneficiaries_ids">
                                    <list editable="bottom">
                                        <field name="name" />
                                        <field name="identity" />
                                        <field name="birthday" />
                                        <field name="relationship" />
                                        <field name="observation" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </page>
                </page>
            </field>
        </record>

        <record id="hr_leave_inherit_list" model="ir.ui.view">
            <field name="name">hr.leave.list.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">
                <field name="duration_display" position="after">
                    <field name="number_of_days"/>
                </field>
            </field>
        </record>

        <record id="hr_leave_inherit_form" model="ir.ui.view">
            <field name="name">hr.leave.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="number_of_days"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
