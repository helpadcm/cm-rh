<odoo>
    <data>
        <record id="hr_absences_man_form" model="ir.ui.view">
            <field name="name">hr.absences.man.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="personal_time" string="Tiempo Personal">
                        <group col="3">
                            <group>
                                <field name="compensatory_hours" readonly="1"/>
                                <field name="compensatory_day_string" />
                                <field name="compensatory_day" invisible="1"/>
                            </group>
                            <group>
                                <field name="vacations_day" readonly="1"/>
                                <field name="early_vacations" readonly="1"/>
                            </group>
                            <group>
                                <field name="program_to_fly" readonly="1"/>
                                <field name="first_year" invisible="1"/>
                                <field name="second_year" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detalle de vacaciones">
                                <field name="vacation_details_ids">
                                    <tree create="false" delete="false">
                                        <field name="name" />
                                        <field name="assigned_days" />
                                        <field name="pending_days" />
                                    </tree>
                                </field>
                            </page>
                            <page string="Beneficiarios PV">
                                <field name="beneficiaries_ids">
                                    <tree editable="bottom">
                                        <field name="name" />
                                        <field name="identity" />
                                        <field name="relationship" />
                                        <field name="observation" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
