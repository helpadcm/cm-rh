<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="flight_routes_tree" model="ir.ui.view">
        <field name="name">flight.routes.tree</field>
        <field name="model">flight.routes</field>
        <field name="arch" type="xml">
            <list string="Rutas" editable="bottom">
                <field name="origin"/>
                <field name="destination"/>
                <field name="name" readonly="1" force_save="1"/>
            </list>
        </field>
    </record>

    <record id="paid_leave_tree" model="ir.ui.view">
        <field name="name">paid.leave.tree</field>
        <field name="model">paid.leave</field>
        <field name="arch" type="xml">
            <list string="Rutas" editable="bottom">
                <field name="name" required="1"/>
                <field name="concept"/>
            </list>
        </field>
    </record>

    <record id="vacations_details_list" model="ir.ui.view">
        <field name="name">vacations.detail.tree</field>
        <field name="model">vacations.detail.list</field>
        <field name="arch" type="xml">
            <list string="Detalles de vacaciones" editable="bottom">
                <field name="employee_id"/>
                <field name="name" required="1"/>
                <field name="year" />
                <field name="assigned_days"/>
                <field name="pending_days"/>
            </list>
        </field>
    </record>

    <record id="beneficiaries_details_list" model="ir.ui.view">
        <field name="name">beneficiaries.detail.tree</field>
        <field name="model">beneficiaries.detail.list</field>
        <field name="arch" type="xml">
            <list string="Beneficiarios" editable="bottom">
                <field name="employee_id"/>
                <field name="name" required="1"/>
                <field name="identity" />
                <field name="birthday"/>
                <field name="relationship"/>
                <field name="observation"/>
                <field name="is_employee"/>
            </list>
        </field>
    </record>

    <record id="action_flight_routes" model="ir.actions.act_window">
        <field name="name">Rutas de Vuelo</field>
        <field name="res_model">flight.routes</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_paid_leaves" model="ir.actions.act_window">
        <field name="name">Permisos Goce de Sueldo</field>
        <field name="res_model">paid.leave</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_vacations_details" model="ir.actions.act_window">
        <field name="name">Detalles de vacaciones</field>
        <field name="res_model">vacations.detail.list</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_beneficiaries_details" model="ir.actions.act_window">
        <field name="name">Detalles de beneficiarios</field>
        <field name="res_model">beneficiaries.detail.list</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
