<odoo>
    <data noupdate="1">
        <record id="ir_cron_update_personal_time" model="ir.cron">
            <field name="name">Tiempo Personal: Actualizar tiempo personal en empleado</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.update_personal_time()</field>
            <field name="active" eval="False"/>
