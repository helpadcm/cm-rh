<odoo>
    <template id="portal_other_request_cm" name="Otras Solicitudes">
        <t t-call="portal.portal_layout">
            <div class="tab-content">
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab1">Crear</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab2">Historial</a>
                    </li>
                </ul>
                <div class="container tab-pane fade show active" id="tab1">
                    <div id="form_view_id">

                        <h2 class="text-center">Crear Solicitud</h2>
                        <!-- <p class="text-center">Aqui puede solicitar un prestamo interno a la empresa, dicha solicitud debe reunir los requisitos necesarios los cuales seran evaluados para su aprobación.</p> -->

                        <div t-if="request.session.get('flash_message')" id="popupNotification" class="popup">
                            <div t-attf-class="alert #{request.session.get('flash_message_type', 'alert-info')}">
                                <t t-esc="request.session.pop('flash_message')"/>
                            </div>
                        </div>

                        <form action="/create_other_request/submit" method="POST" class="mt-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="row g-2 p-3 border rounded" style="border: 2px solid #999999; border-radius: 15px;">
                                <!-- First Column -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Empleado</label>
                                        <input type="text" class="form-control" disabled="disabled" name="employee_name" id="employee_name_id" t-att-value="employee_name"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Lugar</label>
                                        <select class="form-control" name="selection_places" id="selection_place_id" required="required">
                                            <t t-foreach="places" t-as="place">
                                                <option t-att-value="place.id" ><t t-esc="place.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <!-- Second Column -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Fecha de Entrada</label>
                                        <input type="date" class="form-control" name="initial_date_request" id="initial_date_id" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Fecha de Salida</label>
                                        <input type="date" class="form-control" name="exit_date_request" id="exit_date_id" required="required"/>
                                    </div>
                                </div>
                                <!-- Third Column -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Observaciones</label>
                                        <input type="text" class="form-control" name="observations_request" id="observations_id"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Número de personas</label>
                                        <input type="number" required="required" class="form-control" name="people_qty_request" id="people_qty_id"/>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-content">
                                <div id="experience_container"></div>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-primary mt-3">Solicitar</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div id="tab2" class="tab-pane fade">
                    <div class="table-responsive">
                        <table class="table table-striped historical_table" >
                            <thead>
                                <tr>
                                    <th class="header_historical">Fecha de Solicitud</th>
                                    <th class="header_historical">Fecha de Entrada</th>
                                    <th class="header_historical">Fecha de Salida</th>
                                    <th class="header_historical">Lugar</th>
                                    <th class="header_historical">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="request_ids" t-as="req">
                                    <tr>
                                        <td><t t-esc="req.date.strftime('%d/%m/%Y')"/></td>
                                        <td><t t-esc="req.initial_date.strftime('%d/%m/%Y')"/></td>
                                        <td><t t-esc="req.exit_date.strftime('%d/%m/%Y')"/></td>
                                        <td><t t-esc="req.business_id.name"/></td>
                                        <td t-if="req.state == 'draft'">Borrador</td>
                                        <td t-if="req.state == 'to_approve'">Por Aprobar</td>
                                        <td t-if="req.state == 'approved'">Aprobado</td>
                                        <td t-if="req.state == 'refused'">Rechazado</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- JavaScript para el popup -->
            <script>
                // Esperar a que el documento esté completamente cargado
                document.addEventListener("DOMContentLoaded", function() {
                    var popup = document.getElementById("popupNotification");
                    if (popup) {
                        // Mostrar el popup
                        popup.style.display = "block";
                        // Ocultar el popup después de 5 segundos (por ejemplo)
                        setTimeout(function() {
                            popup.style.display = "none";
                        }, 5000); // 5000ms = 5 segundos
                    }
                });

                document.addEventListener("DOMContentLoaded", function () {
                    const peopleInput = document.getElementById("people_qty_id");
                    const container = document.getElementById("experience_container");

                    const beneficiaries = [
                        <t t-foreach="beneficiaries" t-as="ben">
                            { id: <t t-esc="ben.id"/>, name: "<t t-esc="ben.name"/>" },
                        </t>
                    ];

                    function renderExperiences() {
                        const count = parseInt(peopleInput.value, 10) || 0;
                        container.innerHTML = ""; // Limpia contenido previo

                        for (let n = 1; n &lt; count+1; n++) {
                            const block = document.createElement("div");
                            block.className = "border rounded p-3 mb-3";
                            block.style.backgroundColor = "#DBEDDC";

                            // Crear las opciones del select
                            let optionsHtml = beneficiaries.map(b => 
                                `<option value="${b.id}">${b.name}</option>`
                            ).join("");

                            // Construir el bloque
                            block.innerHTML = `
                                <h6>Beneficiario ${n}</h6>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <select class="form-control" name="beneficiary_name_${n}" id="beneficiary_name_${n}_id" required="required">
                                            ${optionsHtml}
                                        </select>
                                    </div>
                                </div>
                            `;
                            container.appendChild(block);
                        }
                    }

                    // Generar al cargar y cuando cambie el número
                    //renderExperiences();
                    peopleInput.addEventListener("change", renderExperiences);
                });
            </script>
            <!-- Estilo del popup -->
            <style>
                .message {
                    padding: 10px 20px;
                    border-radius: 8px;
                    margin-top: 10px;
                    font-weight: bold;
                }
                .message.success {
                    background-color: #d4edda;
                    color: #155724;
                    border: 1px solid #c3e6cb;
                }
                .message.error {
                    background-color: #f8d7da;
                    color: #721c24;
                    border: 1px solid #f5c6cb;
                }

                .header_historical{
                    font-size: 13px !important;
                    background-color: #008000 !important;
                    color: #FFFFFF !important;
                }

                .historical_table tbody tr:hover{
                    background-color: #ABEBC6 !important;
                    transition: background 0.3s;
                }
            </style>
        </t>
    </template>
</odoo>