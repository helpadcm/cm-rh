<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="punctuality_ranking_tree_view" model="ir.ui.view">
            <field name="name">Ranking de puntualidad</field>
            <field name="model">cm.punctuality.ranking</field>
            <field name="arch" type="xml">
                <list string="Ranking de puntualidad" editable="bottom" create="false" delete="false" edit="false">
                    <field name="sequence"/>
                    <field name="employee_id"/>
                    <field name="points" />
                    <field name="attendance_ids" column_invisible="1" widget="many2many_tags"/>
                    <button name="action_show_attendance" string="Ver Registros" type="object" icon="fa-mail-forward" class="btn-primary"/>
                </list>
            </field>
        </record>

        <record id="action_punctuality_ranking" model="ir.actions.act_window">            
            <field name="name">Ranking de puntualidad</field>
            <field name="res_model">cm.punctuality.ranking</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>