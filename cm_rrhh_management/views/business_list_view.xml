<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="business_tree_view" model="ir.ui.view">
            <field name="name">Lista de Negocios</field>
            <field name="model">cm.business.list</field>
            <field name="arch" type="xml">
                <list string="Lista de Negocios" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="email" required="1"/>
                    <field name="cc_email"/>
                    <field name="phone" required="1"/>
                    <field name="business_type" required="1"/>
                    <field name="code" required="1"/>
                    <field name="company_id" options="{'no_create': True}" required="1"/>
                    <field name="color" widget="color_picker" />
                </list>
            </field>
        </record>

        <record id="ferry_routes_tree_view" model="ir.ui.view">
            <field name="name">Rutas del Ferry</field>
            <field name="model">cm.ferry.routes</field>
            <field name="arch" type="xml">
                <list string="Rutas de ferry" editable="bottom">
                    <field name="origin" required="1"/>
                    <field name="destination" required="1"/>
                    <field name="name" readonly="1" force_save="1" required="1"/>
                </list>
            </field>
        </record>

        <record id="action_business_list" model="ir.actions.act_window">            
            <field name="name">Lista de Negocios</field>
            <field name="res_model">cm.business.list</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

        <record id="action_ferry_routes" model="ir.actions.act_window">            
            <field name="name">Rutas de ferry</field>
            <field name="res_model">cm.ferry.routes</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>