<odoo>
    <template id="portal_ferry_request" name="Boletos en ferry">
        <t t-call="portal.portal_layout">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#tab1">Solicitar Boletos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab2">Beneficiarios</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab3">Historial</a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="container tab-pane fade show active" id="tab1">

                    <h2 class="text-center">Solicitud de boletos</h2>
                    <p class="text-center">Desde esta página podrá ingresar sus solicitudes para el beneficio boletos de ferry.</p>

                    <div t-if="request.session.get('flash_message')" id="popupNotification" class="popup">
                        <div t-attf-class="alert #{request.session.get('flash_message_type', 'alert-info')}">
                            <t t-esc="request.session.pop('flash_message')"/>
                        </div>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-6">
                            <form action="/request_tickets_ferry/submit" method="POST" class="mt-2" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="row g-2 p-3 border rounded" style="border: 2px solid #999999; border-radius: 15px;">

                                    <div class="col-12" id="fly_div_id">
                                        <div class="mb-3">
                                            <label class="form-label">Boletos disponibles</label>
                                            <input type="text" disabled="disabled" class="form-control" name="record_ferry_tickets" id="ferry_tickets_id" t-att-value="ferry_tickets"/>
                                        </div>
                                    </div>

                                    <div class="col-12" id="tickets_div_id">
                                        <div class="mb-3">
                                            <label class="form-label">Boletos a tomar</label>
                                            <input type="number" class="form-control" name="record_tickets" id="tickets" t-att-max="ferry_tickets" min="1"/>
                                        </div>
                                    </div>

                                    <div class="col-12"  id="ben1">
                                        <label class="form-label" id="label1">Beneficiario 1</label>
                                        <select class="form-control" name="selection_beneficiary1" id="beneficiary1_id" required="required">
                                            <t t-foreach="beneficiaries_ids" t-as="ben">
                                                <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-12"  id="ben2">
                                        <label class="form-label" id="label3">Beneficiario 2</label>
                                        <select class="form-control" name="selection_beneficiary2" id="beneficiary2_id" required="required">
                                            <t t-foreach="beneficiaries_ids" t-as="ben">
                                                <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-12"  id="ben3">
                                        <label class="form-label" id="label3">Beneficiario 3</label>
                                        <select class="form-control" name="selection_beneficiary3" id="beneficiary3_id" required="required">
                                            <t t-foreach="beneficiaries_ids" t-as="ben">
                                                <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-12"  id="ben4">
                                        <label class="form-label" id="label4">Beneficiario 4</label>
                                        <select class="form-control" name="selection_beneficiary4" id="beneficiary4_id" required="required">
                                            <t t-foreach="beneficiaries_ids" t-as="ben">
                                                <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Ida y Vuelta</label>
                                        <input type="checkbox" checked="on" class="form-check-input" name="round_trip" id="round_trip_id"/>
                                        <label class="form-label">Solo Ida</label>
                                        <input type="checkbox" class="form-check-input" name="exit_only" id="exit_only_id"/>
                                    </div>

                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label class="form-label">Ruta de Ida</label>
                                            <select class="form-control" name="selection_exit_route" id="exit_route_id" required="required">
                                                <t t-foreach="routes" t-as="exit">
                                                    <option t-att-value="exit.id"><t t-esc="exit.name"/></option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="mb-3" id="return_div_id">
                                            <label class="form-label">Ruta de Regreso</label>
                                            <select class="form-control" name="selection_return_route" id="return_route_id">
                                                <t t-foreach="routes" t-as="return">
                                                    <option t-att-value="return.id"><t t-esc="return.name"/></option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label class="form-label">Fecha Ida</label>
                                            <input class="form-control" type="date" name="initial_date" id="initial_date_id" required="required"/>
                                        </div>
                                    </div>

                                    <div class="col-12" id="final_date_div">
                                        <div class="mb-3">
                                            <label class="form-label">Fecha Vuelta</label>
                                            <input class="form-control" type="date" name="final_date" id="final_date_id"/>
                                        </div>
                                    </div>


                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label class="form-label">Notas</label>
                                            <input type="text" name="record_notes" class="form-control" id="notes"/>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label class="form-label">Adjuntar Documento</label>
                                            <input type="file" class="form-control" name="attachments" id="attachment_id" accept=".pdf,.jpg,.png,.doc,.docx" multiple="multiple"/>
                                        </div>
                                    </div>

                                    <div class="col-12 text-center">
                                        <button type="submit" class="btn btn-primary mt-3">Solicitar</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="container tab-pane fade" id="tab2">
                    <div class="table-responsive">
                        <table class="table table-striped historical_table" >
                            <thead>
                                <tr>
                                    <th class="header_historical">Nombre</th>
                                    <th class="header_historical">Identidad</th>
                                    <th class="header_historical">Fecha de nacimiento</th>
                                    <th class="header_historical">Parentesco</th>
                                    <th class="header_historical">Observacion</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="beneficiaries_ids" t-as="beneficary">
                                    <tr>
                                        <td><t t-esc="beneficary.name"/></td>
                                        <td><t t-esc="beneficary.identity"/></td>
                                        <td><t t-esc="beneficary.birthday.strftime('%d/%m/%Y')"/></td>
                                        <td t-if="beneficary.relationship == 'mother'">Madre</td>
                                        <td t-if="beneficary.relationship == 'father'">Padre</td>
                                        <td t-if="beneficary.relationship == 'children'">Hijo(a)</td>
                                        <td t-if="beneficary.relationship == 'siblings'">Hermano(a)</td>
                                        <td t-if="beneficary.relationship == 'couple'">Pareja</td>
                                        <td t-if="beneficary.relationship == 'other'">Otro</td>
                                        <td t-if="beneficary.relationship == 'employee'">Empleado</td>
                                        <td><t t-esc="beneficary.observation"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Crear Nuevo Beneficiario</label>
                        <input type="checkbox" class="form-check-input" name="create_beneficiary" id="create_benficiary_id"/>
                    </div>
                    <div id="beneficiaryForm" style="display: none;">
                        <form action="/create_beneficiary_ferry/submit" method="POST" class="mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="row g-3 p-3 border rounded">
                                <h2 class="text-center">Crear Beneficiario</h2>
                                <div class="col-12 col-md-3">
                                    <label class="form-label">Nombre</label>
                                    <input type="text" class="form-control" name="record_beneficiry_name" id="beneficiary_name_id" required="required"/>
                                </div>

                                <div class="col-12 col-md-3">
                                    <label class="form-label">Identidad</label>
                                    <input type="text" class="form-control" name="record_beneficiry_identity" id="beneficiary_id" required="required"/>
                                </div>

                                <div class="col-12 col-md-3">
                                    <label class="form-label">Fecha de nacimiento</label>
                                    <input type="date" class="form-control" name="record_beneficiry_birth" id="birthday_id" required="required"/>
                                </div>

                                <div class="col-12 col-md-3">
                                    <label class="form-label">Parentesco</label>
                                    <select class="form-control" name="selection_relationship" id="relationship_id" required="required">
                                        <option value="mother">Madre</option>
                                        <option value="father">Padre</option>
                                        <option value="children">Hijo(a)</option>
                                        <option value="siblings">Hermano(a)</option>
                                        <option value="couple">Pareja</option>
                                        <option value="other">Otro</option>
                                    </select>
                                </div>

                                <div class="col-12 col-md-3">
                                    <label class="form-label">Observacion</label>
                                    <input type="text" class="form-control" name="record_beneficiry_obs" id="beneficiary_obs_id"/>
                                </div>

                                <div class="col-12 text-center">
                                    <button type="submit" class="btn btn-primary mt-3">Crear</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div id="tab3" class="tab-pane fade">
                    <div class="table-responsive">
                        <table class="table table-striped historical_table" >
                            <thead>
                                <tr>
                                    <th class="header_historical">Fecha de Solicitud</th>
                                    <th class="header_historical">Fecha de Entrada</th>
                                    <th class="header_historical">Fecha de Salida</th>
                                    <th class="header_historical">Lugar</th>
                                    <th class="header_historical">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="history_ids" t-as="req">
                                    <tr>
                                        <td><t t-esc="req.date.strftime('%d/%m/%Y')"/></td>
                                        <td><t t-esc="req.initial_date.strftime('%d/%m/%Y')"/></td>
                                        <td><t t-esc="req.exit_date.strftime('%d/%m/%Y')"/></td>
                                        <td><t t-esc="req.business_id.name"/></td>
                                        <td t-if="req.state == 'draft'">Borrador</td>
                                        <td t-if="req.state == 'to_approve'">Por Aprobar</td>
                                        <td t-if="req.state == 'approved'">Aprobado</td>
                                        <td t-if="req.state == 'refused'">Rechazado</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <!-- JavaScript para el popup -->
            <script>
                // Esperar a que el documento esté completamente cargado
                document.addEventListener("DOMContentLoaded", function() {
                    var popup = document.getElementById("popupNotification");
                    if (popup) {
                        // Mostrar el popup
                        popup.style.display = "block";
                        // Ocultar el popup después de 5 segundos (por ejemplo)
                        setTimeout(function() {
                            popup.style.display = "none";
                        }, 5000); // 5000ms = 5 segundos
                    }
                });

                document.addEventListener("DOMContentLoaded", function () {
                    var create_beneficiary = document.getElementById("create_benficiary_id");
                    var absence_type = document.getElementById("absence_type");
                    var beneficiaryForm = document.getElementById("beneficiaryForm");
                    var take_tickets = document.getElementById("tickets");
                    var ben1Container = document.getElementById("beneficiary1_id").closest(".col-12");
                    var ben2Container = document.getElementById("beneficiary2_id").closest(".col-12");
                    var ben3Container = document.getElementById("beneficiary3_id").closest(".col-12");
                    var ben4Container = document.getElementById("beneficiary4_id").closest(".col-12");
                    var exit_only = document.getElementById("exit_only_id");
                    var round_trip = document.getElementById("round_trip_id");
                    var returnDiv = document.getElementById("return_div_id");
                    var finalDateDiv = document.getElementById("final_date_div");
                    var finalDate = document.getElementById("final_date_id");
                    var flyDispDiv = document.getElementById("fly_div_id");
                    var flyAvailable = document.getElementById("ferry_tickets_id");

                    function setDefaultValues() {

                        var ticketCount = parseInt(take_tickets.value, 10) || 0; 
                        ben1Container.style.display = "none";
                        ben2Container.style.display = "none";
                        ben3Container.style.display = "none";
                        ben4Container.style.display = "none";


                        if(create_beneficiary.checked){
                            beneficiaryForm.style.display = "block";
                        }else{
                            beneficiaryForm.style.display = "none";
                        }

                        if(exit_only.checked){
                            returnDiv.style.display = "none";
                            finalDateDiv.style.display = "none";
                            finalDate.removeAttribute("required");
                            round_trip.checked = false;
                        }else{
                            returnDiv.style.display = "block";
                            finalDateDiv.style.display = "block";
                            finalDate.setAttribute("required", "required");
                            round_trip.checked = true;
                        }

                        if (ticketCount >= 1){
                            ben1Container.style.display = "block";
                        }else{
                            ben1Container.style.display = "none";
                        }

                        if (ticketCount >= 2){
                            ben2Container.style.display = "block";
                        }else{
                            ben2Container.style.display = "none";
                        }

                        if (ticketCount >= 3){
                            ben3Container.style.display = "block";
                        }else{
                            ben3Container.style.display = "none";
                        }

                        if (ticketCount >= 4){
                            ben4Container.style.display = "block";
                        }else{
                            ben4Container.style.display = "none";
                        }
                    }

                    setDefaultValues();
                    create_beneficiary.addEventListener("change", setDefaultValues);
                    take_tickets.addEventListener("change", setDefaultValues);
                    exit_only.addEventListener("change", setDefaultValues);
                    round_trip.addEventListener("change", setDefaultValues);
                    absence_type.addEventListener("change", setDefaultValues);
                });

            </script>

            <!-- Estilo del popup -->
            <style>
                .popup {
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    background-color: #f8d7da;
                    color: #721c24;
                    border: 1px solid #f5c6cb;
                    padding: 10px 20px;
                    border-radius: 5px;
                    z-index: 9999;
                    display: none;  /* Inicialmente oculto */
                }

                .popup .alert {
                    margin: 0;
                }

                .header_historical{
                    font-size: 13px !important;
                    background-color: #008000 !important;
                    color: #FFFFFF !important;
                }

                .historical_table tbody tr:hover{
                    background-color: #ABEBC6 !important;
                    transition: background 0.3s;
                }
            </style>
        </t>
    </template>
</odoo>
