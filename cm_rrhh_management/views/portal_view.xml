<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="requests_view_portal" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/cm_rrhh_management/static/src/img/requests_icon.png'"/>
                <t t-set="title">Plan de Beneficios</t>
                <t t-set="text">Desde aqui podra realizar sus diferentes solicitudes al area de talento humano</t>
                <t t-set="url" t-value="'/requests_cm/request_home_cm'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
</odoo>
