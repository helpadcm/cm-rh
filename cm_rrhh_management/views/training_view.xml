<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="trainigns_rrhh_form_view" model="ir.ui.view">
            <field name="name">Capacitaciones</field>
            <field name="model">cm.rrhh.trainings</field>
            <field name="arch" type="xml">
                <form string="Capacitaciones">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre de la capacitacion" required="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="date" required="1"/>
                                <label for="initial_hour" string="Tiempo de Capacitacion"/>
                                <div class="o_row">
                                    <field name="initial_hour" required="1" placeholder="Hora de Inicio"/>
                                    <field name="final_hour" required="1" placeholder="Hora Fin"/>
                                </div>
                            </group>
                            <group>
                                <field name="external_instructor" />
                                <field name="instructor_ids" invisible="external_instructor" options="{'no_create': True, 'no_open': True}" widget="many2many_tags" placeholder="Instructor que impartira la capacitacion" required="not external_instructor"/>
                                <field name="instructor" invisible="not external_instructor" placeholder="Instructor que impartira la capacitacion" required="external_instructor"/>
                                <field name="place" placeholder="Lugar de la capacitacion" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Participantes">
                                <field name="participants_ids">
                                    <tree editable="bottom">
                                        <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="certificate_delivered" />
                                        <field name="certificate_file" readonly="not certificate_delivered" required="certificate_delivered" filename="certificate_file_name" widget="binary"/>
                                        <field name="certificate_file_name" column_invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="trainigns_rrhh_tree_view" model="ir.ui.view">
            <field name="name">Capacitaciones</field>
            <field name="model">cm.rrhh.trainings</field>
            <field name="arch" type="xml">
                <tree string="Capacitaciones">
                    <field name="name"/>
                    <field name="instructor"/>
                    <field name="place" />
                    <field name="date" />
                    <field name="initial_hour"/>
                    <field name="final_hour"/>
                </tree>
            </field>
        </record>

        <record id="trainigns_rrhh_search_view" model="ir.ui.view">
            <field name="name">Capacitaciones search</field>
            <field name="model">cm.rrhh.trainings</field>
            <field name="arch" type="xml">
                <search string="Capacitaciones">
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="instructor" filter_domain="[('instructor', 'ilike', self)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_date" string="Fecha de Creacion" domain="[]" context="{'group_by':'date'}"/>
                        <filter name="group_instructor" string="Programa" domain="[]" context="{'group_by':'instructor'}"/>
                        <filter name="group_place" string="Lugar" domain="[]" context="{'group_by':'place'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_trainigns_rrhh_cm" model="ir.actions.act_window">            
            <field name="name">Capacitaciones</field>
            <field name="res_model">cm.rrhh.trainings</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>