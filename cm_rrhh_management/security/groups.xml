<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
		 <record model="ir.module.category" id="rrhh_management_cm_category">
		    <field name="name">Gestiones RRHH</field>
		    <field name="description">Permisos para gestiones de rrhh</field>
		    <field name="sequence">20</field>
		</record>
		
		<record id="group_legal_area_rrhh" model="res.groups">
			<field name="name">RRHH Legal</field>
			<field name="category_id" ref="rrhh_management_cm_category"/>
		</record>
		
		<record id="group_recruitment_area_rrhh" model="res.groups">
			<field name="name">RRHH Reclutamiento</field>
			<field name="category_id" ref="rrhh_management_cm_category"/>
		</record>

		<record id="group_payroll_area_rrhh" model="res.groups">
			<field name="name">RRHH Nomina y Beneficios</field>
			<field name="category_id" ref="rrhh_management_cm_category"/>
		</record>

		<record id="group_finance_area_rrhh" model="res.groups">
			<field name="name">Finanzas</field>
			<field name="category_id" ref="rrhh_management_cm_category"/>
		</record>

		<record id="group_manager_area_rrhh" model="res.groups">
			<field name="name">Administrador TH</field>
			<field name="category_id" ref="rrhh_management_cm_category"/>
		</record>


<!-- ####################################  RRHH RULES  #################################### -->
		<record id="user_payroll_area_rule" model="ir.rule">
            <field name="name">Regla Usuario Nomina y Beneficios</field>
            <field name="model_id" ref="cm_rrhh_management.model_rrhh_others_requests"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('cm_rrhh_management.group_payroll_area_rrhh'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="manager_payroll_area_rule" model="ir.rule">
            <field name="name">Regla Administrador Nomina y Benefeicios</field>
            <field name="model_id" ref="cm_rrhh_management.model_rrhh_others_requests"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_rrhh_management.group_manager_area_rrhh'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="user_training_rule" model="ir.rule">
            <field name="name">Regla Usuario Capacitaciones</field>
            <field name="model_id" ref="cm_rrhh_management.model_cm_rrhh_trainings"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[
				(4, ref('cm_rrhh_management.group_legal_area_rrhh')),
				(4, ref('cm_rrhh_management.group_recruitment_area_rrhh')),
				(4, ref('cm_rrhh_management.group_payroll_area_rrhh')),
			]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="manager_training_rule" model="ir.rule">
            <field name="name">Regla Administrador Capacitaciones</field>
            <field name="model_id" ref="cm_rrhh_management.model_cm_rrhh_trainings"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_rrhh_management.group_manager_area_rrhh'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
	</data>
</odoo>


