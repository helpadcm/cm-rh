<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="exeptional_reason_list_view" model="ir.ui.view">
            <field name="name">Motivos exepcionales</field>
            <field name="model">expense.exceptional.reason</field>
            <field name="arch" type="xml">
                <list string="Motivos exepcionales" editable="top">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="skip_exception" />
                </list>
            </field>
        </record>

        <record id="action_expetional_reason" model="ir.actions.act_window">            
            <field name="name">Motivos exepcionales</field>
            <field name="res_model">expense.exceptional.reason</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>
    </data>
</odoo>