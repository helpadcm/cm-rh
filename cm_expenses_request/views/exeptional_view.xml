<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="exeptional_reason_list_view" model="ir.ui.view">
            <field name="name">Motivos exepcionales</field>
            <field name="model">expense.exceptional.reason</field>
            <field name="arch" type="xml">
                <list string="Motivos exepcionales" editable="top">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="skip_exception" />
                </list>
            </field>
        </record>

        <record id="lodging_list_view" model="ir.ui.view">
            <field name="name">Hospedajes</field>
            <field name="model">expense.lodging.cobus</field>
            <field name="arch" type="xml">
                <list string="Hospedajes" editable="top">
                    <field name="name" required="1"/>
                    <field name="cti_id" options="{'no_create': True}" required="1"/>
                </list>
            </field>
        </record>

        <record id="transport_distribution_list_view" model="ir.ui.view">
            <field name="name">Distribucion de Transporte</field>
            <field name="model">transport.distribution.cobus</field>
            <field name="arch" type="xml">
                <list string="Distribucion" editable="top">
                    <field name="name" required="1"/>
                    <field name="cti_id" options="{'no_create': True}" required="1"/>
                    <field name="currency_id" options="{'no_create': True}" required="1"/>
                    <field name="day_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="night_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="morning_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </list>
            </field>
        </record>

        <record id="action_expetional_reason" model="ir.actions.act_window">            
            <field name="name">Motivos exepcionales</field>
            <field name="res_model">expense.exceptional.reason</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

        <record id="action_lodging_cobus" model="ir.actions.act_window">            
            <field name="name">Hospedajes</field>
            <field name="res_model">expense.lodging.cobus</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

        <record id="action_distribution_transport" model="ir.actions.act_window">            
            <field name="name">Distribucion de transporte</field>
            <field name="res_model">transport.distribution.cobus</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>
    </data>
</odoo>