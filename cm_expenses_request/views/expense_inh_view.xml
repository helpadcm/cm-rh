<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="expenses_inh_form">
            <field name="name">expenses.form.inh</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group/group[2]" position="inside">
                    <field name="budget_account_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1" />
                    <field name="process_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1" />
                </xpath>
                <field name="price_unit" position="before">
                    <field name="invoice_number" required="1"/>
                    <field name="reason_expense" invisible="1" readonly="state != 'draft'"/>
                </field>
                <field name="description" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
            </field>
        </record>

