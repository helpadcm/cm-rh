        <record model="ir.ui.view" id="product_expenses_inh_form">
            <field name="name">product.expense.form.inh</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="hr_expense.product_product_expense_form_view"/>
            <field name="arch" type="xml">
                <field name="supplier_taxes_id" position="before">
                    <field name="budget_account_id" options="{'no_create': True,'no_open': True}"/>
                    <field name="training_budget_account_id" options="{'no_create': True,'no_open': True}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
