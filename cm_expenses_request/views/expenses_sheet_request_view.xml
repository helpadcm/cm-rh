        <record id="action_expenses_request_sheet" model="ir.actions.act_window">            
            <field name="name">Solicitud de viaticos</field>
            <field name="res_model">expenses.sheet.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>