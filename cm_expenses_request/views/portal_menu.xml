<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_portal_my_home" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-if="request.env['hr.employee'].sudo().search([('user_id', '=', request.env.user.id)], limit=1).show_settlement_menu">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/cm_expenses_request/static/src/img/viaticos.png'"/>
                    <t t-set="title">Liquidación de Viaticos</t>
                    <t t-set="text">Ingrese sus gastos correspondientes a los viaticos asignados</t>
                    <t t-set="url" t-value="'/expenses/settlement_expenses'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>

        </xpath>
    </template>
</odoo>