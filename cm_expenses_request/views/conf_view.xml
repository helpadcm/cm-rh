<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="conf_expenses_view_inherit" model="ir.ui.view">
            <field name="name">Conf. Solicitud de viaticos</field>
            <field name="model">conf.expenses.request</field>
            <field name="arch" type="xml">
                <form string="Conf. Solicitud de viaticos">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" required="1"/></h1>
                        </div>
                        <label for="job_ids"/>
                        <field name="job_ids" options="{'no_create': True}" required="1" widget="many2many_tags"/>
                        <notebook>
                            <page string="Montos para viaticos">
                                <field name="details_expenses_ids">
                                    <list editable="bottom">
                                        <field name="ctis_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                        <field name="currency_id" required="1" options="{'no_create': True}"/>
                                        <field name="breakfast_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="lunch_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="dinner_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="total_amount" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="conf_expenses_request_tree_view" model="ir.ui.view">
            <field name="name">Conf. Solicitud de viaticos</field>
            <field name="model">conf.expenses.request</field>
            <field name="arch" type="xml">
                <list string="Conf. Solicitud de viaticos">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_expenses_request_conf" model="ir.actions.act_window">            
            <field name="name">Conf. Solicitud de viaticos</field>
            <field name="res_model">conf.expenses.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>
    </data>
</odoo>