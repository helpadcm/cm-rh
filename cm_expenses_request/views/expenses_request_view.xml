<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="expenses_request_form_view" model="ir.ui.view">
            <field name="name">COBUS</field>
            <field name="model">cm.expenses.request</field>
            <field name="arch" type="xml">
                <form string="COBUS">
                    <header>
                        <button name="change_state" context="{'state': 'required'}" class="oe_highlight" type="object" string="Validar" invisible="state != 'draft'"/>
                        <button name="change_state" context="{'state': 'approved'}" class="oe_highlight" 
                                type="object" string="Aprobar" 
                                groups="cm_expenses_request.group_expenses_request_boss,cm_expenses_request.group_expenses_request_manager" invisible="state != 'required'"/>
                        <button name="%(cm_expenses_request.assign_expenses_action)d"  
                                class="oe_highlight" type="action" string="Asignar" 
                                groups="cm_expenses_request.group_expenses_request_purchase,cm_expenses_request.group_expenses_request_manager" 
                                invisible="state != 'approved'" context="{'default_amount': advance_amount}"/>
                        <button name="%(cm_expenses_request.deposit_expenses_action)d"  
                                class="oe_highlight" type="action" string="Depositar"
                                invisible="state != 'assigned' or balance_employee_amount == 0" context="{'default_amount': balance_employee_amount, 'default_currency_id': currency_id}"/>
                        <button name="change_state" context="{'state': 'pending'}" class="oe_highlight" 
                                type="object" string="Enviar a Liquidar" invisible="state != 'assigned' or infavor_employee_amount > 0" />
                        <button name="%(cm_expenses_request.exeptional_reason_action)d" context="{'state': 'exception'}" class="oe_highlight" type="action" 
                                string="Solicitar Reembolso" invisible="state != 'assigned' or infavor_employee_amount == 0 or infavor_employee_amount &lt; 0" />
                        <button name="change_state" context="{'state': 'draft'}" class="oe_highlight btn-info" type="object" string="Regresar a Borrador" invisible="state != 'required'"/>

                        <button name="approve_exception" class="oe_highlight" type="object" string="Aprobar Excepcion" invisible="state != 'exception'"/>
                        <button name="reject_exception" class="oe_highlight btn-danger" type="object" string="Rechazar Excepcion" invisible="state != 'exception'"/>
                        <button name="refunded_balance" class="oe_highlight btn-success" type="object" string="Reembolsar" confirm="¿Esta seguro de querer marcar como reembolsado?" invisible="state != 'finalized' or refund_done or refund_state != 'without_refund'" groups="cm_expenses_request.group_expenses_request_manager"/>


                        <field name="state" widget="statusbar" statusbar_visible="draft,required,approved,assigned,pending,finalized"/>
                  	</header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"> 
                            <button name="show_expenses_debit" type="object" class="oe_stat_button" icon="fa-dollar" invisible="state not in ['assigned','pending','finalized']" groups="cm_expenses_request.group_expenses_request_manager">Ver Debito</button>
                            <button name="show_expenses_deposit" type="object" class="oe_stat_button" icon="fa-dollar" invisible="state not in ['assigned','pending','finalized'] or refund_amount == 0" groups="cm_expenses_request.group_expenses_request_manager">Ver Deposito</button>
                            <button name="show_expenses_report" type="object" class="oe_stat_button" icon="fa-external-link-square" invisible="state not in ['pending','finalized']" groups="cm_expenses_request.group_expenses_request_manager,cm_expenses_request.group_expenses_request_responsible">Ver reporte</button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group string="Datos empleado">
                            <group>
                                <field name="employee_id" options="{'no_create': True,'no_open': True}" readonly="state != 'draft' or not edit_employee"/>
                                <field name="department_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1"/>
                                <field name="job_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1"/>
                                <field name="date" invisible="1" readonly="state != 'draft'"/>
                                <field name="process_id" domain="[('id','in',process_ids)]" options="{'no_create': True,'no_open': True}" readonly="state != 'draft'" required="1" force_save="1" />
                                <field name="direct_settlement" invisible="1"/>
                            </group>
                            <group>
                                <field name="assign_to_id" domain="[('id','in',allow_employee_ids)]" options="{'no_create': True,'no_open': True}" readonly="state != 'draft'"/>
                                <field name="account_number" readonly="1" force_save="1"/>
                                <field name="purpose" required="not direct_settlement" invisible="direct_settlement" readonly="state != 'draft'"/>
                                <field name="purpose" required="direct_settlement" invisible="not direct_settlement" readonly="state != 'assigned'"/>
                                <field name="request_type" required="1" invisible="direct_settlement" readonly="state != 'draft'"/>
                                <field name="request_type" required="1" invisible="not direct_settlement" readonly="state != 'assigned'"/>
                                <field name="currency_id" invisible="1" options="{'no_create': True,'no_open': True}"/>
                                <field name="boss_id" invisible="1"/>
                                <field name="refund_done" invisible="1"/>
                                <field name="refund_state" invisible="1"/>
                                <field name="reason_expense" invisible="1" readonly="state != 'draft'"/>
                                <field name="process_ids" widget="many2many_tags" options="{'no_create': True,'no_open': True}" invisible="1" force_save="1" />
                                <field name="allow_employee_ids" widget="many2many_tags" options="{'no_create': True,'no_open': True}" invisible="1" force_save="1" />
                            </group>
                        </group>
                        <group string="Otras solicitudes" col="3" invisible="direct_settlement">
                            <group>
                                <field name="need_tickets" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="need_transport" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="need_hotel" readonly="state != 'draft'"/>
                                <field name="ctis_hotels_ids" invisible="not need_hotel" required="need_hotel" domain="[('hotel_contact','=',True)]" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Otras solicitudes" col="3" invisible="not direct_settlement">
                            <group>
                                <field name="need_tickets" readonly="state != 'assigned'"/>
                            </group>
                            <group>
                                <field name="need_transport" readonly="state != 'assigned'"/>
                            </group>
                            <!-- <group>
                                <field name="need_hotel" readonly="state != 'assigned'"/>
                                <field name="ctis_hotels_ids" invisible="not need_hotel" required="need_hotel and not assigned" domain="[('hotel_contact','=',True)]" widget="many2many_tags"/>
                            </group> -->
                        </group>
                        <group>
                            <field name="hotel_specifications" placeholder="¿Necesita que la empresa gestione la reservación del hotel? Si usted solicitará viáticos para pagar el hotel por su cuenta, no seleccione esta opción. Si necesita que la empresa realice la reservación, ingrese las especificaciones, como las fechas y ciudades de estadía." invisible="not need_hotel" required="need_hotel" readonly="state != 'draft'"/>
                        </group>
                        <group string="Totales">
                            <group>
                                <field name="advance_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                                <field name="balance_employee_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state in ['draft','required','approved']" readonly="1" force_save="1"/>
                                <field name="refund_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="refund_amount == 0" readonly="1" force_save="1"/>
                                <field name="quote_amount_tickets" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="quote_amount_tickets == 0" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="total_expense_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" invisible="state in ['draft','required','approved','canceled']"/>
                                <field name="infavor_employee_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="infavor_employee_amount == 0" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="details" string="Detalles de Gasto" invisible="direct_settlement">
                                <field name="request_details_ids" required="1" context="{'default_job_id': job_id, 'default_currency_id': currency_id}" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="currency_id" column_invisible="1" options="{'no_create': True,'no_open': True}"/>
                                        <field name="job_id" column_invisible="1"/>
                                        <field name="date" required="1"/>
                                        <field name="breakfast_cti_id" options="{'no_create': True,'no_open': True}"/>
                                        <field name="lunch_cti_id" options="{'no_create': True,'no_open': True}"/>
                                        <field name="dinner_cti_id" options="{'no_create': True,'no_open': True}"/>
                                        <field name="breakfast_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" string="Desayuno" sum="Total Desayuno"/>
                                        <field name="lunch_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" string="Almuerzo" sum="Total Almuerzo"/>
                                        <field name="dinner_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" string="Cena" sum="Total Cena"/>
                                        <field name="transport_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Transporte"/>
                                        <field name="tax_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Impuestos"/>
                                        <field name="parking_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Parqueo"/>
                                        <field name="purchase_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Compras"/>
                                        <field name="others_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Otros"/>
                                        <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" force_save="1" sum="Total Dia"/>
                                    </list>
                                </field>
                            </page>
                            <page name="tickets" string="Boletos Solicitados" invisible="not need_tickets">
                            <!-- <page name="tickets" string="Boletos Solicitados" invisible="1"> -->
                                <field name="tickets_request_ids" invisible="direct_settlement" readonly="state != 'draft'" context="{'default_currency_id': currency_id}">
                                    <form>
                                        <group>
                                            <group>
                                                <field name="request_type" required="1"/>
                                                <field name="more_luggage"/>
                                                <field name="ticket_type_request" invisible="1"/>
                                                <field name="currency_id" invisible="1" options="{'no_create': True,'no_open': True}"/>
                                            </group>
                                            <group>
                                                <field name="airline_id" options="{'no_create': True,'no_open': True}" required="1"/>
                                                <field name="passport_file" filename="passport_file_name" widget="binary"/>
                                                <field name="passport_file_name" invisible="1"/>
                                            </group>
                                        </group>

                                        <group string="Datos Solicitud Externa" invisible="ticket_type_request != 'external'">
                                            <group>
                                                <field name="quote_file" filename="quote_file_name" widget="binary" required="ticket_type_request == 'external'"/>
                                                <field name="quote_file_name" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="quote_amount" widget="monetary" options="{'currency_field': 'currency_id'}" required="1"/>
                                            </group>
                                        </group>

                                        <notebook invisible="ticket_type_request == 'external'">
                                            <page name="routes" string="Rutas">
                                                <field name="list_routes_ids">
                                                    <list editable="bottom">
                                                        <field name="sequence" column_invisible="1" readonly="1"/>
                                                        <field name="ticket_type" column_invisible="1" readonly="1" force_save="1"/>
                                                        <field name="route_id" options="{'no_create': True}" required="1"/>
                                                        <field name="date" required="1"/>
                                                        <field name="flight_select" required="1"/>
                                                        <field name="observations" />
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </form>
                                    <list>
                                        <field name="name" />
                                        <field name="request_type"/>
                                        <field name="airline_id"/>
                                    </list>
                                </field>
                                <field name="tickets_request_ids" invisible="not direct_settlement" readonly="state != 'assigned'" context="{'default_currency_id': currency_id}">
                                    <form>
                                        <group>
                                            <group>
                                                <field name="request_type" required="1"/>
                                                <field name="more_luggage"/>
                                                <field name="ticket_type_request" invisible="1"/>
                                                <field name="currency_id" invisible="1" options="{'no_create': True,'no_open': True}"/>
                                            </group>
                                            <group>
                                                <field name="airline_id" domain="[('ticket_type_request','=','external')]" options="{'no_create': True,'no_open': True}" required="1"/>
                                                <field name="passport_file" filename="passport_file_name" widget="binary"/>
                                                <field name="passport_file_name" invisible="1"/>
                                            </group>
                                        </group>

                                        <group string="Datos Solicitud Externa" invisible="ticket_type_request != 'external'">
                                            <group>
                                                <field name="quote_file" filename="quote_file_name" widget="binary" required="ticket_type_request == 'external'"/>
                                                <field name="quote_file_name" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="quote_amount" widget="monetary" options="{'currency_field': 'currency_id'}" required="1"/>
                                            </group>
                                        </group>
                                    </form>
                                    <list>
                                        <field name="name" />
                                        <field name="request_type"/>
                                        <field name="airline_id"/>
                                    </list>
                                </field>
                            </page>
                            <page name="expenses" string="Gastos" invisible="state in ['draft','required','approved','canceled']">
                                <field name="expenses_ids" 
                                    context="{'default_employee_id': assign_to_id,
                                            'default_reason_expense': reason_expense, 
                                            'default_process_id': process_id, 
                                            'default_request_id': id, 
                                            'default_request_type': request_type,
                                            'default_currency_id': currency_id}" readonly="state in ['pending','exception','finalized','canceled']">
                                    <list>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="name" />
                                        <field name="invoice_number"/>
                                        <field name="message_main_attachment_id" string="Adjunto"/>
                                        <field name="date" />
                                        <field name="total_amount_currency"/>
                                    </list>
                                    <form>
                                        <header>
                                            <!-- With attachments the attach document comes last-->
                                            <widget name="attach_document" string="Adjuntar recibo" action="attach_document" highlight="1" invisible="nb_attachment &gt;= 1"/>
                                            <!-- With attachments the attach_document comes last -->
                                            <widget name="attach_document" string="Adjuntar recibo" action="attach_document" invisible="nb_attachment == 0"/>
                                            <!-- Statusbar -->
                                            <field name="state" widget="statusbar" statusbar_visible="draft,approved,posted,paid"
                                                invisible="state in ('submitted', 'in_payment', 'refused')"/>
                                            <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted,paid"
                                                invisible="state != 'submitted'"/>
                                            <field name="state" widget="statusbar" statusbar_visible="draft,approved,posted,in_payment,paid"
                                                invisible="state != 'in_payment'"/>
                                            <field name="state" widget="statusbar" statusbar_visible="draft,approved,posted,paid,refused"
                                                invisible="state != 'refused'"/>
                                        </header>
                                        <div class="alert alert-warning oe_edit_only" role="alert" name="warning_duplicate_receipt_expense" invisible="not same_receipt_expense_ids">
                                            Ya existe un <a type="object" name="action_show_same_receipt_expense_ids">gasto</a> con el mismo comprobante.
                                        </div>
                                        <sheet>
                                            <div class="float-end me-2 mt-2">
                                                <!-- Si TIENE adjunto (nb_attachment >= 1) -->
                                                <span class="badge rounded-pill bg-success p-2 fs-6" invisible="nb_attachment == 0">
                                                    <i class="fa fa-paperclip me-1"/> Recibo Cargado
                                                </span>
                                                <!-- Si NO TIENE adjunto (nb_attachment == 0) -->
                                                <span class="badge rounded-pill bg-danger p-2 fs-6" invisible="nb_attachment &gt;= 1">
                                                    <i class="fa fa-exclamation-triangle me-1"/> Sin Recibo
                                                </span>
                                            </div>
                                            <div class="oe_title">
                                                <label for="name"/>
                                                <h1>
                                                    <field name="name" placeholder="por ejemplo, comida con cliente" readonly="not is_editable"/>
                                                </h1>
                                            </div>
                                            <group>
                                                <group>
                                                    <field name="product_has_cost" invisible="1"/>
                                                    <field name="product_has_tax" invisible="1"/>
                                                    <field name="is_multiple_currency" invisible="1"/>
                                                    <field name="is_editable" invisible="1"/>
                                                    <field name="currency_id" invisible="1"/>
                                                    <field name="company_currency_id" invisible="1"/>
                                                    <field name="tax_amount" invisible="1"/>
                                                    <field name="price_unit" invisible="1"/>
                                                    <field name="nb_attachment" invisible="1"/>
                                                    <field name="total_amount" invisible="1"/>
                                                    <field name="duplicate_expense_ids" invisible="1"/>
                                                    <field name="currency_rate" invisible="1"/>
                                                    <field name="selectable_payment_method_line_ids" invisible="1"/>

                                                    <field name="date" readonly="not is_editable" class="w-50"/>
                                                    <field name="reason_expense" invisible="1" readonly="state != 'draft'"/>

                                                    <label for="product_id"/>
                                                    <div>
                                                        <field name="product_id" required="1" readonly="not is_editable"
                                                            context="{
                                                                'default_type': 'service',
                                                                'default_can_be_expensed': 1,
                                                                'list_view_ref': 'hr_expense.product_product_expense_tree_view',
                                                                'form_view_ref': 'hr_expense.product_product_expense_form_view',
                                                            }"
                                                            options="{'no_create': True}"
                                                            class="w-100"/>
                                                        <div class="fst-italic" invisible="not is_editable or not product_description or not product_id">
                                                            <field name="product_description"/>
                                                        </div>
                                                    </div>
                                                    
                                                    <field name="invoice_number" invisible="request_type != 'national'" required="1" placeholder="Ejemplo: 000-000-00-00000000"/>
                                                    <field name="invoice_number" invisible="request_type != 'international'" required="1" placeholder="El número de factura extranjera"/>

                                                    <label for="total_amount_currency" string="Total" invisible="product_has_cost" readonly="not is_editable"/>
                                                    <div class="o_row" invisible="product_has_cost">
                                                        <field name="total_amount_currency" widget='monetary' options="{'currency_field': 'currency_id'}"
                                                            readonly="not is_editable" class="oe_inline mw-50 me-0"/>
                                                        <field name="currency_id" class="mw-25 ms-0" groups="base.group_multi_currency"
                                                            options="{'no_create': True, 'no_open': True}"
                                                            readonly="not is_editable"/>
                                                        <span class="d-flex" invisible="tax_amount == 0">(incl <field name="tax_amount" class="mx-1"/> tax)</span>
                                                    </div>
                                                </group>
                                                <group>
                                                    <field name="company_id" options="{'no_open': True}" groups="base.group_multi_company" readonly="1"/>
                                                    <field name="manager_id" widget="many2one_avatar_user" invisible="1" placeholder="Auto-validation"/>
                                                    <field name="department_id" invisible="1" readonly="not is_editable"
                                                        context="{'default_company_id': company_id}"/>
                                                    <field name="vendor_id" invisible="payment_mode != 'company_account'"/>
                                                    <field name="account_id" options="{'no_create': True, 'no_open': True}"
                                                        domain="[('account_type', 'not in', ('asset_receivable','liability_payable','asset_cash','liability_credit_card')), ('company_ids', 'parent_of', company_id)]"
                                                        groups="account.group_account_readonly" readonly="1"
                                                        context="{'default_company_id': company_id}"/>
                                                    <field name="payment_method_line_id"
                                                        options="{'no_open': True, 'no_create': True}"
                                                        invisible="payment_mode != 'company_account'"
                                                        readonly="not is_editable"
                                                        required="payment_mode == 'company_account'"/>
                                                    <field name="analytic_distribution" widget="analytic_distribution"
                                                        groups="analytic.group_analytic_accounting"
                                                        options="{'product_field': 'product_id', 'account_field': 'account_id', 'business_domain': 'expense'}"
                                                        readonly="1"/>
                                                    <field name="budget_account_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1" />
                                                    <field name="process_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1" />
                                                    <field name="request_type" force_save="1" invisible="0" readonly="1"/>
                                                </group>
                                            </group>
                                            <div>
                                                <field name="description" placeholder="Notas..." required="1" readonly="not is_editable"/>
                                            </div>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page name="exceptions" string="Excepcion" invisible="exeption_id in [False,None]">
                                <group>
                                    <group>
                                        <field name="exeption_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="description" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Otros" groups="base.group_no_one">
                                <group>
                                    <group>
                                        <field name="edit_employee"/>
                                        <field name="omit_settlement"/>
                                    </group>
                                    <group>
                                        <field name="limit_date"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                        <field name="observations" placeholder="Observaciones y Justificaciones" readonly="state != 'draft'"/>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="expenses_request_tree_view" model="ir.ui.view">
            <field name="name">COBUS</field>
            <field name="model">cm.expenses.request</field>
            <field name="arch" type="xml">
                <list string="COBUS">
                    <field name="name"/>
                    <field name="employee_id" />
                    <field name="assign_to_id" />
                    <field name="date"/>
                    <field name="purpose"/>
                    <field name="refund_state" widget="badge" decoration-info="refund_state == 'na'" decoration-danger="refund_state == 'without_refund'" decoration-success="refund_state == 'refunded'" />
                    <field name="advance_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                    <field name="infavor_employee_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total a favor"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="expenses_request_search_view" model="ir.ui.view">
            <field name="name">COBUS search</field>
            <field name="model">cm.expenses.request</field>
            <field name="arch" type="xml">
                <search string="COBUS">
                    <field name="employee_id" filter_domain="[('employee_id', 'ilike', self)]"/>
                    <field name="assign_to_id" filter_domain="[('assign_to_id', 'ilike', self)]"/>
                    <field name="purpose" filter_domain="[('purpose', 'ilike', self)]"/>
                    <separator/>
                    <filter string="Aprobado" name="approved_filter" domain="[('state','=','approved')]"/>
                    <filter string="Otorgado" name="assigned_filter" domain="[('state','=','assigned')]"/>
                    <separator/>
                    <group>
                        <filter name="group_request_by" string="Solicitado por" domain="[]" context="{'group_by':'employee_id'}"/>
                        <filter name="group_assigned" string="Asignado a" domain="[]" context="{'group_by':'assign_to_id'}"/>
                        <filter name="group_date" string="Fecha de solicitud" domain="[]" context="{'group_by':'date'}"/>
                        <filter name="group_state" string="Estado" domain="[]" context="{'group_by':'state'}"/>
                        <filter name="group_department" string="Departamento" domain="[]" context="{'group_by':'department_id'}"/>
                        <filter name="group_process" string="Proceso" domain="[]" context="{'group_by':'process_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_expenses_request" model="ir.actions.act_window">            
            <field name="name">COBUS</field>
            <field name="res_model">cm.expenses.request</field>
