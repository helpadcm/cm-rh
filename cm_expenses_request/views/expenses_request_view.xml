<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="expenses_request_form_view" model="ir.ui.view">
            <field name="name">Solicitud de viaticos</field>
            <field name="model">cm.expenses.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud de viaticos">
                    <header>
                        <button name="change_state" context="{'state': 'required'}" class="oe_highlight" type="object" string="Validar" invisible="state != 'draft'"/>
                        <button name="change_state" context="{'state': 'approved'}" class="oe_highlight" type="object" string="Aprobar" groups="cm_expenses_request.group_expenses_request_boss,cm_expenses_request.group_expenses_request_manager" invisible="state != 'required'"/>
                        <button name="%(cm_expenses_request.assign_expenses_action)d"  
                                class="oe_highlight" type="action" string="Asignar" 
                                groups="cm_expenses_request.group_expenses_request_purchase,cm_expenses_request.group_expenses_request_manager" 
                                invisible="state != 'approved'" context="{'default_amount': advance_amount}"/>
                        <button name="%(cm_expenses_request.deposit_expenses_action)d"  
                                class="oe_highlight" type="action" string="Depositar" 
                                invisible="state != 'assigned' or balance_employee_amount == 0" context="{'default_amount': balance_employee_amount}"/>
                        <button name="change_state" context="{'state': 'pending'}" class="oe_highlight" type="object" string="Enviar a Liquidar" invisible="state != 'assigned'"/>
                        <button name="change_state" context="{'state': 'draft'}" class="oe_highlight btn-info" type="object" string="Regresar a Borrador" invisible="state != 'required'"/>
                        <field name="state" widget="statusbar"/>
                  	</header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"> 
                            <button name="show_expenses_debit" type="object" class="oe_stat_button" icon="fa-dollar" invisible="state not in ['assigned','pending','finalized']" groups="cm_expenses_request.group_expenses_request_purchase,cm_expenses_request.group_expenses_request_manager">Ver Debito</button>
                            <button name="show_expenses_deposit" type="object" class="oe_stat_button" icon="fa-dollar" invisible="state not in ['assigned','pending','finalized'] or refund_amount == 0" groups="cm_expenses_request.group_expenses_request_purchase,cm_expenses_request.group_expenses_request_manager">Ver Deposito</button>
                            <button name="show_expenses_report" type="object" class="oe_stat_button" icon="fa-external-link-square" invisible="state not in ['pending','finalized']" groups="cm_expenses_request.group_expenses_request_purchase,cm_expenses_request.group_expenses_request_manager">Ver reporte</button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" options="{'no_create': True,'no_open': True}" readonly="state != 'draft'"/>
                                <field name="department_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1"/>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="process_id" domain="[('id','in',process_ids)]" options="{'no_create': True,'no_open': True}" readonly="state != 'draft'" required="1" force_save="1" />
                            </group>
                            <group>
                                <field name="job_id" options="{'no_create': True,'no_open': True}" readonly="1" force_save="1"/>
                                <field name="account_number" readonly="1" for_save="1"/>
                                <field name="purpose" required="1" readonly="state != 'draft'"/>
                                <field name="boss_id" invisible="1"/>
                                <field name="reason_expense" required="1" readonly="state != 'draft'"/>
                                <field name="process_ids" widget="many2many_tags" options="{'no_create': True,'no_open': True}" invisible="1" force_save="1" />
                            </group>
                        </group>
                        <group col="3">
                            <group>
                                <field name="need_tickets" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="need_transport" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="need_hotel" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group string="Totales">
                            <group>
                                <field name="advance_amount" readonly="1" force_save="1"/>
                                <field name="balance_employee_amount" readonly="1" force_save="1"/>
                                <field name="refund_amount" invisible="refund_amount == 0" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="total_expense_amount" readonly="1" force_save="1"/>
                                <field name="infavor_employee_amount" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="details" string="Detalles de Gasto">
                                <field name="request_details_ids" required="1" context="{'default_job_id': job_id}" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="job_id" column_invisible="1"/>
                                        <field name="date" required="1"/>
                                        <field name="breakfast_cti_id" options="{'no_create': True,'no_open': True}"/>
                                        <field name="lunch_cti_id" options="{'no_create': True,'no_open': True}"/>
                                        <field name="dinner_cti_id" options="{'no_create': True,'no_open': True}"/>
                                        <field name="breakfast_amount" readonly="1" force_save="1" string="Desayuno" sum="Total Desayuno"/>
                                        <field name="lunch_amount" readonly="1" force_save="1" string="Almuerzo" sum="Total Almuerzo"/>
                                        <field name="dinner_amount" readonly="1" force_save="1" string="Cena" sum="Total Cena"/>
                                        <field name="transport_amount" sum="Total Transporte"/>
                                        <field name="tax_amount" sum="Total Impuestos"/>
                                        <field name="parking_amount" sum="Total Parqueo"/>
                                        <field name="purchase_amount" sum="Total Compras"/>
                                        <field name="others_amount" sum="Total Otros"/>
                                        <field name="total_amount" readonly="1" force_save="1" sum="Total Dia"/>
                                    </list>
                                </field>
                            </page>
                            <page name="expenses" string="Gastos" invisible="state in ['draft','required','approved','canceled']">
                                <field name="expenses_ids" context="{'default_employee_id': employee_id,'default_reason_expense': reason_expense, 'default_process_id': process_id}" readonly="state in ['pending','finalized','canceled']">
                                    <list>
                                        <field name="name" />
                                        <field name="date" />
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <field name="observations" placeholder="Observaciones y Justificaciones" readonly="state != 'draft'"/>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="expenses_request_tree_view" model="ir.ui.view">
            <field name="name">Solicitud de viaticos</field>
            <field name="model">cm.expenses.request</field>
            <field name="arch" type="xml">
                <list string="Solicitud de viaticos">
                    <field name="name"/>
                    <field name="employee_id" />
                    <field name="date"/>
                    <field name="purpose"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

