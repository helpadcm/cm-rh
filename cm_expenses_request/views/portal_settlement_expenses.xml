<odoo>
    <template id="portal_settlement_expense" name="Ingreso de Horas">
        <t t-call="portal.portal_layout">
            <div class="tab-content">
                <div class="container tab-pane fade show active" id="tab1" style="background-color: #F5F5F5;border-radius:10px">
                    <div class="card border-warning shadow-sm mt-4"
                        style="display: none;"
                        id="message_not_request_id">

                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <div class="me-3">
                                    <i class="fa fa-info-circle fa-3x text-warning"></i>
                                </div>

                                <div>
                                    <h5 class="mb-1">
                                        Información
                                    </h5>

                                    <span id="id_message_form"
                                        t-esc="message_form"/>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div style="display: none;" id="form_view_id">
                        <div class="text-center py-4 mb-4 border-bottom">
                            <h1 class="display-6 fw-bold">
                                <i class="fa fa-money me-1"></i>
                                Liquidacion de Viaticos
                            </h1>

                            <p class="lead text-muted">
                                Ingrese los gastos realizados.
                            </p>
                        </div>

                        <div t-if="request.session.get('flash_message')" id="popupNotification" class="popup">
                            <div t-attf-class="alert #{request.session.get('flash_message_type', 'alert-info')}">
                                <t t-esc="request.session.pop('flash_message')"/>
                            </div>
                        </div>

                        <form action="/create_expense/submit" method="POST" class="mt-4" enctype="multipart/form-data">
                            <input type="text" class="d-none" name="show_form" id="id_show_form" t-att-value="show_form"/>
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="text" class="d-none" name="request_id" id="id_request_id" t-att-value="request_id"/>
                            <div class="card shadow expense-card border-0">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-align-left"></i>
                                        Datos de solicitud
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-file-text-o"></i>
                                                Asignado a
                                            </label>
                                            <input
                                                class="form-control"
                                                type="text"
                                                name="assign_to"
                                                id="assign_to_id"
                                                disabled="disabled"
                                                t-att-value="assign_to"/>
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-align-left"></i>
                                                Proposito
                                            </label>
                                            <input
                                                class="form-control"
                                                type="text"
                                                name="purpose"
                                                id="purpose_id"
                                                t-att-value="purpose"
                                                disabled="disabled"/>
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-money me-1"></i>
                                                Monto Asignado
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">L</span>
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    name="amount_assign"
                                                    disabled="disabled"
                                                    t-att-value="amount_assign"
                                                    required="required"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card shadow expense-card border-0">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-money me-2"></i>
                                        Registro de Gastos
                                    </h5>
                                </div>

                                <div class="card-body">

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-calendar me-1"></i>
                                                Fecha
                                            </label>
                                            <input
                                                class="form-control"
                                                type="date"
                                                name="date_record"
                                                id="date_record"
                                                required="required"/>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-tags me-1"></i>
                                                Categoria de Gasto
                                            </label>
                                            <select
                                                class="form-select"
                                                name="selection_expense_category"
                                                id="type_category"
                                                required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="expenses_categories" t-as="types">
                                                    <option t-att-value="types.id">
                                                        <t t-esc="types.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-file-text-o"></i>
                                                Número de Factura
                                            </label>
                                            <input
                                                class="form-control"
                                                type="text"
                                                pattern="[0-9]{3}-[0-9]{3}-[0-9]{2}-[0-9]{8}"
                                                name="invoice_record"
                                                id="invoice_number_record"
                                                required="required"/>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-align-left"></i>
                                                Descripción del gasto
                                            </label>
                                            <input
                                                class="form-control"
                                                type="text"
                                                name="description_record"
                                                id="expense_description_record"
                                                required="required"/>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-money me-1"></i>
                                                Monto
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">L</span>
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    name="amount"
                                                    min="0"
                                                    step="0.01"
                                                    placeholder="0.00"
                                                    required="required"/>
                                            </div>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-money me-1"></i>
                                                Monto Exento
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">L</span>
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    name="exempt_amount"
                                                    min="0"
                                                    step="0.01"
                                                    placeholder="0.00"/>
                                            </div>
                                        </div>

                                        <div t-if="infavor_employee_amount == 0" class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-money me-1"></i>
                                                Saldo en control del empleado
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">L</span>
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    name="amount_balance"
                                                    min="0"
                                                    step="0.01"
                                                    placeholder="0.00"
                                                    disabled="disabled"
                                                    t-att-value="balance_employee_amount"/>
                                            </div>
                                        </div>

                                        <div t-if="infavor_employee_amount > 0" class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-money me-1"></i>
                                                Saldo a favor del empleado
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">L</span>
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    name="infavor_amount"
                                                    min="0"
                                                    step="0.01"
                                                    placeholder="0.00"
                                                    disabled="disabled"
                                                    t-att-value="infavor_employee_amount"/>
                                            </div>
                                        </div>

                                        <div class="col-12 mb-3" id="adjuntos_div">
                                            <div style="background-color:#FFFFFF" class="d-inline-flex align-items-center border rounded px-3 py-2">
                                                <label class="fw-bold mb-0 me-4 fw-semibold text-secondary">
                                                    <i class="fa fa-times me-2"></i>
                                                    Sin Impuestos
                                                </label>
                                                <div class="form-check form-switch mb-0">
                                                    <input
                                                        class="form-check-input"
                                                        type="checkbox"
                                                        name="no_taxes"
                                                        id="no_taxes_id"/>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Adjuntar Archivos (Obligatorio)</label>
                                                <input type="file" required="required" name="rec_expenses_attachments" id="expense_attachments" multiple="true" class="form-control" accept="image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                                                <small class="form-text text-muted">Formatos permitidos: imágenes, PDF, Word, Excel.</small>
                                            </div>
                                        </div>

                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-sticky-note me-1"></i>
                                                Notas
                                            </label>
                                            <textarea
                                                name="record_notes"
                                                class="form-control"
                                                id="notes"
                                                rows="3"
                                                placeholder="Ingrese una descripción del gasto..."></textarea>
                                        </div>

                                        <div class="col-12 text-end">
                                            <t t-if="balance_employee_amount != 0">
                                                <button
                                                    type="submit"
                                                    name="action"
                                                    value="save"
                                                    class="btn btn-primary me-2">
                                                    Registrar Gasto
                                                </button>
                                            </t>

                                            <t t-if="balance_employee_amount != 0">
                                                <button
                                                    type="button"
                                                    class="btn btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#expenseModal">
                                                    <i class="fa fa-plus me-1"></i>
                                                    Depositar Sobrante
                                                </button>
                                            </t>

                                            <t t-if="balance_employee_amount == 0 and infavor_employee_amount == 0">
                                                <button
                                                    type="button"
                                                    class="btn btn-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#confirmFinishModal">
                                                    <i class="fa fa-check-circle me-1"></i>
                                                    Finalizar Liquidación
                                                </button>
                                            </t>

                                            <t t-if="infavor_employee_amount > 0">
                                                <button
                                                    type="button"
                                                    class="btn btn-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#expenseRefund">
                                                    <i class="fa fa-check-circle me-1"></i>
                                                    Solicitar Reembolso
                                                </button>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <div t-if="len(expenses_data) > 0" class="card mt-4 shadow-sm border-0">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <i class="fa fa-list me-2"></i>
                                    Gastos Registrados
                                </h5>
                            </div>

                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover" id="expenses_table">
                                        <thead>
                                            <tr>
                                                <th>Descripción</th>
                                                <th>Factura/Deposito</th>
                                                <th>Categoria</th>
                                                <th>Fecha de gasto/Deposito</th>
                                                <th>Monto</th>
                                                <th>Comprobante</th>
                                                <!-- <th width="100">Acciones</th> -->
                                            </tr>
                                        </thead>
                                        <t t-set="total" t-value="0.00"/>
                                        <tbody id="expenses_table_body">
                                            <t t-foreach="expenses_data" t-as="expense">
                                                <tr>
                                                    <td><t t-esc="expense.get('name')"/></td>
                                                    <td><t t-esc="expense.get('invoice_number')"/></td>
                                                    <td><t t-esc="expense.get('category')"/></td>
                                                    <td><t t-esc="expense.get('date')"/></td>
                                                    <td>L. <t t-esc="'{0:,.2f}'.format(expense.get('amount'))"/></td>
                                                    <td class="text-center">
                                                        <t t-if="expense.get('att_created')">
                                                            <i class="fa fa-check-circle text-success"/>
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-times-circle text-danger"/>
                                                        </t>
                                                    </td>
                                                    <td t-if="expense.get('category') != 'Deposito'">
                                                        <button
                                                            type="button"
                                                            class="btn btn-danger btn-sm"
                                                            data-bs-toggle="modal"
                                                            t-att-data-bs-target="'#deleteExpenseModal%s' % expense.get('id')">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </td>
                                                    <t t-set="total" t-value="total + expense.get('amount')"/>
                                                </tr>
                                                <div class="modal fade"
                                                    t-att-id="'deleteExpenseModal%s' % expense.get('id')"
                                                    tabindex="-1">

                                                    <div class="modal-dialog modal-dialog-centered">

                                                        <div class="modal-content">

                                                            <div class="modal-header bg-danger text-white">
                                                                <h5 class="modal-title">
                                                                    Confirmar eliminación
                                                                </h5>
                                                            </div>

                                                            <div class="modal-body">
                                                                ¿Está seguro de eliminar este gasto?
                                                            </div>

                                                            <div class="modal-footer">

                                                                <button type="button"
                                                                        class="btn btn-secondary"
                                                                        data-bs-dismiss="modal">
                                                                    Cancelar
                                                                </button>

                                                                <form action="/delete_expense_line"
                                                                    method="POST">

                                                                    <input type="hidden"
                                                                        name="csrf_token"
                                                                        t-att-value="request.csrf_token()"/>

                                                                    <input type="hidden"
                                                                        name="expense_line_id"
                                                                        t-att-value="expense.get('id')"/>

                                                                    <button type="submit"
                                                                            class="btn btn-danger">
                                                                        Eliminar
                                                                    </button>

                                                                </form>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>
                                            </t>
                                        </tbody>

                                        <tfoot>
                                            <tr>
                                                <th colspan="4" class="text-end">
                                                    TOTAL:
                                                </th>
                                                <th id="total_amount">
                                                    L. <t t-esc="'{0:,.2f}'.format(total)"/>
                                                </th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="expenseRefund" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Solicitar reembolso a favor del empleado
                                    </h5>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                    </button>
                                </div>
                                <form action="/refund_expense_amount" method="POST">
                                    <input type="text" class="d-none" name="request_id" id="id_request_id" t-att-value="request_id"/>
                                    <input type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"/>

                                    <div class="modal-body">

                                        <div class="row">

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold">
                                                    <i class="fa fa-tags me-1"></i>
                                                    Motivo
                                                </label>
                                                <select
                                                    class="form-select"
                                                    name="selection_refund_expense"
                                                    id="refund_expense"
                                                    required="required">
                                                    <option value="">Seleccione una opción</option>
                                                    <t t-foreach="exceptional_reason_ids" t-as="types">
                                                        <option t-att-value="types.id">
                                                            <t t-esc="types.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold">
                                                    <i class="fa fa-align-left"></i>
                                                    Explicacion
                                                </label>
                                                <input type="text"
                                                    class="form-control"
                                                    name="description_refund"/>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="modal-footer">

                                        <button
                                            type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                            Cancelar
                                        </button>

                                        <button
                                            type="submit"
                                            class="btn btn-primary">
                                            Enviar
                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                    <div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Depositar sobrante
                                    </h5>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                    </button>
                                </div>
                                <form action="/create_expense_deposit" method="POST" enctype="multipart/form-data">
                                    <input type="text" class="d-none" name="request_id" id="id_request_id" t-att-value="request_id"/>
                                    <input type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"/>

                                    <div class="modal-body">

                                        <div class="row">

                                            <div class="col-md-6 mb-3">
                                                <label>Fecha</label>
                                                <input type="date"
                                                    class="form-control"
                                                    name="date_record"
                                                    required="required"/>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label>Voucher</label>
                                                <input type="text"
                                                    class="form-control"
                                                    name="voucher_number_record"
                                                    required="required"/>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label>Monto</label>
                                                <input type="number"
                                                    step="0.01"
                                                    class="form-control"
                                                    name="amount_balance"
                                                    t-att-value="balance_employee_amount"
                                                    readonly="readonly"/>
                                            </div>

                                            <div class="col-6 mb-3" id="adjuntos_dep_div">
                                                <div class="mb-3">
                                                    <label class="form-label">Adjuntar Comprobante (Obligatorio)</label>
                                                    <input type="file" name="rec_deposit_attachments" required="required" id="deposit_attachments" multiple="true" class="form-control" accept="image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                                                    <small class="form-text text-muted">Formatos permitidos: imágenes, PDF, Word, Excel.</small>
                                                </div>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="modal-footer">

                                        <button
                                            type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                            Cancelar
                                        </button>

                                        <button
                                            type="submit"
                                            class="btn btn-primary">
                                            Depositar
                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                    <div class="modal fade"
                        id="confirmFinishModal"
                        tabindex="-1"
                        aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">

                            <div class="modal-content">

                                <div class="modal-header bg-warning">
                                    <h5 class="modal-title">
                                        <i class="fa fa-exclamation-triangle me-2"></i>
                                        Confirmar Finalización
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <div class="modal-body text-center">

                                    <i class="fa fa-question-circle fa-3x text-warning mb-3"></i>

                                    <h5>
                                        ¿Está seguro de que desea finalizar la liquidación?
                                    </h5>

                                    <p class="text-muted mb-0">
                                        Una vez finalizada, no podrá agregar más gastos a esta solicitud.
                                    </p>

                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancelar
                                    </button>

                                    <form action="/finalize_expense_request"
                                        method="POST">
                                        <input type="text" class="d-none" name="request_id" id="id_request_id" t-att-value="request_id"/>

                                        <input type="hidden"
                                            name="csrf_token"
                                            t-att-value="request.csrf_token()"/>

                                        <input type="hidden"
                                            name="request_id"
                                            t-att-value="request_id"/>

                                        <button type="submit"
                                                class="btn btn-success">
                                            <i class="fa fa-check me-1"></i>
                                            Sí, Finalizar
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </div>


            <!-- JavaScript para el popup -->
            <script>
                // Esperar a que el documento esté completamente cargado
                document.addEventListener("DOMContentLoaded", function() {
                    var popup = document.getElementById("popupNotification");
                    if (popup) {
                        // Mostrar el popup
                        popup.style.display = "block";
                        // Ocultar el popup después de 5 segundos (por ejemplo)
                        setTimeout(function() {
                            popup.style.display = "none";
                        }, 5000); // 5000ms = 5 segundos
                    }
                });
            </script>

            <!-- Estilo del popup -->
            <style>
                .popup {
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    background-color: #f8d7da;
                    color: #721c24;
                    border: 1px solid #f5c6cb;
                    padding: 10px 20px;
                    border-radius: 5px;
                    z-index: 9999;
                    display: none;  /* Inicialmente oculto */
                }

                .popup .alert {
                    margin: 0;
                }

                .header_historical{
                    font-size: 13px !important;
                    background-color: #008000 !important;
                    color: #FFFFFF !important;
                }

                .historical_table tbody tr:hover{
                    background-color: #ABEBC6 !important;
                    transition: background 0.3s;
                }
            </style>
        </t>
    </template>
</odoo>