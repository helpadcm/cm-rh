<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
<!-- ######################################  EXPENSES REQUEST ############################################## -->
		<record model="ir.module.category" id="cm_expenses_request_category">
			<field name="name">Solicitud de Viaticos</field>
			<field name="description">Solicitud de Viaticos</field>
			<field name="sequence">21</field>
		</record>

		<record id="group_expenses_request_user" model="res.groups">
			<field name="name">Usuario de Solicitudes</field>
			<field name="category_id" ref="cm_expenses_request_category"/>
		</record>

		<record id="group_expenses_request_boss" model="res.groups">
			<field name="name">Aprobador de Solicitudes</field>
			<field name="category_id" ref="cm_expenses_request_category"/>
		</record>

        <record id="group_expenses_request_purchase" model="res.groups">
			<field name="name">Encargado de asignaciones</field>
			<field name="category_id" ref="cm_expenses_request_category"/>
		</record>

		<record id="group_expenses_request_manager" model="res.groups">
			<field name="name">Administrador de Solicitudes</field>
			<field name="category_id" ref="cm_expenses_request_category"/>
		</record>

<!-- #############################  EXPENSES REQUEST RULE  ########################################## -->

        <record id="user_expenses_request_rule" model="ir.rule">
            <field name="name">Usuario Solicitudes de viaticos</field>
            <field name="model_id" ref="cm_expenses_request.model_cm_expenses_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cm_expenses_request.group_expenses_request_user'))]"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="boss_expenses_request_rule" model="ir.rule">
            <field name="name">Aprobador de  Solicitudes de viaticos</field>
            <field name="model_id" ref="cm_expenses_request.model_cm_expenses_request"/>
            <field name="domain_force">['|',('employee_id.user_id', '=', user.id),('boss_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cm_expenses_request.group_expenses_request_boss'))]"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_read" eval="True"/>
        </record>

		<record id="manager_expenses_request_rule" model="ir.rule">
            <field name="name">Administrador Solicitudes de Viaticos</field>
            <field name="model_id" ref="cm_expenses_request.model_cm_expenses_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_expenses_request.group_expenses_request_manager')),(4, ref('cm_expenses_request.group_expenses_request_purchase'))]"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_read" eval="True"/>
        </record>

	</data>
</odoo>



