<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_deposit_expenses" model="ir.ui.view">
        <field name="name">hr.deposit.expenses.form</field>
        <field name="model">hr.deposit.expenses</field>
        <field name="arch" type="xml">
            <form string="Deposito de reembolso">
                <sheet>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="journal_id" domain="[('type','in',['bank'])]" options="{'no_create': True}" required="1"/>
                            <field name="account_id" invisible="1"/>
                            <field name="voucher_number" required="1"/>
                            <field name="voucher" filename="voucher_filename" required="1"/>
                            <field name="voucher_filename" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Depositar" type="object" name="create_deposit" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="deposit_expenses_action" model="ir.actions.act_window">
        <field name="name">Depositar reembolso</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.deposit.expenses</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
