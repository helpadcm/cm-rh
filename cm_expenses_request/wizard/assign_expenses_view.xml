<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_assign_expenses" model="ir.ui.view">
        <field name="name">hr.assign.expenses.form</field>
        <field name="model">hr.assign.expenses</field>
        <field name="arch" type="xml">
            <form string="Asignar Viaticos">
                <sheet>
                    <group>
                        <group>
                            <field name="date" required="1"/>
                            <field name="account_id" options="{'no_create': True}" required="1"/>
                            <field name="currency_id" invisible="1" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="journal_id" domain="[('id', 'in', available_journal_ids)]" options="{'no_create': True}" required="1"/>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="description" required="1"/>
                            <field name="available_journal_ids" invisible="1" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Asignar Monto" type="object" name="create_debit" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="assign_expenses_action" model="ir.actions.act_window">
        <field name="name">Asignar</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.assign.expenses</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
