<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_exeptional_reason" model="ir.ui.view">
        <field name="name">Motivo Excepcional</field>
        <field name="model">expense.exeption.reason</field>
        <field name="arch" type="xml">
            <form string="Motivo Excepcional">
                <sheet>
                    <group>
                        <field name="exeption_id" required="1" options="{'no_create': True}"/>
                        <field name="description" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button string="Enviar" type="object" name="request_exeption" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="exeptional_reason_action" model="ir.actions.act_window">
        <field name="name">Motivo Excepcional</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">expense.exeption.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
