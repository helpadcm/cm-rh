<?xml version="1.0" encoding="utf-8"?>
<odoo>		
    <data>
        <record id="action_statement_odoo_object" model="ir.actions.act_window">
            <field name="name">Sale Statement Odoo</field>
            <field name="res_model">sale.statement_odoo</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'target':'current'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Statement Odoo
                </p>
            </field>
        </record>

        <record id="statement_odoo_form_view" model="ir.ui.view">
            <field name="name">sale.statement_odoo.form.view</field>
            <field name="model">sale.statement_odoo</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Sale Statement Odoo" create='false' delete='false' edit="false" editable='top'>
                    <header> 
                        <button name="do_cancel" type="object" class="oe_highlight" string="Cancel" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,done" statusbar_colors="{'cancel':'red','done':'blue'}"/>
                    </header>
                    <sheet>
                        <group>
                            <group col="4" colspan="4" >
                                <field name="name" readonly="state != 'draft'"/>
                                <field name="rtn" readonly="state != 'draft'"/>
                                <field name="invoice" readonly="1"/>
                            </group>
                            <group col="4" colspan="4" >
                                <field name="partner_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            
                                <field name="SaleStatementDateAndHourLT" readonly="1"/>
                                <field name="StatementTypeID" readonly="1"  options="{'no_create': True, 'no_open': True}"/>
                                <field name="StatementTypeID2" readonly="1" groups="cm_sales.group_ws_sale_manager"/>
                                <field name="PNRCode" readonly="1"/>
                                <field name="PNRID" readonly="1"/>
                                <field name="RecordStatement" readonly="1"/>
                            </group>
                            <group col="4" colspan="4" >
                                <field name="PointOfSaleID" readonly="1"  options="{'no_create': True, 'no_open': True}"/>
                                <field name="PointOfSaleID2" groups="cm_sales.group_ws_sale_manager" readonly="1"/>
                                <field name="PassengerType" readonly="1"/>
                                <field name="CustomerName" readonly="1"/>
                                <field name="PaymentMode" readonly="1"/>
                                <field name="SaleCurrency" readonly="1"/>
                                <field name="currency_id" readonly="1"  options="{'no_create': True, 'no_open': True}"/>
                                <field name="BaseCurrencyAmount" readonly="1"/>
                                <field name="BaseCurrencyAmountWithoutTaxes" readonly="1"/>
                                <field name="BaseCurrencyTaxAmount" readonly="1"/>
                                <field name="value" readonly="1"/>
                            </group>
                            <group col="4" colspan="4" >
                                <field name="AgentID" readonly="1"  options="{'no_create': True, 'no_open': True}"/>
                                <field name="AgentID2" groups="cm_sales.group_ws_sale_manager" readonly="1"/>
                                <field name="OriginalTicketNumber" readonly="1"/>
                                <field name="TicketNumber" readonly="1"/>
                                <field name="CustomerID" readonly="1"/>
                                <field name="TripType" readonly="1"/>
                                <field name="FHAmount" readonly="1"/>
                                <field name="HNAmount" readonly="1"/>
                                <field name="YQAmount" readonly="1"/>
                                <field name="TAAmount" readonly="1"/>
                                <field name="YRAmount" readonly="1"/>
                                <field name="TIAmount" readonly="1"/>
                                <field name="TDAmount" readonly="1"/>
                                <field name="YZAmount" readonly="1"/>
                                <field name="SaleStatementID" invisible="1" readonly="1"/>
                            </group>
                        </group>
                    </sheet> 
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

