        <record id="statement_odoo_tree_view" model="ir.ui.view">
            <field name="name">sale.statement_odoo.tree.view</field>
            <field name="model">sale.statement_odoo</field>
            <field name="arch" type="xml">
                <tree create='false' delete='false'  editable="bottom">
                    <field name="PNRCode" readonly="1"/>
                    <field name="SaleStatementID" groups="base.group_no_one"/>
                    <field name="AgentID" groups="base.group_no_one"/>
        
                    <field name="CustomerName" readonly="1"/>
                    <field name="StatementTypeID" readonly="1"/>
                    <field name="SaleStatementDateAndHourLT" readonly="1"/>
                    <field name="RecordStatement" readonly="1" column_invisible="1"/>
                    <field name="BaseCurrencyAmount" sum="1" readonly="1"/>
                    <field name="find_value" column_invisible="1"/>
                    <field name="value" readonly="1" sum="1" invisible="find_value == False"/>
                    <field name="is_diff" column_invisible="1"/>
                    <field name="diff_value" readonly="1" sum="Total" invisible="is_diff == False"/>
                    
                    <field name="SaleCurrency" readonly="1"/>
                    <field name="name" readonly="1"/>
                    <field name="rtn" readonly="1"/>
                    <field name="invoice" readonly="state != 'draft'"/>
                    <button name="do_minus" type="object" icon="fa-pencil" class="oe_inline" title="Editar"/>
                    <field name="state" readonly="1"/>
                    <button name="show_details" string="Show" type="object" icon="fa-plus-square"   />
                </tree>
            </field>
        </record>

