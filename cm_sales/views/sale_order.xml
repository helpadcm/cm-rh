<?xml version="1.0" encoding="utf-8"?>
<odoo>		
    <data>
        <record id="cm_sale_form_view" model="ir.ui.view">
            <field name="name">cm.web.sale_order.form.view</field>
            <field name="model">cm.web.sale_order</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="CM Sale"  class="oe_form_configuration">
                    <header>
                        <button string="check in" type="object" name="invoice" class="oe_highlight"/>
                        <button string="Cancel" type="object" name="cancel_order" class="oe_link"/>
                        <button string="Re Invoice" type="object" name="reinvoice" groups="cm_sales.group_ws_sale_manager"/>
                        <button string="Cancelar Facturas" type="object" name="cancel_invoice" groups="base.group_no_one"/>
                    </header>
                    <sheet>
                        <table>
                            <tr>
                                <td>
                                    <label for="pnr"/>
                                    <field name="pnr"/>
                                </td>
                                <td style="padding-left: 50px">
                                    <button name="post_ws" type="object" string="Verify" class="oe_highlight"/>
                                </td>
                                <td style="padding-left: 50px">
                                    <label for="pnr_ids"/>
                                    <field name="pnr_ids" groups="base.group_no_one"/>
                                </td>
                                <td style="padding-left: 50px">
                                    <button name="charge_local" type="object" string="Verify" class="oe_highlight" groups="base.group_no_one"/>
                                </td>
                            </tr>
                        </table>
                        <separator/>
                        <group>
                            <group>
                                <field name="date_start" groups="cm_sales.group_ws_sale_manager"/> 
                            </group>
                            <group>
                                <field name="date_end" groups="cm_sales.group_ws_sale_manager"/>
                            </group>
                        </group>
                        <label for="salestatement_ids">Sales Statements</label>
                        <field name="salestatement_ids" widget="many2many" context="{'target':'new'}"/>
                        <label for="cashstatement_ids">Cash Statements</label>
                        <field name="cashstatement_ids" widget="many2many" />
                    <button name="post_ws" type="object" string="Today" class="oe_inline" context="{'today':True}" groups="cm_sales.group_ws_sale_manager"/>
                    </sheet>
                    <div class="oe_chatter" invisible="1">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" invisible="1"/>
                        <field name="message_ids" widget="mail_thread" invisible="1"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_cm_sale_object" model="ir.actions.act_window">
            <field name="name">Ws Sale</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cm.web.sale_order</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
        </record>
    </data>  
</odoo>
