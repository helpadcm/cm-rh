<?xml version="1.0" encoding="utf-8"?>
<odoo>		
    <data>
        <record id="action_cashstatement_odoo_object" model="ir.actions.act_window">
            <field name="name">Cash Statement Odoo</field>
            <field name="res_model">sale.cashstatement_odoo</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Statement Odoo
                </p>
            </field>
        </record>

        <record id="cashstatement_odoo_form_view" model="ir.ui.view">
            <field name="name">sale.cashstatement_odoo.form.view</field>
            <field name="model">sale.cashstatement_odoo</field>
            
            <field name="arch" type="xml">
                <form string="Sale cashStatement Odoo" create='false' delete='false' edit="false" editable='top'>
                    <header>
                        <field name="state" widget="statusbar" nolabel="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group col="4" colspan="4" >
                                <field name="invoice" readonly="state != 'draft'"/>
                            </group>
                            <group col="4" colspan="4" >
                                
                                <field name="partner_id" readonly="1"  groups="cm_sales.group_ws_sale_manager"/>
                                <field name="CashStatementDateAndHourLT" readonly="1"/>
                                <field name="PointOfSaleID" readonly="1"/>
                                <field name="PointOfSaleID2" groups="cm_sales.group_ws_sale_manager" readonly="1"/>
                                <field name="PNRID" readonly="1"/>
                                <field name="PNRCode" readonly="1"/>
                                <field name="RecordReferenceNumber" readonly="1"/>
                                
                                
                            </group>
                            <group col="4" colspan="4" >
                                <field name="AgentID" readonly="1"/>
                                <field name="AgentID2" groups="cm_sales.group_ws_sale_manager" readonly="1"/>
                                <field name="FormOfPaymentID" readonly="1"/>
                                <field name="FormOfPaymentID2" groups="cm_sales.group_ws_sale_manager" readonly="1"/>
                                <field name="BaseCurrencyAmount" readonly="1"/>
                                <field name="residual" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="BaseCurrency" readonly="1"/>
                                <field name="CustomerID" readonly="1"/>
                                <field name="CashStatementID" invisible="1" readonly="1"/>
                                <field name="RecordStatement" readonly="1"/>
                            </group>
                        </group>
                    </sheet> 
                </form>
            </field>
        </record>

        <record id="cashstatement_odoo_tree_view" model="ir.ui.view">
            <field name="name">sale.cashstatement_odoo.tree.view</field>
            <field name="model">sale.cashstatement_odoo</field>
            <field name="arch" type="xml">
                <tree create='false' delete='false' editable='bottom'>
                    <field name="PNRCode" readonly="1"/>
                    <field name="CustomerID" invisible="1" readonly="1"/>
                    <field name="CashStatementID" groups="base.group_no_one"/>
                    <field name="AgentID" groups="base.group_no_one"/>
                    <field name="partner_id" readonly="1" invisible="1"/>
                
                    
                    <field name="CashStatementDateAndHourLT" readonly="1"/>
                    <field name="RecordStatement" readonly="1"/>
                    <field name="BaseCurrencyAmount" sum="1" readonly="1"/>
                    <field name="currency_id" readonly="1"/>
                    <field name="BaseCurrency" readonly="1"/>
                    <field name="invoice" readonly="state != 'draft'"/>
                    <button name="do_minus" type="object"  icon="fa-pencil" class="oe_inline" title="Editar"/>
                    <field name="state" readonly="1"/>
                    <button name="show_details" string="Show" type="object"  icon="fa-plus-square" />
                </tree>
            </field>
        </record>

