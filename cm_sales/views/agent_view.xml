<?xml version="1.0" encoding="utf-8"?>
<odoo>		
    <data>
        <record id="action_agent_odoo_object" model="ir.actions.act_window">
            <field name="name">agent</field>
            <field name="res_model">sale.agent</field>
            <field name="view_mode">tree</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create agent Odoo
                </p>
            </field>
        </record>

        <record id="agent_odoo_tree_view" model="ir.ui.view">
            <field name="name">sale.agent.tree.view</field>
            <field name="model">sale.agent</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="lname"/>
                    <field name="user_id"/>
                    <field name="equivalence"/>
                </tree>
            </field>
        </record>
    </data>  
</odoo>
