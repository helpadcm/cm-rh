<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_payment_view_inherit_form_general" model="ir.ui.view">
            <field name="name">account.payment.view.inherit_form_general</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">                
                <field name="payment_type" position='before'>   
                    <field name="user_id" readonly='1'/>
                </field>

                <field name='journal_id' position='attributes'> 
                    <attribute name="domain">[('id','in',available_journal_ids),('user_ids','=',uid)]</attribute>
                </field>
            </field>
        </record>

        <record id="account_payment_view_inherit_search" model="ir.ui.view">
            <field name="name">account.payment.view.inherit_search</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search" />
            <field name="arch" type="xml">                
                <field name="journal_id" position='after'>   
                    <field name='date'/>                 
                    <field name="user_id"/>
                    <field name="nro_auto" />
                    <field name="card_digits" />
                </field>
                <filter name="journal" position="after">
                    <filter string='Usuario' name="user_group" context="{'group_by':'user_id'}"/>
                </filter>
            </field>
        </record>


        <record id="account_payment_view_inherit_tree" model="ir.ui.view">
            <field name="name">account.payment.view.inherit_tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree" />
            <field name="arch" type="xml">
                <field name="payment_method_line_id" position='replace'>
                    <!-- <field name="cash_register_id" /> -->
                    <field name="partner_type" column_invisible="True"/>
                </field>
                <field name="date" position='before'>
                    <field name="user_id"/>
                </field>
                <field name="journal_id" position='after'>
                    <field name="card_digits" />
                    <field name="nro_auto" />
                </field>
            </field>
        </record>
    </data>
</odoo>
