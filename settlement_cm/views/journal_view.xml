<odoo>
	<data>
        <record id="journal_inherit_form_view" model="ir.ui.view">
		    <field name="name">Journal form</field>
		    <field name="model">account.journal</field>
	        <field name="inherit_id" ref="account.view_account_journal_form"/>
		    <field name="arch" type="xml">
                <field name='sequence_id' position='after'>
                    <field name="valid_for_cash_register" />
                    <field name="valid_for_payments" />
                    <field name="request_card_data" />
                    <field name="user_ids" widget="many2many_tags" options="{'no_quick_create':True,'no_create_edit':True}" invisible="valid_for_payments == False"/>          
                </field>
            </field>
        </record>
    </data>        
</odoo>   