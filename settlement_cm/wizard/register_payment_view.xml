<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_payment_view_inherit2" model="ir.ui.view">
            <field name="name">account.payment.view.inherit2</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form" />
            <field name="arch" type="xml">
                <field name="payment_method_line_id" position='attributes' >
                    <attribute name="invisible">partner_type == 'customer'</attribute>
                </field>
                
                <field name='journal_id' position='attributes'> 
                    <attribute name="domain">[('valid_for_payments','=',True),('user_ids','=',uid)]</attribute>
                </field>

                <field name='journal_id' position='before'>
                    <field name='user_id' readonly='1'/>
                </field>

                <group name='group3' position='before'>
                    <group name="group4" invisible="request_card_data == False" string="Datos Tarjeta">
                        <field name='type' invisible='1'/>
                        <field name="request_card_data" invisible='1'/>
                        <field name='nro_auto' invisible="request_card_data != True" required="request_card_data == True"/>
                        <field name='card_digits' invisible="request_card_data != True" required="request_card_data == True"/>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
