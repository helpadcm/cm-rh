<odoo>
    <template id="portal_program_to_fly" name="Programa a volar">
        <t t-call="portal.portal_layout">
            <ul class="nav nav-pills nav-fill mb-4 shadow-sm p-2 bg-white rounded">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#tab1">
                        <i class="fa fa-plane me-1"></i>
                        Solicitar Boletos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab2">
                        <i class="fa fa-users me-1"></i>
                        Beneficiarios
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab3">
                        <i class="fa fa-history me-1"></i>
                        Historial
                    </a>
                </li>
            </ul>

            <div class="tab-content" style="background: rgba(255,255,255,0.7);border-radius:10px;">
                <div class="container tab-pane fade show active" id="tab1">

                    <div class="text-center py-4 mb-4 border-bottom">
                        <h1 class="display-6 fw-bold text-primary">
                            <i class="fa fa-plane me-2"></i>
                            Solicitud de Boletos
                        </h1>

                        <p class="lead text-muted mb-0">
                            Solicite boletos para usted y sus beneficiarios registrados.
                        </p>
                    </div>

                    <div t-if="request.session.get('flash_message')" id="popupNotification" class="popup">
                        <div t-attf-class="alert #{request.session.get('flash_message_type', 'alert-info')}">
                            <t t-esc="request.session.pop('flash_message')"/>
                        </div>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-6">
                            <form action="/request_tickets/submit" method="POST" class="mt-2" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="card shadow border-0">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">
                                            <i class="fa fa-ticket me-2"></i>
                                            Registro de Solicitud
                                        </h5>
                                    </div>

                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary">
                                                        <i class="fa fa-tags me-1"></i>
                                                        Tipo de Boleto
                                                    </label>
                                                    <select class="form-control" name="selection_absence_type" id="absence_type" required="required">
                                                        <t t-foreach="types_absences_ids" t-as="type">
                                                            <option t-att-value="type.id" t-att-data-opt-code="type.code"><t t-esc="type.name"/></option>
                                                        </t>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-12" id="fly_div_id">
                                                <div class="card border-success shadow-sm mb-3">
                                                    <div class="card-body text-center">

                                                        <h6 class="text-success">
                                                            <i class="fa fa-plane me-1" aria-hidden="true"></i>
                                                            Boletos Disponibles
                                                        </h6>

                                                        <input type="text"
                                                            disabled="disabled"
                                                            class="form-control text-center fw-semibold text-secondary"
                                                            name="record_program_to_fly"
                                                            id="program_to_fly_id"
                                                            t-att-value="program_to_fly"/>

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-12" id="tickets_div_id">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary">
                                                        <i class="fa fa-ticket"></i>
                                                        Boletos a tomar
                                                    </label>
                                                    <input type="number" class="form-control" name="record_tickets" id="tickets" t-att-max="program_to_fly" min="1"/>
                                                </div>
                                            </div>

                                            <div class="col-12"  id="ben1">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 1
                                                </label>
                                                <select class="form-control" name="selection_beneficiary1" id="beneficiary1_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben2">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 2
                                                </label>
                                                <select class="form-control" name="selection_beneficiary2" id="beneficiary2_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben3">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 3
                                                </label>
                                                <select class="form-control" name="selection_beneficiary3" id="beneficiary3_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben4">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 4
                                                </label>
                                                <select class="form-control" name="selection_beneficiary4" id="beneficiary4_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben5">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 5
                                                </label>
                                                <select class="form-control" name="selection_beneficiary5" id="beneficiary5_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben6">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 6
                                                </label>
                                                <select class="form-control" name="selection_beneficiary6" id="beneficiary6_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben7">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 7
                                                </label>
                                                <select class="form-control" name="selection_beneficiary7" id="beneficiary7_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben8">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 8
                                                </label>
                                                <select class="form-control" name="selection_beneficiary8" id="beneficiary8_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12"  id="ben9">
                                                <label class="form-label fw-semibold text-secondary">
                                                    <i class="fa fa-users me-1"></i>
                                                    Beneficiario 9
                                                </label>
                                                <select class="form-control" name="selection_beneficiary9" id="beneficiary9_id" required="required">
                                                    <t t-foreach="beneficiaries_ids" t-as="ben">
                                                        <option t-att-value="ben.id"><t t-esc="ben.name"/></option>
                                                    </t>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input"
                                                        type="checkbox"
                                                        name="exit_only"
                                                        id="exit_only_id"/>

                                                    <label class="form-check-label">
                                                        Solo Ida
                                                    </label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input"
                                                        type="checkbox"
                                                        name="open_back"
                                                        id="open_back_id"/>

                                                    <label class="form-check-label">
                                                        Regreso Open
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary">
                                                        <i class="fa fa-map-marker me-1"></i>
                                                        Ruta de Ida
                                                    </label>
                                                    <select class="form-control" name="selection_exit_route" id="exit_route_id" required="required">
                                                        <t t-foreach="routes" t-as="exit">
                                                            <option t-att-value="exit.id"><t t-esc="exit.name"/></option>
                                                        </t>
                                                    </select>
                                                </div>
                                                <div class="mb-3" id="return_div_id">
                                                    <label class="form-label fw-semibold text-secondary">
                                                        <i class="fa fa-map-marker me-1"></i>
                                                        Ruta de Regreso
                                                    </label>
                                                    <select class="form-control" name="selection_return_route" id="return_route_id">
                                                        <t t-foreach="routes" t-as="return">
                                                            <option t-att-value="return.id"><t t-esc="return.name"/></option>
                                                        </t>
                                                    </select>
                                                </div>

                                                <div class="col-12">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-secondary">
                                                            <i class="fa fa-calendar me-1"></i>
                                                            Fecha Ida
                                                        </label>
                                                        <input class="form-control" type="date" name="initial_date" id="initial_date_id" required="required"/>
                                                    </div>
                                                </div>

                                                <div class="col-12" id="final_date_div">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-secondary">
                                                            <i class="fa fa-calendar me-1"></i>
                                                            Fecha de Regreso
                                                        </label>
                                                        <input class="form-control" type="date" name="final_date" id="final_date_id"/>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-secondary">
                                                            <i class="fa fa-sticky-note" aria-hidden="true"></i>
                                                            Notas
                                                        </label>
                                                        <input type="text" name="record_notes" class="form-control" id="notes"/>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-secondary">
                                                            <i class="fa fa-paperclip me-1"></i>
                                                            Adjuntar Documento
                                                        </label>
                                                        <input type="file" class="form-control" name="attachments" id="attachment_id" accept=".pdf,.jpg,.png,.doc,.docx" multiple="multiple"/>
                                                    </div>
                                                </div>

                                                <div class="col-12 text-center">
                                                    <button type="submit" class="btn btn-primary mt-3">Solicitar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="container tab-pane fade" id="tab2">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle historical_table">
                            <thead class="table-dark">
                                <tr>
                                    <th class="header_historical">Nombre</th>
                                    <th class="header_historical">Identidad</th>
                                    <th class="header_historical">Fecha de nacimiento</th>
                                    <th class="header_historical">Parentesco</th>
                                    <th class="header_historical">Observacion</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="beneficiaries_ids" t-as="beneficary">
                                    <tr>
                                        <td><t t-esc="beneficary.name"/></td>
                                        <td style="text-align:center"><t t-esc="beneficary.identity"/></td>
                                        <td style="text-align:center"><t t-esc="beneficary.birthday.strftime('%d/%m/%Y')"/></td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'mother'">Madre</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'father'">Padre</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'children'">Hijo(a)</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'siblings'">Hermano(a)</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'couple'">Pareja</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'grandparents'">Abuelo(a)</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'grandson'">Nieto(a)</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'other'">Otro</td>
                                        <td style="text-align:center" t-if="beneficary.relationship == 'employee'">Empleado</td>
                                        <td><t t-esc="beneficary.observation"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Crear Nuevo Beneficiario</label>
                        <input type="checkbox" class="form-check-input" name="create_beneficiary" id="create_benficiary_id"/>
                    </div>
                    <div id="beneficiaryForm" style="display: none;">
                        <div class="card shadow border-0 mt-4">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-user-plus me-2"></i>
                                    Crear Beneficiario
                                </h5>
                            </div>

                            <div class="card-body">
                                <form action="/create_beneficiary/submit" method="POST" class="mt-2">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <!-- <div class="card shadow border-0 mt-4"> -->
                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <label class="form-label fw-bold">
                                                    <i class="fa fa-font" aria-hidden="true"></i>
                                                    Nombre
                                                </label>
                                                <input
                                                    class="form-control"
                                                    type="text"
                                                    name="record_beneficiry_name"
                                                    id="beneficiary_name_id"
                                                    required="required"/>
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <label class="form-label fw-bold">
                                                    <i class="fa fa-font" aria-hidden="true"></i>
                                                    Identidad
                                                </label>
                                                <input
                                                    class="form-control"
                                                    type="text"
                                                    placeholder="Número de identidad sin guiones"
                                                    name="record_beneficiry_identity"
                                                    id="beneficiary_id"
                                                    required="required"/>
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <label class="form-label fw-bold">
                                                    <i class="fa fa-calendar me-1"></i>
                                                    Fecha de nacimiento
                                                </label>
                                                <input
                                                    class="form-control"
                                                    type="date"
                                                    placeholder="Número de identidad sin guiones"
                                                    name="record_beneficiry_birth"
                                                    id="birthday_id"
                                                    required="required"/>
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">
                                                        <i class="fa fa-list-alt me-1"></i>
                                                        Parentesco
                                                    </label>
                                                    <select class="form-control" name="selection_relationship" id="relationship_id" required="required">
                                                        <option t-att-data-opt-code="mother" value="mother">Madre</option>
                                                        <option t-att-data-opt-code="father" value="father">Padre</option>
                                                        <option t-att-data-opt-code="children" value="children">Hijo(a)</option>
                                                        <option t-att-data-opt-code="siblings" value="siblings">Hermano(a)</option>
                                                        <option t-att-data-opt-code="couple" value="couple">Pareja</option>
                                                        <option t-att-data-opt-code="grandparents" value="grandparents">Abuelo(a)</option>
                                                        <option t-att-data-opt-code="grandson" value="grandson">Nieto(a)</option>
                                                        <option t-att-data-opt-code="other" value="other">Otro</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <label class="form-label fw-bold">
                                                    <i class="fa fa-font" aria-hidden="true"></i>
                                                    Observacion
                                                </label>
                                                <input
                                                    class="form-control"
                                                    type="text"
                                                    placeholder="Agregue observaciones segun el caso"
                                                    name="record_beneficiry_obs"
                                                    id="beneficiary_obs_id"/>
                                            </div>
                                            <div class="col-12 text-center">
                                                <button type="submit" class="btn btn-primary px-4">
                                                    <i class="fa fa-save me-1"></i>
                                                    Crear
                                                </button>
                                            </div>
                                        </div>
                                    <!-- </div> -->
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tab3" class="tab-pane fade">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle historical_table">
                            <thead class="table-dark">
                                <tr>
                                    <th class="header_historical">Tipo de Ausencia</th>
                                    <th class="header_historical">Descripcion</th>
                                    <th class="header_historical">Fecha de Inicio</th>
                                    <th class="header_historical">Fecha de Finalizacion</th>
                                    <th class="header_historical">Tipo Boleto</th>
                                    <th class="header_historical">Solicitado</th>
                                    <th class="header_historical">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="history_absences_ids" t-as="absences">
                                    <tr>
                                        <td><t t-esc="absences.get('type')"/></td>
                                        <td><t t-esc="absences.get('description')"/></td>
                                        <td style="text-align:center"><t t-esc="absences.get('date_from')"/></td>
                                        <td style="text-align:center"><t t-esc="absences.get('date_to')"/></td>
                                        <td style="text-align:center"><t t-esc="absences.get('ticket_type')"/></td>
                                        <td style="text-align:center"><t t-esc="absences.get('tickets_request')"/> Boleto(s)</td>
                                        <td style="text-align:center"><t t-esc="absences.get('state')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <!-- JavaScript para el popup -->
            <script>
                // Esperar a que el documento esté completamente cargado
                document.addEventListener("DOMContentLoaded", function() {
                    var popup = document.getElementById("popupNotification");
                    if (popup) {
                        // Mostrar el popup
                        popup.style.display = "block";
                        // Ocultar el popup después de 5 segundos (por ejemplo)
                        setTimeout(function() {
                            popup.style.display = "none";
                        }, 5000); // 5000ms = 5 segundos
                    }
                });

                document.addEventListener("DOMContentLoaded", function () {
                    var create_beneficiary = document.getElementById("create_benficiary_id");
                    var absence_type = document.getElementById("absence_type");
                    var beneficiaryForm = document.getElementById("beneficiaryForm");
                    var take_tickets = document.getElementById("tickets");
                    var ben1Container = document.getElementById("beneficiary1_id").closest(".col-12");
                    var ben2Container = document.getElementById("beneficiary2_id").closest(".col-12");
                    var ben3Container = document.getElementById("beneficiary3_id").closest(".col-12");
                    var ben4Container = document.getElementById("beneficiary4_id").closest(".col-12");
                    var ben5Container = document.getElementById("beneficiary5_id").closest(".col-12");
                    var ben6Container = document.getElementById("beneficiary6_id").closest(".col-12");
                    var ben7Container = document.getElementById("beneficiary7_id").closest(".col-12");
                    var ben8Container = document.getElementById("beneficiary8_id").closest(".col-12");
                    var ben9Container = document.getElementById("beneficiary9_id").closest(".col-12");
                    var exit_only = document.getElementById("exit_only_id");
                    var open_back = document.getElementById("open_back_id");
                    var returnDiv = document.getElementById("return_div_id");
                    var finalDateDiv = document.getElementById("final_date_div");
                    var finalDate = document.getElementById("final_date_id");
                    var flyDispDiv = document.getElementById("fly_div_id");
                    var flyAvailable = document.getElementById("program_to_fly_id");
                    var relationship_sel = document.getElementById("relationship_id");
                    var beneficiary_obs = document.getElementById("beneficiary_obs_id");

                    function setDefaultValues() {
                        var selectedOption = absence_type.options[absence_type.selectedIndex];
                        var type_code = selectedOption.getAttribute("data-opt-code");

                        var selectedRelationship = relationship_sel.options[relationship_sel.selectedIndex];
                        var relationship_code = selectedRelationship.value;

                        // Mostrar u ocultar Boletos Disponibles
                        if (type_code === "PFLY"){
                            flyDispDiv.style.display = "block";
                            take_tickets.setAttribute("max", flyAvailable.value);
                        }else{
                            flyDispDiv.style.display = "none";
                            take_tickets.setAttribute("max", 9);
                        }

                        if (relationship_code === "other"){
                            beneficiary_obs.setAttribute("required","required");
                        }else{
                            beneficiary_obs.removeAttribute("required");
                        }

                        var ticketCount = parseInt(take_tickets.value, 10) || 0; 
                        ben1Container.style.display = "none";
                        ben2Container.style.display = "none";
                        ben3Container.style.display = "none";
                        ben4Container.style.display = "none";


                        if(create_beneficiary.checked){
                            beneficiaryForm.style.display = "block";
                        }else{
                            beneficiaryForm.style.display = "none";
                        }

                        if(exit_only.checked || open_back.checked){
                            returnDiv.style.display = "none";
                            finalDateDiv.style.display = "none";
                            finalDate.removeAttribute("required");
                        }else{
                            returnDiv.style.display = "block";
                            finalDateDiv.style.display = "block";
                            finalDate.setAttribute("required", "required");
                        }

                        if (ticketCount >= 1){
                            ben1Container.style.display = "block";
                        }else{
                            ben1Container.style.display = "none";
                        }

                        if (ticketCount >= 2){
                            ben2Container.style.display = "block";
                        }else{
                            ben2Container.style.display = "none";
                        }

                        if (ticketCount >= 3){
                            ben3Container.style.display = "block";
                        }else{
                            ben3Container.style.display = "none";
                        }

                        if (ticketCount >= 4){
                            ben4Container.style.display = "block";
                        }else{
                            ben4Container.style.display = "none";
                        }

                        if (ticketCount >= 5){
                            ben5Container.style.display = "block";
                        }else{
                            ben5Container.style.display = "none";
                        }

