<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_portal_my_home" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal_cm/static/src/img/schedule.png'"/>
                <t t-set="title">Ingreso de horas de turno</t>
                <t t-set="text">Ingresar horas trabajadas al dia para calculo de nomina</t>
                <t t-set="url" t-value="'/turns/record_hours_team'"/>
                <t t-set="config_card" t-value="True"/>
            </t>

            <!-- <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal_cm/static/src/img/absent.png'"/>
                <t t-set="title">Ausencias</t>
                <t t-set="text">Solicitar y ver mis ausencias</t>
                <t t-set="url" t-value="'/absences/record_absences_employee'"/>
                <t t-set="config_card" t-value="True"/>
            </t> -->
        </xpath>
    </template>
</odoo>
