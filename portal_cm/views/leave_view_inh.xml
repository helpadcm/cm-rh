<odoo>
    <record id="hr_leave_type_inh_form" model="ir.ui.view">
        <field name="name">hr.leave.type.inh</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <field name="time_type" position="after">
                <field name="code"/>
            </field>
        </field>
    </record>

    <record id="hr_leave_portal_form" model="ir.ui.view">
        <field name="name">hr.leave.portal.inh</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code" invisible="1"/>
            </field>
            <div name="duration_warning" position="after">
                <notebook>
                    <page name="pfly" string="Programa Volar" invisible="code != 'PFLY'">
                        <group>
                            <group>
                                <field name="tickets_request" invisible="code != 'PFLY'" readonly="state not in ['draft','confirm']"/>
                                <field name="exit_only" invisible="code != 'PFLY' or not exit_only" readonly="state not in ['draft','confirm']"/>
                                <field name="open_back" invisible="code != 'PFLY' or not open_back" readonly="state not in ['draft','confirm']"/>
                                <field name="exit_route_id" options="{'no_create': True}" invisible="code != 'PFLY'" readonly="state not in ['draft','confirm']"/>
                                <field name="return_route_id" options="{'no_create': True}" invisible="code != 'PFLY' or not exit_only or not open_back" readonly="state not in ['draft','confirm']"/>
                            </group>
                            <group>
                                <field name="beneficiary1" options="{'no_create': True}" invisible="tickets_request &lt; 1" readonly="state not in ['draft','confirm']"/>
                                <field name="beneficiary2" options="{'no_create': True}" invisible="tickets_request &lt; 2" readonly="state not in ['draft','confirm']"/>
                                <field name="beneficiary3" options="{'no_create': True}" invisible="tickets_request &lt; 3" readonly="state not in ['draft','confirm']"/>
                                <field name="beneficiary4" options="{'no_create': True}" invisible="tickets_request &lt; 4" readonly="state not in ['draft','confirm']"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </div>
        </field>
    </record>

    <record id="hr_employee_portal_form" model="ir.ui.view">
        <field name="name">hr.employee.portal.inh</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Permisos Portal">
                    <group>
                        <group>
                            <field name="show_absences_menu"/>
                            <field name="show_pfly_menu"/>
                        </group>
                        <group>
                            <field name="show_reserve_room_menu"/>
                            <field name="show_download_signature_menu"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
