<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data>
        <record id="rrhh_notification_pv_template" model="mail.template">
            <field name="name">Aprobacion Programa a Volar</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Aprobacion Programa a Volar</field>
            <!-- <field name="email_from">{{object.employee_id.user_id.login}}</field> -->
            <field name="email_to">conectividad@cmairlines.com</field>
            <field name="email_cc">{{object.employee_id.private_email}}, indira@cmairlines.com, kcastellanos@cmairlines.com</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                                <tbody>
                                    <!-- HEADER -->
                                    <tr>
                                        <td align="center" style="min-width: 590px;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="middle">
                                                        <span style="font-size: 10px;">Solicitud</span><br/>
                                                        <span style="font-size: 20px; font-weight: bold;" t-out="object.employee_id.name or ''"/> Programa a volar
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="2" style="text-align:center;">
                                                        <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <!-- CONTENT -->
                                    <tr>
                                        <td align="center" style="min-width: 590px;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="top" style="font-size: 13px;">
                                                        <div>
                                                            Se ha aprobado <t t-out="object.tickets_request or ''"/> Boleto(s) de <t t-if="object.exit_only">Ida</t><t t-if="not object.exit_only">Ida / Vuelta</t><br/><br/>
                                                            Ruta y fecha ida: <t t-out="object.exit_route_id.name or ''"/>, <t t-out="object.char_date_from or ''"/>.<br/><br/>
                                                            <t t-if="not object.exit_only and not object.open_back">
                                                                Ruta y fecha regreso: <t t-out="object.return_route_id.name or ''"/>, <t t-out="object.char_date_to or ''"/>.<br/><br/>
                                                            </t>
                                                            <t t-if="object.open_back">
                                                                Ruta y fecha regreso: <t t-out="object.return_route_id.name or ''"/>, Open.<br/><br/>
                                                            </t>
                                                            <table style="border:1px solid black;border-collapse: collapse;width:100%">
                                                                <tr>
                                                                    <td style="border:1px solid black;text-align:center;padding:3px" colspan="3"><strong>BENEFICIARIOS</strong></td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="border:1px solid black;text-align:center;padding:3px"><strong>Nombre</strong></td>
                                                                    <td style="border:1px solid black;text-align:center;padding:3px"><strong>Identidad</strong></td>
                                                                    <td style="border:1px solid black;text-align:center;padding:3px"><strong>Fecha de Nacimiento</strong></td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 0">
                                                                        <t t-out="object.beneficiary1.name or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 0">
                                                                        <t t-out="object.beneficiary1.identity or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px;text-align:center" t-if="object.tickets_request &gt; 0">
                                                                        <t t-out="object.beneficiary1.birthday or ''"/>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 1">
                                                                        <t t-out="object.beneficiary2.name or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 1">
                                                                        <t t-out="object.beneficiary2.identity or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px;text-align:center" t-if="object.tickets_request &gt; 1">
                                                                        <t t-out="object.beneficiary2.birthday or ''"/>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 2">
                                                                        <t t-out="object.beneficiary3.name or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 2">
                                                                        <t t-out="object.beneficiary3.identity or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px;text-align:center" t-if="object.tickets_request &gt; 2">
                                                                        <t t-out="object.beneficiary3.birthday or ''"/>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 3">
                                                                        <t t-out="object.beneficiary4.name or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px" t-if="object.tickets_request &gt; 3">
                                                                        <t t-out="object.beneficiary4.identity or ''"/>
                                                                    </td>
                                                                    <td style="border:1px solid black;padding:3px;text-align:center" t-if="object.tickets_request &gt; 3">
                                                                        <t t-out="object.beneficiary4.birthday or ''"/>
                                                                    </td>
                                                                </tr>
                                                            </table>

                                                            <table style="margin-top:1%;width:100%">
                                                                <tr>
                                                                    <td style="padding:3px" t-if="object.name">
                                                                        Descripcion: <t t-out="object.name"/>.
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="padding:3px" t-if="object.employee_id.private_email">
                                                                        Correo: <t t-out="object.employee_id.private_email"/>.
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="padding:3px" t-if="object.employee_id.private_phone">
                                                                        Telefono: <t t-out="object.employee_id.private_phone"/>.
                                                                    </td>
                                                                </tr>
                                                            </table>

                                                            <br/>Saludos.<br/>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align:center;">
                                                        <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </field>
        </record>

   </data>
</odoo>