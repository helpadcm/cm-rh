<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_invoice_send_form" model="ir.ui.view">
        <field name="name">custom.invoice.send.form</field>
        <field name="model">custom.invoice.send</field>
        <field name="arch" type="xml">
            <form string="Enviar Facturas Consolidadas">
                <group>
                    <group>
                        <field name="partner_id" required="1"/>
                        <field name="email_to" widget="email" required="1"/>
                    </group>
                    <group>
                        <field name="subject" required="1"/>
                        <field name="email_cc"/>
                    </group>
                </group>

                <notebook>
                    <page string="Cuerpo del Mensaje">
                        <field name="body" widget="html"/>
                    </page>
                    <page string="Facturas Incluidas" invisible="1">
                        <field name="move_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="move_type"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>>
                </notebook>
                <div class="oe_attachment_preview d-flex flex-wrap gap-2 mt-3">
                    <field name="attachment_ids" widget="many2many_binary" string="Archivos Adjuntos" nolabel="1"/>
                </div>

                <footer>
                    <button name="action_send_mail" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción vinculada al menú "Acciones" (Barra superior de la lista) -->
    <record id="action_custom_invoice_send_mass" model="ir.actions.act_window">
        <field name="name">Enviar por Correo</field>
        <field name="res_model">custom.invoice.send</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>