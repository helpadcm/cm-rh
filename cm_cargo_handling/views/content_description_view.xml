<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="description_content_form_view" model="ir.ui.view">
            <field name="name">Descripcion de Contenido</field>
            <field name="model">cargo.content.description</field>
            <field name="arch" type="xml">
                <form string="Descripcion de Contenido">
                    <sheet>
                        <div class="oe_avatar">
                            <field name="img_info" widget="image"/>
                        </div>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                            </group>
                            <group>
                                <field name="description" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="content_description_tree_view" model="ir.ui.view">
            <field name="name">Descripcion de Contenido</field>
            <field name="model">cargo.content.description</field>
            <field name="arch" type="xml">
                <tree string="Descripcion de Contenido">
                    <field name="name" />
                    <field name="description" />
                </tree>
            </field>
        </record>

        <record id="action_cargo_content_description_object" model="ir.actions.act_window">            
            <field name="name">Descripcion de Contenido</field>
            <field name="res_model">cargo.content.description</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>
    </data>
</odoo>