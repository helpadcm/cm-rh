<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_move_view_inherit" model="ir.ui.view">
            <field name="name">Cargo Move</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <button name="preview_invoice" position="before">
                    <button name='print_invoice' invisible="not from_handling" type='object' string='Factura Encomiendas'></button>
                </button>
                <field name="state" position="after">
                    <field name="prestate2" widget="statusbar" invisible="1"/>
                    <field name="from_handling" widget="statusbar" invisible="1"/>
                </field>
                <field name="ref" position="after">
                    <field name="order_handling_id" invisible="not from_handling" readonly="1"/>
                </field>
                <notebook position="inside">
                    <page string="Pagos de Caja" invisible="not from_handling">
                        <group>
                            <group>
                                <field name="amount_prepago"/>
                                <field name="amount_dffprepago" invisible="1"/>
                            </group>
                        </group>
                        <field name="prepago_ids" readonly="1" widget="one2many"/>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="cargo_move_view_inherit_sales" model="ir.ui.view">
            <field name="name">Cargo Move Sales Inh</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="cm_sales.view_account_invoice_form_inherit"/>
            <field name="arch" type="xml">
                <field name="partner_name" position="replace">
                    <field name="partner_name"/>
                </field>
                <field name="rtn_name" position="replace">
                    <field name="rtn_name"/>
                </field>
            </field>
        </record>
    </data>
</odoo>