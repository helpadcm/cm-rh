<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="discount_list_form_view" model="ir.ui.view">
            <field name="name">Listado de Descuentos</field>
            <field name="model">cargo.discount</field>
            <field name="arch" type="xml">
                <form string="Listado de Descuentos">
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="name" required="1"/>
                                <field name="discount_by" required="1"/>
                                <field name="porcentage" invisible="discount_by != 'percentage'"/>
                                <field name="discount_weight" invisible="discount_by != 'weight'"/>
                            </group>
                            <group>
                                <field name="code"/>
                                <field name="is_active" />
                                <field name="available_for" required="1"/>
                            </group>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="discount_list_tree_view" model="ir.ui.view">
            <field name="name">Listado de Descuentos</field>
            <field name="model">cargo.discount</field>
            <field name="arch" type="xml">
                <list string="Listado de Descuentos">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="discount_by"/>
                    <field name="porcentage"/>
                    <field name="discount_weight"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="action_discount_list" model="ir.actions.act_window">            
            <field name="name">Listado de Descuentos</field>
            <field name="res_model">cargo.discount</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

    </data>
</odoo>