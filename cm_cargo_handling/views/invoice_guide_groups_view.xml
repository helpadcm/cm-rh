<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="invoice_guide_groups_form_view" model="ir.ui.view">
            <field name="name">Facturacion grupo de guias</field>
            <field name="model">cargo.invoice.group_guides</field>
            <field name="arch" type="xml">
                <form string="Agrupacion de guias">
                    <header>
                        <button name="create_invoice" type="object" string="Facturar" class="oe_highlight" invisible="state != 'draft'" confirm="¿Esta seguro de querer crear la factura?"/>
                        <button name="print_guides" class="oe_highlight" type="object" string="Imprimir Guias" invisible="state != 'validated'"/>
                        <button name="set_to_draft" class="oe_highlight" type="object" string="Regresar a Borrador" invisible="state != 'validated'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="show_invoice" type="object" class="oe_stat_button" icon="fa-copy" invisible="not move_id">Factura</button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" options="{'no_create': True}" readonly="state != 'draft'" required="1" domain="[('grouping_invoice','=',True)]"/>
                                <field name="move_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="date" readonly="state != 'draft'" required="1"/>
                                <field name="total" />
                            </group>
                        </group>
                        <group>
                            <field name="number_guide" readonly="state != 'draft'"/>
                        </group>
                        <notebook>
                            <page string="Guias">
                                <field name="guide_ids" readonly="state != 'draft'">
                                    <tree create="false" edit="false" editable="bottom">
                                        <field name="bill_id"/>
                                        <field name="date"/>
                                        <field name="amount_lps" widget="monetary" options="{'currency_field': 'currency_hnl_id'}" sum="Total"/>
                                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="currency_hnl_id" column_invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>

            </field>
        </record>

        <record id="invoice_guide_groups_tree_view" model="ir.ui.view">
            <field name="name">Lista Facturacion de guias</field>
            <field name="model">cargo.invoice.group_guides</field>
            <field name="arch" type="xml">
                <tree string="Lista de Manifiestos">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="total" sum="Total"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="invoice_guide_groups_search_view" model="ir.ui.view">
            <field name="name">Agrupacion de guias search</field>
            <field name="model">cargo.invoice.group_guides</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="partner_id"/>
                    <group expand="0" string="Group By">
                        <filter name="state" string="Estado" domain="[]" context="{'group_by':'state'}"/>
                        <filter name="partner_id" string="Cliente" domain="[]" context="{'group_by':'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_invoice_guide_groups" model="ir.actions.act_window">            
            <field name="name">Facturacion de guias</field>
            <field name="res_model">cargo.invoice.group_guides</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>  
            <field name="domain">[]</field>
        </record>
        
    </data>
</odoo>
