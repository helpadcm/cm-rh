<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_manifest_logs_tree_view" model="ir.ui.view">
            <field name="name">Cargo manifest logs tree</field>
            <field name="model">cargo.manifest_log</field>
            <field name="arch" type="xml">
                <list string="Cargo manifest list" create="false" edit="false" delete="false">
                    <field name="cargo_manifest_id"/>
                    <field name="date"/>
                    <field name="observations"/>
                    <field name="bill_landing_ids" widget="many2many_tags"/>
                    <field name="type"/>
                    <field name="create_uid"/>
                </list>
            </field>
        </record>

        <record id="bill_landing_logs_view_tree" model="ir.ui.view">
            <field name="name">Bill landing logs</field>
            <field name="model">cargo.bill_logs</field>
            <field name="priority" eval="25"/>
            <field name="arch" type="xml">
                <list string="Bill logs" create="false" edit="false" delete="false">
                    <field name="create_date" string="Creado el"/>
                    <field name="bill_landing_id"/>
                    <field name="manifest_id"/>
                    <field name="observations"/>
                    <field name="shipping_airport_id"/>
                    <field name="reception_airport_id"/>
                    <field name="type"/>
                    <field name="create_uid"/>
                </list>
            </field>
        </record>


        <record id="cargo_manifest_logs_search_view" model="ir.ui.view">
            <field name="name">Cargo manifest logs search</field>
            <field name="model">cargo.manifest_log</field>
            <field name="arch" type="xml">
                <search string="Cargo manifest">
                    <field name="type" filter_domain="[('type', 'ilike', self)]" string="Estado"/>
                    <field name="cargo_manifest_id" operator="child_of"/>
                    <group>
                        <filter name="type" string="Estado" domain="[]" context="{'group_by':'type'}"/>
                        <filter name="cargo_manifest_id" string="Manifiesto" domain="[]" context="{'group_by':'cargo_manifest_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="cargo_bill_logs_search_view" model="ir.ui.view">
            <field name="name">Cargo bill logs search</field>
            <field name="model">cargo.bill_logs</field>
            <field name="arch" type="xml">
                <search string="Guias de Carga">
                    <field name="type" filter_domain="[('type', 'ilike', self)]" string="Estado"/>
                    <field name="manifest_id" operator="child_of"/>
                    <field name="bill_landing_id" operator="child_of"/>
                    <group>
                        <filter name="type" string="Estado" domain="[]" context="{'group_by':'type'}"/>
                        <filter name="manifest_id" string="Manifiesto de carga" domain="[]" context="{'group_by':'manifest_id'}"/>
                        <filter name="bill_landing_id" string="Guia de Carga" domain="[]" context="{'group_by':'bill_landing_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_cargo_manifest_logs" model="ir.actions.act_window">            
            <field name="name">Bitacora Manifiestos</field>
            <field name="res_model">cargo.manifest_log</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>  
            <field name="domain">[]</field>
        </record>

        <record id="action_cargo_bill_logs" model="ir.actions.act_window">            
            <field name="name">Bitacora Guias de Carga</field>
            <field name="res_model">cargo.bill_logs</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>  
            <field name="domain">[]</field>
        </record>

