<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="pricelist_handling_form_view" model="ir.ui.view">
            <field name="name">Lista de Precios Encomiendas</field>
            <field name="model">pricelist.handling</field>
            <field name="arch" type="xml">
                <form string="Listas de Precios">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Agregue nombre de la lista de precio"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="applicable" required="1"/>
                                <field name="initial_date" invisible="applicable != 'temporal'" required="applicable == 'temporal'"/>
                                <field name="fare_class_id" required="1" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="active"/>
                                <field name="final_date" invisible="applicable != 'temporal'" required="applicable == 'temporal'"/>
                                <field name="all_available"/>
                            </group>
                        </group>
                        <group>
                            <field name="rutes_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <notebook>
                            <page name="list_products" string="Productos">
                                <field name="list_product_ids">
                                    <tree editable="bottom">
                                        <field name="product_id" domain="[('for_cargo','=',True)]" options="{'no_create': True}"/>
                                        <field name="udm_id" readonly="1" force_save="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="price" />
                                        <field name="qty_min" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="pricelist_habdling_tree_view" model="ir.ui.view">
            <field name="name">Lista de Precios</field>
            <field name="model">pricelist.handling</field>
            <field name="arch" type="xml">
                <tree string="Lista de precios">
                    <field name="name"/>
                    <field name="applicable" />
                    <field name="rutes_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="action_pricelist_handling" model="ir.actions.act_window">            
            <field name="name">Lista de precios</field>
            <field name="res_model">pricelist.handling</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

    </data>
</odoo>