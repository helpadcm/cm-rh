<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_bill_form_view" model="ir.ui.view">
            <field name="name">Cargo bill lading form</field>
            <field name="model">cargo.bill</field>
            <field name="arch" type="xml">
                <form string="Bill lading" create="0" edit="0">
                    <header>
                        <button name="deliver_cargo" string="Entregar" type="object" class="btn-primary" invisible="state != 'received'"/>
                        <button name='undelive_cargo' type='object' string='Cambiar a recibido' groups='cm_cargo_handling.group_guia_cargar_admin' invisible="state not in ['delivered','abandoned','desechada']"></button>
                        <button name='abandoned_cargo' type='object' string='Marcar como abandono' groups='cm_cargo_handling.group_guia_cargar_admin' invisible="state != 'received'"></button>
                        <button name="action_desechar" string="Desechar" type="object" class="btn-primary" invisible="state not in ['created','sent']"/>
                        <button name='pay_invoice' type='object' string='Crear/Pagar Factura' invisible="payment_state == 'paid' or state in ['delivered','canceled','abandoned']"></button>
                        <button name='print_guides' invisible="payment_state != 'paid'" type='object' string='Imprimir Factura'></button>
                        <field name="state" widget="statusbar" statusbar_visible="draft,created,sent,received,delivered,canceled"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Por Cobrar" invisible="modality != 'upon_delivery'"/>
                        <widget name="web_ribbon" title="Contado" invisible="modality != 'counted'"/>
                        <widget name="web_ribbon" title="Credito" invisible="modality != 'credit'"/>
                        
                        <label for="name"/>
                        <field name="name" required="1" readonly="1"/>
                        <group>
                            <group>
                                <field name="content_description" required="1"/>
                                <field name='order_id' invisible='1'/>
                                <field name='payment_state'/>
                                <field name='modality' invisible='1'/>
                            </group>
                            <group>
                                <field name="observations"/>
                            </group>
                            <!-- <field name="international_add" colspan='4'/> -->
                        </group>
                        <group col="3">
                            <group string="Ruta">
                                <field name="origin_id" readonly="1" options="{'no_open': True}"/>
                                <field name="destination_id" readonly="1" options="{'no_open': True}"/>
                                <field name="content_description_ids" widget="many2many_checkboxes"/>
                            </group>
                            <group string="Remitente">
                                <field name="sender_name" required='1'/>
                                <field name="id_sender" string="Identidad" required="1"/>
                                <field name="sender_phone" string="Telefono" required="1"/>
                            </group>
                            <group string="Destinatario">
                                <field name="receiver_name" required='1'/>
                                <field name="id_receiver" string="Identidad"/>
                                <field name="receiver_phone" string="Telefono" required='1'/>
                            </group>
                        </group>
                        <group class="oe_subtotal_footer">
                            <field name="weight"/>
                            <field name="qty"/>
                            <field name="cargo_manifest_id" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Bitacora">
                                <field name="bill_log_ids" readonly="1">
                                    <tree string="Bitacora de guia" editable="bottom">
                                        <field name="create_date" string="Creado el"/>
                                        <field name="manifest_id"/>
                                        <field name="observations"/>
                                        <field name="shipping_airport_id"/>
                                        <field name="reception_airport_id"/>
                                        <field name="type"/>
                                        <field name="create_uid" string="Creado por"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        
        <record id="cargo_bill_tree_view" model="ir.ui.view">
            <field name="name">Lista Guias de Carga</field>
            <field name="model">cargo.bill</field>
            <field name="arch" type="xml">
                <tree string="Lista Guias de Carga" create="0" edit="0" delete="0">
                    <field name="name"/>
                    <field name="origin_id"/>
                    <field name="destination_id"/>
                    <field name="sender_name"/>
                    <field name="receiver_name"/>
                    <field name="weight"/>
                    <field name="modality"/>
                    <field name="payment_state"/>
                    <field name="state"/>
                    <!-- <field name="total"/> -->
                </tree>
            </field>
        </record>

        <record id="order_bill_search_view" model="ir.ui.view">
            <field name="name">Guiar de carga search</field>
            <field name="model">cargo.bill</field>
            <field name="arch" type="xml">
                <search string="Ordenes de venta">
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="sender_name" filter_domain="[('sender_name', 'ilike', self)]"/>
                    <field name="receiver_name" filter_domain="[('receiver_name', 'ilike', self)]"/>
                    <separator/>
                    <filter string="Por Cobrar" name="upon_delivery_filter" domain="[('modality','=','upon_delivery')]"/>
                    <filter string="Contado" name="counted_filter" domain="[('modality','=','counted')]"/>
                    <filter string="Credito" name="credit_filter" domain="[('modality','=','credit')]"/>
                    <separator/>
                    <filter string="Creadas" name="created_filter" domain="[('state','=','created')]"/>
                    <filter string="Enviadas" name="send_filter" domain="[('state','=','send')]"/>
                    <filter string="Recibidas" name="received_filter" domain="[('state','=','received')]"/>
                    <filter string="Entregadas" name="delivered_filter" domain="[('state','=','delivered')]"/>
                    <filter string="Abandonadas" name="abandoned_filter" domain="[('state','=','abandoned')]"/>
                    <filter string="Desechadas" name="desechada_filter" domain="[('state','=','desechada')]"/>
                    <filter string="Canceladas" name="canceled_filter" domain="[('state','=','canceled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_origin" string="Origen" domain="[]" context="{'group_by':'origin_id'}"/>
                        <filter name="group_destination" string="Destino" domain="[]" context="{'group_by':'destination_id'}"/>
                        <filter name="group_modality" string="Modalidad" domain="[]" context="{'group_by':'modality'}"/>
                        <filter name="group_state" string="Estado" domain="[]" context="{'group_by':'state'}"/>
                        <filter name="group_payment_state" string="Estado de pago" domain="[]" context="{'group_by':'payment_state'}"/>
                        <filter name="group_client" string="Cliente" domain="[]" context="{'group_by':'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_cargo_bill_object" model="ir.actions.act_window">            
            <field name="name">Guias de Carga</field>
            <field name="res_model">cargo.bill</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain" eval="[]"/>
        </record>

    </data>
</odoo>