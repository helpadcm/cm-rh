<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_additional_services_form_view" model="ir.ui.view">
            <field name="name">Servicios Adicionales</field>
            <field name="model">cargo.additional.services</field>
            <field name="arch" type="xml">
                <form string="Servicios Adicionales">
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="name" required="1"/>
                                <field name="currency_id" />
                                <field name="rent_product" invisible="type_service != 'rent'"/>
                                <field name="by_value" invisible="type_service != 'value'"/>
                                <field name="fixed_value" invisible="type_service != 'fixed'"/>
                                <field name="by_weight" invisible="type_service != 'weight'"/>
                            </group>
                            <group>
                                <field name="type_service"/>
                                <field name="description" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="aditional_service_tree_view" model="ir.ui.view">
            <field name="name">Servicios Adicionales</field>
            <field name="model">cargo.additional.services</field>
            <field name="arch" type="xml">
                <tree string="Servicios Adicionales">
                    <field name="name"/>
                    <field name="type_service"/>
                    <field name="description" />
                    <field name="currency_id" />
                </tree>
            </field>
        </record>

        <record id="action_cargo_additional_services_object" model="ir.actions.act_window">            
            <field name="name">Servicios Adicionales</field>
            <field name="res_model">cargo.additional.services</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

    </data>
</odoo>