<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sale_order_handling_form_view" model="ir.ui.view">
            <field name="name">Ordenes de Venta</field>
            <field name="model">sale.order.handling</field>
            <field name="arch" type="xml">
                <form string="Servicios Adicionales">
                    <header>
                        <button name="create_order" class="oe_highlight" type="object" string="Validar" invisible="state != 'quote'"/>
                        <button name="create_invoices" context="{'state': 'invoiced'}" class="oe_highlight" type="object" string="Crear Factura/Guias" invisible="state != 'order' or modality not in ['credit'] or move_id != False"/>
                        <button name="register_payment" context="{'state': 'invoiced'}" class="oe_highlight" type="object" string="Crear/Pagar Factura" invisible="state != 'order' or modality not in ['counted'] or move_id != False"/>
                        <button name="create_guides" class="oe_highlight" type="object" string="Crear Guias" invisible="not allow_create_guides or state != 'order' or created_guides"/>
                        <button name="register_payment" class="oe_highlight" type="object" string="Registrar Pago" invisible="not move_id or payment_state == 'paid' or modality in ['upon_delivery','credit'] or residual == 0 or state in ['canceled']"/>
                        <button name="set_to_quote" context="{'state': 'quote'}" class="oe_highlight" type="object" string="Regresar a Cotizacion" invisible="state != 'order' or created_guides or created_invoice"/>
                        <button name="action_desechar" invisible="state in ['quote','canceled']" class="oe_highlight" type="object" string="Cancelar Orden"/>
						<button name='print_guides' type='object' string='Imprimir Factura/Guia' invisible="state == 'quote'"></button>
                        <button name='print_invoice' invisible="payment_state != 'paid'" type='object' string='Imprimir Factura'></button>
                        <field name="state" widget="statusbar"/>
                  	</header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"> 
                            <button name="show_bill_ladings" type="object" class="oe_stat_button" icon="fa-copy" invisible="not created_guides">
                                <field name="qty_guides" widget="statinfo" string="Guias"/>
                            </button>
                            <button name="show_invoice" type="object" class="oe_stat_button" icon="fa-copy" invisible="not move_id">Factura</button>
                        </div>

                        <!-- <widget name="web_ribbon" title="Sin Pagar" invisible="payment_state != 'not_paid'"/> -->
                        <!-- <widget name="web_ribbon" title="Pagada" invisible="residual == 0"/>
                        <widget name="web_ribbon" title="Pagada Parcialmente" invisible="residual != 0"/> -->

                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <notebook>
                            <page  string="Principal">
                                <group col="3">
                                    <group>
                                        <field name="origin_id" options="{'no_create': True, 'no_open': True}" required="1" readonly="state != 'quote'"/>
                                        <field name="partner_id" readonly="state != 'quote'" domain="[('cargo_client','=',True),('parent_id','=',False)]" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="by_size" invisible="1"/>
                                        <field name="date" readonly="1" for_save="1" invisible="1"/>
                                        <field name="allow_create_guides" invisible="1"/>
                                        <field name="created_guides" invisible="1" />
                                        <field name="created_invoice" invisible="1" />
                                        <field name="residual" widget="monetary" options="{'currency_field': 'external_currency_id'}" invisible="1" />
                                    </group>
                                    <group>
                                        <field name="destination_id" readonly="state != 'quote'" options="{'no_create': True, 'no_open': True}" required="1"/>
                                    </group>
                                    <group>
                                        <field name="user_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                                    </group>
                                </group>
                                <group col="3">
                                    <group string="Remitente">
                                        <field name="sender_name" string="Remitente" invisible="1"/>
                                        <field name="sender_id" string="Nombre" options="{'no_create_edit': True}" readonly="state != 'quote'"/>
                                        <field name="id_sender" string="Identidad"  readonly="state != 'quote'"/>
                                        <field name="sender_phone" widget="phone" string="Telefono" readonly="state != 'quote'"/>
                                        <!-- <field name="sum_points" invisible="not default_client or modality != 'counted'" string="Acumula puntos" readonly="state != 'quote'"/> -->
                                    </group>
                                    <group string="Destinatario">
                                        <field name="receiver_name" string="Destinatario" invisible="1"/>
                                        <field name="receiver_id" string="Nombre" options="{'no_create_edit': True}" readonly="state != 'quote'"/>
                                        <field name="id_receiver" string="Identidad" readonly="state != 'quote'"/>
                                        <field name="receiver_phone" widget="phone" string="Telefono" readonly="state != 'quote'"/>
                                    </group>
                                    <group string="Contenido">
                                        <field name="content_description_ids" readonly="state != 'quote'" string="Descripcion" widget="many2many_checkboxes"/>
                                        <field name="has_contacts" invisible="1"/>
                                    </group>
                                </group>
                                <group string="Detalles">
                                    <group>
                                        <field name="observations" readonly="state != 'quote'"/>
                                    </group>
                                </group>
                            </page>
                            <page name="cart" string="Carrito">
                                <group string="Calculos" col="3">
                                    <group>
                                        <field name="product_id" domain="[('for_cargo','=',True)]" readonly="state != 'quote'" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="pricelist_id" invisible="1" domain="listprice_domain" readonly="state != 'quote'" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="pieces_qty" readonly="state != 'quote'"/>
                                        <field name="listprice_domain" invisible="1"/>
                                        <field name="discount_id" domain="[('is_active','=',True)]" readonly="state != 'quote'" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="options_size" invisible="not by_size" required="by_size" readonly="state != 'quote'"/>
                                        <field name="piece_type" required="1" readonly="state != 'quote'" invisible="1" help="Uniforme: Piezas con mismas dimensiones y peso; Mixta: Piezas con peso y dimensiones variables"/>
                                    </group>
                                    <group>
                                        <field name="piece_description" readonly="state != 'quote'"/>
                                        <field name="volumen_list_id" invisible="uom_name == 'Unidades'" options="{'no_create': True}" readonly="state != 'quote'"/>
                                        <field name="volumen" invisible="uom_name == 'Unidades'" readonly="state != 'quote'"/>
                                        <field name="uom_name" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="weight_or_qty" invisible="uom_name != 'Unidades'" readonly="state != 'quote'"/>
                                        <field name="weight_piece" invisible="uom_name == 'Unidades'" readonly="state != 'quote'"/>
                                        <field name="external_price" widget="monetary" options="{'currency_field': 'external_currency_id'}" readonly="1" for_save="1"/>
                                        <field name="tax_price" widget="monetary" options="{'currency_field': 'external_currency_id'}" readonly="1" for_save="1"/>
                                        <field name="total_amount_piece" widget="monetary" options="{'currency_field': 'external_currency_id'}" readonly="1" for_save="1"/>
                                        <field name="local_price" widget="monetary" options="{'currency_field': 'local_currency_id'}" readonly="1" for_save="1"/>
                                        <field name="external_currency_id" invisible="1"/>
                                        <field name="local_currency_id" invisible="1"/>
                                        <field name="udm_id" nolabel="1" class="oe_inline" invisible="1" for_save="1" options="{'no_create': True, 'no_open': True}"/>
                                    </group>
                                    <div style="margin-left:70%" class="o_row mt-2"> 
                                        <button name="add_cart" type="object" string="Agregar al Carrito" invisible="state != 'quote'" class="oe_highlight **text-nowrap**"/>	
                                    </div>
                                </group>
                                <group col="3">
                                    <group>
                                        <field name="modality" required="1" readonly="state != 'quote'"/>
                                        <field name="parent_id" domain="[('parent_id','=',partner_id)]" invisible="not apply_rtn or default_client == True" readonly="state != 'quote'" options="{'no_create': True}"/>
                                    </group>
                                    <group>
                                        <field name="apply_rtn" readonly="state != 'quote' or readonly_rtn == True" force_save="1"/>
                                        <field name="readonly_rtn" invisible="1"/>
                                        <field name="default_client" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="client_name" invisible="not apply_rtn" readonly="state != 'quote'"/>
                                        <field name="rtn" invisible="not apply_rtn" readonly="state != 'quote' or readonly_rtn == True" required="apply_rtn" force_save="1"/>
                                    </group>
                                </group>>
                                <field name="cart_ids" readonly="state != 'quote'">
                                    <tree create="false" editable="bottom">
                                        <field name="product_id" readonly="1"/>
                                        <field name="piece_description" string="Descripcion" />
                                        <field name="weight_piece" sum="Total LBS" readonly="1"/>
                                        <field name="udm_id" readonly="1" force_save="1" column_invisible="1"/>
                                        <field name="weight_or_qty" sum="Total" readonly="1"/>
                                        <field name="volumen" readonly="1" force_save="1" sum="Total Volumen"/>
                                        <field name="external_price" widget="monetary" options="{'currency_field': 'external_currency_id'}" readonly="1" for_save="1" sum="Total USD"/>
                                        <field name="local_price" widget="monetary" options="{'currency_field': 'local_currency_id'}" readonly="1" for_save="1" sum="Total LPS"/>
                                        <field name="external_currency_id" column_invisible="1"/>
                                        <field name="local_currency_id" column_invisible="1"/>
                                        <field name="pieces_qty" sum="Total Piezas" column_invisible="1"/>
                                    </tree>
                                </field>
                                <group col="3">
                                    <group>
                                        <field name="type_id" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="options" invisible="1"/>
                                        <field name="move_id" invisible="1"/>
                                        <field name="payment_state" invisible="1"/>
                                    </group>
                                    <group class="oe_subtotal_footer">
                                        <!-- <field name="kilometers" invisible="1"/> -->
                                        <field name="weight"/>
                                        <!-- <field name="volumetric_weight"  attrs="{'invisible':[('options','=','is_sobre')]}"/> -->
                                        <field name="preliminar_price" widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <field name="additional_costs" widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <field name="discount" string='Descuento' widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <field name="total" string='Subtotal' widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <!-- <field name="amount_discount"/> -->
                                        <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <field name="amount_tax" string='Impuesto' widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <field name="amount_total" class="oe_subtotal_footer_separator" string='Total' widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                                        <field name="amount_total_lps" class="oe_subtotal_footer_separator" string='Total(Lps)' widget="monetary" options="{'currency_field': 'local_currency_id'}"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Servicios Adicionales" >
                                <field name="additional_services_ids" readonly="state != 'quote'">
                                    <tree string="Caption">
                                        <field name="additional_service"/>
                                        <field name="type_service" column_invisible="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="total" sum="Total"/>
                                    </tree>
                                    <form string="Servicios Adicionales">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="additional_service" options="{'no_create': True}" required='1'/>
                                                    <field name="total" sum="Total"/>
                                                    <field name="type_service" invisible="1"/>
                                                    <field name="currency_id" invisible="1"/>
                                                </group>
                                                <group>
                                                    <field name="rent_product" invisible="type_service != 'rent'" readonly="1"/>
                                                    <field name="by_value" invisible="type_service != 'value'" readonly="1"/>
                                                    <field name="fixed_value" invisible="type_service != 'fixed'" readonly="1"/>                                                    
                                                    <field name="by_weight" invisible="type_service != 'weight'" readonly="1"/>
                                                    <field name="weight" invisible="type_service != 'weight'"/>
                                                    <field name="commercial_value" invisible="type_service != 'value'"/>
                                                    <field name="date_send" invisible="type_service != 'date'"/>
                                                    <field name="size_id" invisible="type_service != 'rent'"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page name="bill_ladings" string="Guias de carga" invisible="1">
                                <field name="bill_lading_ids">
                                    <tree create="false">
                                        <field name="name"/>
                                        <field name="origin_id"/>
                                        <field name="destination_id"/>
                                        <field name="state"/>
                                    </tree>
                                    <form string="Guia de Carga">
                                        <header>
                                            <field name="state" widget="statusbar" statusbar_visible="draft,created,sent,received,delivered,canceled"/>
                                        </header>
                                        <sheet>
                                            <label for="name"/>
                                            <field name="name" required="1" readonly="1"/>
                                            <group>
                                                <group>
                                                    <field name="content_description" string="Descripcion del Contenido" required="1"/>
                                                    <field name='order_id' invisible='1'/>
                                                </group>
                                                <group>
                                                    <field name="observations"/>
                                                </group>
                                                <!-- <field name="international_add" colspan='4'/> -->
                                            </group>
                                            <notebook>
                                                <page string="Principal">
                                                    <group col="3">
                                                        <group string="Ruta">
                                                            <field name="origin_id" readonly="1" options="{'no_open': True}"/>
                                                            <field name="destination_id" readonly="1" options="{'no_open': True}"/>
                                                            <field name="content_description_ids" widget="many2many_checkboxes"/>
                                                        </group>
                                                        <group string="Remitente">
                                                            <field name="sender_name" required='1'/>
                                                            <field name="id_sender" string="Identidad" required="1"/>
                                                            <field name="sender_phone" string="Telefono" required="1"/>
                                                        </group>
                                                        <group string="Destinatario">
                                                            <field name="receiver_name" required='1'/>
                                                            <field name="id_receiver" string="Identidad"/>
                                                            <field name="receiver_phone" string="Telefono" required='1'/>
                                                        </group>
                                                    </group>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="sale_order_habdling_tree_view" model="ir.ui.view">
            <field name="name">Ordenes de Venta</field>
            <field name="model">sale.order.handling</field>
            <field name="arch" type="xml">
                <tree string="Ordenes de Venta" decoration-info="state == 'quote'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="user_id" />
                    <field name="origin_id"/>
                    <field name="destination_id"/>
                    <field name="modality" />
                    <field name="amount_total" sum="Total DLS" string='Total' widget="monetary" options="{'currency_field': 'external_currency_id'}"/>
                    <field name="amount_total_lps" sum="Total LPS" string='Total(Lps)' widget="monetary" options="{'currency_field': 'local_currency_id'}"/>
                    <field name="payment_state"/>
                    <field name="state"/>
                    <field name="external_currency_id" column_invisible="1"/>
                    <field name="local_currency_id" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="order_handling_search_view" model="ir.ui.view">
            <field name="name">Ordenes de venta search</field>
            <field name="model">sale.order.handling</field>
            <field name="arch" type="xml">
                <search string="Ordenes de venta">
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="sender_id" filter_domain="[('sender_id', 'ilike', self)]"/>
                    <field name="receiver_id" filter_domain="[('receiver_id', 'ilike', self)]"/>
                    <field name="partner_id" filter_domain="[('partner_id', 'ilike', self)]"/>
                    <separator/>
                    <filter string="Por Cobrar" name="upon_delivery_filter" domain="[('modality','=','upon_delivery')]"/>
                    <filter string="Contado" name="counted_filter" domain="[('modality','=','counted')]"/>
                    <filter string="Credito" name="credit_filter" domain="[('modality','=','credit')]"/>
                    <separator/>
                    <filter string="Creados Hoy" name="today" domain="[('create_date','>=',context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Mis Registros" name="my_records" domain="[('create_uid','=',uid)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_origin" string="Origen" domain="[]" context="{'group_by':'origin_id'}"/>
                        <filter name="group_destination" string="Destino" domain="[]" context="{'group_by':'destination_id'}"/>
                        <filter name="group_modality" string="Modalidad" domain="[]" context="{'group_by':'modality'}"/>
                        <filter name="group_state" string="Estado" domain="[]" context="{'group_by':'state'}"/>
                        <filter name="group_user" string="Agente" domain="[]" context="{'group_by':'user_id'}"/>
                        <filter name="group_client" string="Cliente" domain="[]" context="{'group_by':'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sale_order_handling" model="ir.actions.act_window">            
            <field name="name">Ordenes de Venta</field>
            <field name="res_model">sale.order.handling</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_today': 1}</field>         
            <field name="domain" eval=""/>
        </record>

        <record id="action_partner_handling" model="ir.actions.act_window">            
            <field name="name">Clientes Encomiendas</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'default_cargo_client': True}</field>         
            <field name="domain" eval="[('cargo_client','=',True),('parent_id','=',False)]"/>
        </record>

    </data>
</odoo>