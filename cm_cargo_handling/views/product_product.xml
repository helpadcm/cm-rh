<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_product_template_view_inherit" model="ir.ui.view">
            <field name="name">Cargo product template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Encomiendas">
                        <group>
                            <group>
                                <field name="for_cargo"/>
                                <field name="for_recargo" />
                            </group>
                            <group invisible="not for_cargo">
                                <field name="type_cargo" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <button name="add_routes" type="object" string="Agregar Rutas" class="oe_highlight"/>
                        <notebook>
                            <page string="Lista de precios">
                                <field name="price_list_ids" invisible="not for_cargo">
                                    <tree editable="bottom">
                                        <field name="rute_id" />
                                        <field name="price" />
                                        <field name="qty_min" />
                                        <field name="currency_id" column_invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="action_product_handling" model="ir.actions.act_window">            
            <field name="name">Productos</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'default_for_cargo': True}</field>         
            <field name="domain" eval="[('for_cargo','=',True)]"/>
        </record>
    </data>
</odoo>