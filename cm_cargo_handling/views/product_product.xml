<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_product_template_view_inherit" model="ir.ui.view">
            <field name="name">Cargo product template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='detailed_type']" position="after">
                    <field name="type_cargo" options="{'no_create': True}"/>
                    <field name="for_cargo"/>
                    <field name="for_recargo" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>