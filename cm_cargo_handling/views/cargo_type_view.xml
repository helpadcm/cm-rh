<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_type_tree_view" model="ir.ui.view">
            <field name="name">Tipos de Envio</field>
            <field name="model">cargo.type</field>
            <field name="arch" type="xml">
                <list string="Tipos de Envio" editable="bottom">
                    <field name="name" />
                    <field name="minim_weight" />
                    <field name="options" />
                </list>
            </field>
        </record>

        <record id="fare_classes_tree_view" model="ir.ui.view">
            <field name="name">Clases Tarifarias</field>
            <field name="model">fare.clases</field>
            <field name="arch" type="xml">
                <list string="Clases Tarifarias" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                </list>
            </field>
        </record>

        <record id="lost_reason_guides_tree_view" model="ir.ui.view">
            <field name="name">Motivos para Desechar</field>
            <field name="model">handling.lost.reason</field>
            <field name="arch" type="xml">
                <list string="Motivos para Desechar" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="volumen_list_tree_view" model="ir.ui.view">
            <field name="name">Listado de Volumenes</field>
            <field name="model">cargo.volumen.list</field>
            <field name="arch" type="xml">
                <list string="Volumenes" editable="bottom">
                    <field name="image" widget="image"/>
                    <field name="code" required="1"/>
                    <field name="name" required="1"/>
                    <field name="volumen"/>
                    <field name="instructions"/>
                </list>
            </field>
        </record>

        <record id="sender_receiver_tree_view" model="ir.ui.view">
            <field name="name">Historico Remitentes/Destinatarios</field>
            <field name="model">res.partner.contact</field>
            <field name="arch" type="xml">
                <list string="Remitentes/Destinatarios" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="phone" required="1"/>
                    <field name="identity"/>
                    <field name="code" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_cargo_type_object" model="ir.actions.act_window">            
            <field name="name">Tipos de Envio</field>
            <field name="res_model">cargo.type</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

        <record id="action_fare_classes" model="ir.actions.act_window">            
            <field name="name">Clases Tarifarias</field>
            <field name="res_model">fare.clases</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

        <record id="action_lost_reason_guide" model="ir.actions.act_window">            
            <field name="name">Motivos de perdida</field>
            <field name="res_model">handling.lost.reason</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

        <record id="action_volumen_list" model="ir.actions.act_window">            
            <field name="name">Volumenes</field>
            <field name="res_model">cargo.volumen.list</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

        <record id="action_receiver_sender_list" model="ir.actions.act_window">            
            <field name="name">Remitentes/Destinatarios</field>
            <field name="res_model">res.partner.contact</field>
            <field name="view_mode">list</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>
    </data>
</odoo>
