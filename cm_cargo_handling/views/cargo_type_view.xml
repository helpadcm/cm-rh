<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cargo_type_tree_view" model="ir.ui.view">
            <field name="name">Tipos de Envio</field>
            <field name="model">cargo.type</field>
            <field name="arch" type="xml">
                <tree string="Tipos de Envio" editable="bottom">
                    <field name="name" />
                    <field name="minim_weight" />
                    <field name="options" />
                </tree>
            </field>
        </record>

        <record id="fare_classes_tree_view" model="ir.ui.view">
            <field name="name">Clases Tarifarias</field>
            <field name="model">fare.clases</field>
            <field name="arch" type="xml">
                <tree string="Clases Tarifarias" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                </tree>
            </field>
        </record>

        <record id="action_cargo_type_object" model="ir.actions.act_window">            
            <field name="name">Tipos de Envio</field>
            <field name="res_model">cargo.type</field>
            <field name="view_mode">tree</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>

        <record id="action_fare_classes" model="ir.actions.act_window">            
            <field name="name">Clases Tarifarias</field>
            <field name="res_model">fare.clases</field>
            <field name="view_mode">tree</field>
            <field name="context">{}</field>         
            <field name="domain" eval="[]"/>
        </record>
    </data>
</odoo>
