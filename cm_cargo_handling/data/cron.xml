<odoo>
    <data noupdate="1">
         <record model="ir.cron" id="prepago_ladings_cron">
            <field name="name">Prepagos a Pagos</field>
            <field name="model_id" ref="cm_cargo_handling.model_cm_prepago"/>
            <field name="code">model.cron_sent_pays()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record model="ir.cron" id="delete_incompletes_records_cron">
            <field name="name">Borrar Remitentes/Destinatarios Incompletos</field>
            <field name="model_id" ref="cm_cargo_handling.model_res_partner_contact"/>
            <field name="code">model._clean_incomplete_records()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record model="ir.cron" id="delete_quotes_order_cron">
            <field name="name">Borrar Ordenes en cotizacion</field>
            <field name="model_id" ref="cm_cargo_handling.model_sale_order_handling"/>
            <field name="code">model.delete_orders()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record model="ir.cron" id="delivery_guide_cron">
            <field name="name">Entregar guias destino GUA</field>
            <field name="model_id" ref="cm_cargo_handling.model_cargo_bill"/>
            <field name="code">model.delivery_order_gua()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record model="ir.cron" id="send_daily_sales_cron">
            <field name="name">Encomiendas: Enviar Ventas Diarias</field>
            <field name="model_id" ref="cm_cargo_handling.model_cargo_bill"/>
            <field name="code">model.generate_and_send_report()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>