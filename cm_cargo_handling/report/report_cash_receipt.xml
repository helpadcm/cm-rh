<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_cash_receipt">
            <t t-call="web.html_container">
                <head>
                    <meta charset="utf-8"/>
                </head>
                <t t-set="company" t-value="res_company"></t>	
                <div class="page" style="font-size:15px sans-serif;">
                    <t t-foreach="docs" t-as="o">
                            <t t-if="o.state != 'draft'">
                                <table style="align:center;width:100%;border-collapse:collapse;margin-top:10%">
                                    <style>
                                        td{
                                            font-size:11px;
                                        }
                                    </style>
                                    <tbody>
                                        <tr>
                                            <td style="width:40%">
                                                <table style="width:100%;border-collapse: collapse">
                                                    <tbody>
                                                        <tr>
                                                            <td style="font-size:12px"><strong><span t-field="company.name"/></strong></td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:12px;padding-left:2%">RTN: <span t-field="company.company_registry"/></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                            <td style="width:40%">
                                                <table style="width:100%;border-collapse: collapse">
                                                    <tbody>
                                                        <tr>
                                                            <td><span t-field="company.street"/></td>
                                                        </tr>
                                                        <tr>
                                                            <td><span t-field="company.street2"/></td>
                                                        </tr>
                                                        <tr>
                                                            <td><span t-field="company.city"/> <span t-field="company.zip"/> <span t-field="company.country_id.name"/></td>
                                                        </tr>
                                                        <tr>
                                                            <td>Tel. <span t-field="company.phone"/></td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding-left:2%;font-size:15px"><strong>RECIBO DE CAJA</strong></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                            <td style="width:20%">
                                                <table style="width:100%;border-collapse: collapse">
                                                    <tbody>
                                                        <tr><td></td></tr>
                                                        <tr>
                                                            <td><img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="height:60px" alt="Logo"/></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table style="width:100%;border:1px solid black;margin-top:1%;border-collapse: collapse">
                                    <style>
                                        .td_end{
                                            border-bottom:1px solid black;
                                        }
                                        .td_left{
                                            padding-left:2%;
                                        }
                                        td{
                                            font-size:13px;
                                        }
                                    </style>
                                    <t t-set="total1" t-value="0.00"/>
                                    <t t-set="total2" t-value="0.00"/>
                                    <tr>
                                        <td colspan="4" class="td_left" style="padding-top:2%"><strong>RECIBI DE:</strong></td>
                                        <td colspan="2" ><strong>Número de Recibo:</strong></td>
                                        <td style="text-align:right;padding-right:2%"><strong><span t-field="o.name"/></strong></td>    
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="td_left"><span t-esc="o.partner_id_for_parents.name.upper()"/></td>
                                        <td colspan="2"><strong>Punto de Venta:</strong></td>
                                        <td style="text-align:right;padding-right:2%"><span t-field="o.user_id.station_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="td_left"><span t-field="o.partner_id_for_parents.street"/></td>
                                        <td colspan="2">Fecha:</td>
                                        <!--td style="text-align:right;padding-right:2%"><span t-esc="o.date"/></td-->
                                        <td style="text-align:right;padding-right:2%"><span t-esc="datetime.datetime.strptime(str(o.date), '%Y-%m-%d').strftime('%d/%m/%Y')"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="td_left"><span t-field="o.partner_id_for_parents.city"/> <span t-field="o.partner_id_for_parents.zip"/></td>
                                        <td colspan="2" style="background-color:rgb(218,218,218);">Monto en <span t-field="o.currency_id.name"/>:</td>
                                        <td style="background-color:rgb(218,218,218);text-align:right;padding-right:2%"><span t-esc="'{0:,.2f}'.format(o.amount)"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="td_left"><span t-field="o.partner_id_for_parents.phone"/></td>
                                        <td colspan="2">Tipo de Cambio:</td>
                                        <td style="text-align:right;padding-right:2%"><span t-esc="'{0:,.4f}'.format(1/o.currency_id._get_rates(company, o.date).get(o.currency_id.id, 1.0) )"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="td_end" style="padding-left:2%"><span t-field="o.partner_id_for_parents.email"/></td>
                                        <td colspan="2">Valor en <span t-field="company.currency_id.name"/>:</td>
                                        <td style="text-align:right;padding-right:2%"><span t-esc="'{0:,.2f}'.format(o.amount_company_currency_signed)"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="td_left" style="padding-top:2%"><strong>Manera de Pago</strong></td>
                                    </tr>
                                    <tr>
                                        <td class="td_left" style="text-align:center;width:20%;background-color:rgb(218,218,218);">Tipo de Pago</td>
                                        <td style="background-color:rgb(218,218,218);text-align:center;width:10%">Fecha</td>
                                        <td style="background-color:rgb(218,218,218);text-align:center;width:10%">Referencia</td>
                                        <td style="background-color:rgb(218,218,218);text-align:center;width:15%">Autorización</td>
                                        <td style="background-color:rgb(218,218,218);text-align:center;width:15%">T/C</td>
                                        <td style="background-color:rgb(218,218,218);text-align:center;width:15%">Importe <span t-field="o.currency_id.name"/></td>
                                        <td style="background-color:rgb(218,218,218);text-align:center;width:15%">Importe <span t-field="company.currency_id.name"/></td>
                                    </tr>
                                    <tr style="margin-left:1%">
                                        <td class="td_left" style="text-align:center"><span t-field="o.pay_method_type"/></td>
                                        <td style="text-align:center"><span t-field="o.date"/></td>
                                        <td style="text-align:center"><span t-field="o.name"/></td>
                                        <td style="text-align:center"><tspan t-field="o.nro_auto"/></td>
                                        <td style="text-align:center"><tspan t-field="o.card_digits"/></td>
                                        <td style="text-align:right"><span t-esc="'{0:,.2f}'.format(o.amount)"/></td>
                                        <td style="text-align:right;padding-right:2%"><span t-esc="'{0:,.2f}'.format(o.amount_company_currency_signed)"/></td>
                                    </tr>
                                    <tr>
                                        <t t-set="total1" t-value="total1+o.amount"/>
                                        <t t-set="total2" t-value="total2+o.amount_company_currency_signed"/>
                                        <td colspan="2" class="td_end" style="margin-left:1%;border-top:1px solid black;margin-left;2%"></td>
                                        <td class="td_end" style="border-top:1px solid black;text-align:center"><strong>Total</strong></td>
                                        <td colspan="2" class="td_end" style="border-top:1px solid black"></td>
                                        <td class="td_end" style="border-top:1px solid black;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(total1)"/></strong></td>
                                        <td class="td_end" style="border-top:1px solid black;text-align:right;padding-right:2%"><strong><span t-esc="'{0:,.2f}'.format(total2)"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" style="border-right:1px solid black;padding-top:2%" class="td_left"><strong>CONCEPTO</strong></td>
                                        <td class="td_left"><strong>Agente Receptor:</strong></td>
                                        <td colspan="3"><strong>________________________________________________________</strong></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" style="border-right:1px solid black" class="td_left"><span t-field="o.memo"/></td>
                                        <td colspan="4"></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" style="border-right:1px solid black" class="td_left"></td>
                                        <td ></td>
                                        <td colspan="3" style="padding-top:4%;">x------------------------------------ <br></br>
                                            Firma y sello
                                        </td>
                                    </tr>
                                </table>
                                <div style="width:100%;border:1px dashed black;margin-top:8%"></div>
                            </t>
                    </t>
                </div>
            </t>
        </template>
    </data>
</odoo>