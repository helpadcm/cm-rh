<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="daily_sales_agent">
            <t t-call="web.html_container">
                <head>
                    <meta charset="utf-8"/>
                </head>
                <t t-set="company" t-value="res_company"></t>
                <div class="page" style="font-size:15px;">
                    <style>
                        td{
                            font-size: 13px;
                        }

                        th{
                            font-size: 14px;
                        }
                    </style>
                    <table style="align:center;width:100%">
                        <tbody>
                            <tr style="height: 20px;padding:0px;border:0px ;" >
                                <td style="width:20%;" rowspan="4">
                                    <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="height: 120px;" alt="Logo"/>
                                </td>
                                <td style="text-align:center;font-size:28px"><strong>Ventas diarias por agente</strong></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;font-size:20px">Fechas del reporte: <span t-esc="initial_date"/> al <span t-esc="final_date"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-foreach="data" t-as="day">
                        <p style="padding:3px;border-top:1px solid #CDCDCD;background-color:#CDCDCD;text-align:left;font-size:16px"><strong>Fecha: <t t-esc="day.get('date')"/></strong></p>
                        <table width="100%" style="font-size:10px;border-collapse: collapse" class="table table-condensed">
                            <tr>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:center">#</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:left">Empleado</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:right">Efectivo (LPS)</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:right">Efectivo (USD)</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:right">Credito (LPS)</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:right">Credito (USD)</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:right">Total (LPS)</th>
                                <th style="padding:3px;border-top:1px solid #CDCDCD;text-align:right">Total (USD)</th>
                            </tr>
                            <t t-set="cont" t-value="1"/>
                            <t t-set="t_cash_lps" t-value="0"/>
                            <t t-set="t_credit_lps" t-value="0"/>
                            <t t-set="t_cash_usd" t-value="0"/>
                            <t t-set="t_credit_usd" t-value="0"/>
                            <t t-set="t_lps" t-value="0"/>
                            <t t-set="t_usd" t-value="0"/>
                            <t t-foreach="day.get('employees')" t-as="employee">
                                <tr>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:center"><span t-esc="cont"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="employee.get('employee')"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(employee.get('total_cash_lps'))"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(employee.get('total_cash_usd'))"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(employee.get('total_credit_lps'))"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(employee.get('total_credit_usd'))"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(employee.get('total_lps'))"/></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(employee.get('total_usd'))"/></td>
                                </tr>
                                <t t-set="cont" t-value="cont + 1"/>
                                <t t-set="t_cash_lps" t-value="t_cash_lps + (employee.get('total_cash_lps'))"/>
                                <t t-set="t_cash_usd" t-value="t_cash_usd + (employee.get('total_cash_usd'))"/>
                                <t t-set="t_credit_lps" t-value="t_credit_lps + (employee.get('total_credit_lps'))"/>
                                <t t-set="t_credit_usd" t-value="t_credit_usd + (employee.get('total_credit_usd'))"/>
                                <t t-set="t_lps" t-value="t_lps + (employee.get('total_lps'))"/>
                                <t t-set="t_usd" t-value="t_usd + (employee.get('total_usd'))"/>
                            </t>
                            <tr>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:center" colspan="2"><strong>TOTAL</strong></td>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(t_cash_lps)"/></strong></td>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(t_cash_usd)"/></strong></td>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(t_credit_lps)"/></strong></td>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(t_credit_usd)"/></strong></td>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(t_lps)"/></strong></td>
                                <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><strong><span t-esc="'{0:,.2f}'.format(t_usd)"/></strong></td>
                            </tr>
                        </table>
                    </t>
                </div>

                <div class="footer">
                    <div class="text-center" style="border-top: 1px solid black">
                        Pág. <span class="page"/> de <span class="topage"/>
                    </div> 
                </div>
            </t>
        </template>
    </data>
</odoo>
