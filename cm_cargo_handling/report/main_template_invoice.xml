<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_format_handling">
        <t t-call="web.html_container">
            <div class="page">
                <t t-foreach="data" t-as="o">
                    <t t-call="{{ invoice_order }}"/>
                    <t t-foreach="o.get('guides_values')" t-as="guide" t-as-index="guide_index">
                        <t t-call="{{ child_guide }}"/>
                    </t>
                </t>
            </div>
        </t>
    </template>
</odoo>