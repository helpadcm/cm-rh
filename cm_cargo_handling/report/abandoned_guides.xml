<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="abandoned_guides_report">
            <t t-call="web.html_container">
                <head>
                    <meta charset="utf-8"/>
                </head>
                <t t-set="company" t-value="res_company"></t>
                <div class="page" style="font-size:15px;">
                    <style>
                        td{
                            font-size: 12px;
                        }

                        th{
                            font-size: 13px;
                        }
                    </style>
                    <table style="align:center;width:100%">
                        <tbody>
                            <tr style="height: 20px;padding:0px;border:0px ;" >
                                <td style="width:20%;" rowspan="4">
                                    <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="height: 120px;" alt="Logo"/>
                                </td>
                                <td style="text-align:center;font-size:28px"><strong>Guias abandonadas</strong></td>
                            </tr>
                            <tr>
                                <td>Fecha del reporte: <span t-esc="report_date"/></td>
                                <td>Guias anterior al: <span t-esc="abandoned_date"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <table width="100%" style="font-size:10px;border-collapse: collapse" class="table table-condensed">
                        <t t-foreach="data" t-as="dest">
                            <tr>
                                <th colspan="10" style="padding:3px;border-top:1px solid #CDCDCD;text-align:left;"><strong>Destino: <span t-esc="dest.get('destination_name')"/></strong></th>
                            </tr>
                            <table width="100%" style="font-size:10px;border-collapse: collapse" class="table table-condensed">
                                <t t-set="cont" t-value="1"/>
                                <t t-set="total" t-value="0"/>
                                <tr>
                                    <th style="width:3%;padding:3px;border-top:1px solid #CDCDCD;text-align:center">No.</th>
                                    <th style="width:10%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Guia</th>
                                    <th style="width:5%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Fecha recibida</th>
                                    <th style="width:19%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Remitente</th>
                                    <th style="width:7%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Telefono</th>
                                    <th style="width:19%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Destinatario</th>
                                    <th style="width:7%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Telefono</th>
                                    <th style="width:10%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Origen</th>
                                    <!-- <th style="width:10%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Destino</th> -->
                                    <th style="width:10%;padding:3px;border-top:1px solid #CDCDCD;text-align:left">Modalidad</th>
                                    <th style="width:10%;padding:3px;border-top:1px solid #CDCDCD;text-align:right">Monto</th>
                                </tr>
                                <t t-foreach="dest.get('guides')" t-as="guide">
                                    <tr>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="cont"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('guide')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('received_date')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('sender_name')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('sender_phone')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('receiver_name')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('receiver_phone')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('origin')"/></td>
                                        <!-- <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('destination')"/></td> -->
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;"><span t-esc="guide.get('modality')"/></td>
                                        <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(guide.get('amount'))"/></td>
                                    </tr>
                                    <t t-set="cont" t-value="cont + 1"/>
                                    <t t-set="total" t-value="total + guide.get('amount')"/>
                                </t>
                                <tr>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right" colspan="9"><strong>TOTAL</strong></td>
                                    <td style="padding:3px;border-top:1px solid #CDCDCD;text-align:right"><span t-esc="'{0:,.2f}'.format(total)"/></td>
                                </tr>
                            </table>
                            <br></br>
                        </t>
                    </table>
                </div>

                <div class="footer">
                    <div class="text-center" style="border-top: 1px solid black">
                        Pág. <span class="page"/> de <span class="topage"/>
                    </div> 
                </div>
            </t>
        </template>
    </data>
</odoo>
