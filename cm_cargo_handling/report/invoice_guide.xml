<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_guide">
        <t t-call="web.html_container">
            <div class="page" style="font-size:15px sans-serif;">
                <div style="page-break-inside:avoid;font-size:15px sans-serif;heigth:45%">
                    <tbody>
                        <div style="width:100%;height:150px;margin-top:10px">
                            <table style="width:25%;float:left">
                                <tr>
                                    <td style="padding-left:10px;padding-right:10px;align:center;padding-top:10px">
                                        <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="width:240.6px;height:75.6px" alt="Logo"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th><strong><span t-esc="data.get('company').name"/></strong></th>
                                </tr>
                                <tr>
                                    <td style="padding-top:3px">
                                        RTN: <span t-esc="data.get('company').company_registry"/>
                                    </td>
                                </tr>
                                <tr style="font-size:10px">
                                    <td style="padding-top:1px">
                                        <span t-esc="data.get('company').street"/>
                                    </td>
                                </tr>
                                <tr style="font-size:10px">
                                    <td style="padding-top:1px">
                                        <span t-esc="data.get('company').street2"/>
                                    </td>
                                </tr>
                                <tr style="font-size:10px">
                                    <td style="padding-top:1px">
                                        <span t-esc="data.get('company').city"/>, <span t-esc="data.get('company').state_id.name"/>
                                    </td>
                                </tr>
                            </table>
                                <table style="float:left;width:34%;font-size:16px">
                                <tr>
                                    <th style="padding-top:3px;font-size:18px"><strong> <b>Reclame su Encomienda en:</b></strong></th>
                                </tr>
                                <tr style="font-size:18px">
                                    <td style="padding-top:3px;font-size:18px" >
                                        <span t-esc="data.get('address_send')"/>
                                    </td>
                                </tr>
                            
                            
                            </table>
                            <table style="float:left;width:38%;height:30%;margin-top:30px;border-collapse: collapse">
                                <tr style="text-align:center;height:15px">
                                    <td style="padding:2px;border:1px solid #000000;height:15px;width:35%"><strong>FECHA</strong></td>
                                    <td style="padding:2px;border:1px solid #000000;height:15px"><strong><span t-esc="data.get('invoice_date')"/></strong></td>
                                </tr>
                                <tr style="text-align:center">
                                    <td style="padding:2px;border:1px solid #000000;width:35%"><strong>No. Factura</strong></td>
                                    <td style="padding:2px;border:1px solid #000000"><strong><span t-esc="data.get('invoice_number')"/></strong></td>
                                </tr>
                                <tr>
                                    <td style="width:40%">
                                        <table style="margin-top:8px;width:100%;border-collapse: collapse">
                                                <t t-if="data.get('modality') == 'upon_delivery'">
                                                    <tr style="text-align:center">
                                                        <td style="padding:3px;border:1px solid #000000;font-size:80%;width:50%">Contado</td>
                                                        <td><input type="checkbox" checked="on"/></td>
                                                    </tr>
                                                    <tr style="text-align:center">
                                                        <td style="padding:3px;border:1px solid #000000;font-size:80%;width:50%">Crédito</td>
                                                        <td><input type="checkbox"/></td>
                                                    </tr>
                                                </t>
                                                <t t-if="data.get('modality') == 'counted'">
                                                    <tr style="text-align:center">
                                                        <td style="padding:3px;border:1px solid #000000;font-size:80%;width:50%">Contado</td>
                                                        <td><input type="checkbox" checked="on"/></td>
                                                    </tr>
                                                    <tr style="text-align:center">
                                                        <td style="padding:3px;border:1px solid #000000;font-size:80%;width:50%">Crédito</td>
                                                        <td><input type="checkbox"/></td>
                                                    </tr>
                                                </t>
                                                <t t-if="data.get('modality') == 'credit'">
                                                    <tr style="text-align:center">
                                                        <td style="padding.3pxborder:1px solid #000000;font-size:80%;width:50%">Contado</td>
                                                        <td><input type="checkbox"/></td>
                                                    </tr>
                                                    <tr style="text-align:center">
                                                        <td style="padding:3px;border:1px solid #000000;font-size:80%;width:50%">Crédito</td>
                                                        <td><input type="checkbox" checked="on"/></td>
                                                    </tr>
                                                </t>
                                            </table>
                                    </td>
                                    <td style="width:50%">
                                        <table style="width:100%;margin-top:8px;border-collapse: collapse">
                                            <tr style="text-align:center">
                                                <td style="padding:5px;border:1px solid #000000;font-size:80%;width:50%"><strong>Plazo (dias)</strong></td>
                                                <td style="padding:5px;border:1px solid #000000;font-size:80%"><strong><span t-esc="data.get('invoice_payment_term')"/></strong></td>
                                            </tr>
                                            <tr style="text-align:center">
                                                <td style="padding:5px;border:1px solid #000000;font-size:80%;width:50%"><strong>Vencimiento</strong></td>
                                                <td style="padding:5px;border:1px solid #000000;font-size:80%"><strong><span t-esc="data.get('invoice_date_due')"/></strong></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="width:100%;margin-bottom:5%;margin-top:1%">
                            <div style="width:55%;text-align:center;font-size:25px"><strong>FACTURA</strong></div>
                            <table style="float:left;border:1px solid #000000;width:55%;margin-bottom:10px;border-collapse: collapse">
                                <th style="background-color:rgb(218, 218, 218);border-right:1px solid #000000;border-bottom:1px solid #000000;text-align:center;padding:2px" colspan="2"><strong>CLIENTE</strong></th>
                                <tr>
                                    <td style="padding:3px">
                                        <span t-esc="data.get('invoice_partner_name')"/>
                                    </td>
                                    <td t-if="data.get('invoice_partner_rtn') != False" style="border-right:1px solid #000000;padding-left:1px">
                                        RTN: <span t-esc="data.get('invoice_partner_rtn')"/>
                                    </td>
                                    <td t-if="data.get('invoice_partner_rtn') == False" style="border-right:1px solid #000000;padding-left:1px">
                                       <br></br>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-left:3px"><span t-esc="data.get('invoice_partner_stree')"/></td>
                                    <td t-if="data.get('invoice_partner_identity')" style="border-right:1px solid #000000;padding-left:3px">
                                        ID: <span t-esc="data.get('invoice_partner_identity')"/>
                                    </td>
                                    <td t-if="not data.get('invoice_partner_identity')" style="border-right:1px solid #000000;padding-left:3px">
                                        <br></br>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border-right:1px solid #000000;padding-left:3px"><span t-esc="data.get('invoice_partner_stree2')"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border-right:1px solid #000000;padding-left:3px"><span t-esc="data.get('invoice_partner_city')"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border-right:1px solid #000000;padding-left:3px"><span t-esc="data.get('invoice_partner_state')"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border-right:1px solid #000000;padding-bottom:12px;padding-left:3px"><span t-esc="data.get('invoice_partner_country')"/></td>
                                </tr>
                            </table>
                            <table style="float:left;width:43%;margin-left:20px;border-collapse: collapse">
                                <tr>
                                    <td>
                                        <table style="width:100%;border:1px solid #000000;border-collapse: collapse">
                                            <th style="background-color:rgb(218, 218, 218);text-align:center;font-size:85%;border:1px solid #000000" colspan="2">Remitente</th>
                                            <tr>
                                                <td style="padding:15px;width:60%"><span t-esc="data.get('sender_name')"/></td>
                                                <td style="padding:15px">ID: <span t-esc="data.get('id_sender')"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <table style="width:100%;border:1px solid #000000;border-top:0px;border-collapse: collapse">
                                            <th style="background-color:rgb(218, 218, 218);text-align:center;font-size:85%;border:1px solid #000000;border-top:0px" colspan="2"><strong>Destinatario</strong></th>
                                            <tr>
                                                <td style="padding:15px;width:60%"><span t-esc="data.get('receiver_name')"/></td>
                                                <td t-if="data.get('id_receiver')" style="padding:15px;">ID: <span t-esc="data.get('id_receiver')"/></td>
                                                <td t-if="not data.get('id_receiver')" style="padding:15px;"/>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <table style="width:100%;margin-top:10%;border-bottom:1px solid black;border-collapse: collapse">
                            <th style="background-color:rgb(218, 218, 218);border:1px solid #000000;font-size:85%;width:11%;bgcolor:#000000"><strong>Numero de Guía</strong></th>
                            <th style="background-color:rgb(218, 218, 218);border:1px solid #000000;font-size:85%;width:4%;bgcolor:#000000"><strong>Cant</strong></th>
                            <th style="background-color:rgb(218, 218, 218);border:1px solid #000000;width:50%;font-size:85%"><strong>Descripción del envio</strong></th>
                            <th style="background-color:rgb(218, 218, 218);border:1px solid #000000;font-size:85%;text-align:right;width:4%"><strong>Gravado</strong></th>
                            <th style="background-color:rgb(218, 218, 218);border:1px solid #000000;font-size:85%;text-align:right;width:4%"><strong>Excento</strong></th>
                            <tr>
                                <td class="text-align:left;font-size:85%">
                                    <span t-esc="data.get('order')"/>
                                </td>
                                <td class="text-align:left;font-size:85%">
                                    <span t-esc="data.get('pieces')"/>
                                </td>
                                <td class="text-align:left;font-size:85%" style="white-space:nowrap">
                                    <span t-esc="data.get('mother_description')[0:95]"/>
                                </td>
                                <td style="font-size:85%;text-align:right">
                                    <span t-esc="'{0:,.2f}'.format(data.get('gravado'))"/>
                                </td>
                                <td style="font-size:85%;text-align:right">
                                    <span t-esc="'{0:,.2f}'.format(data.get('excento'))"/>
                                </td>
                            </tr>
                        </table>
                        <div style="width:100%;margin-top:10px;">
                            <table style="width:100%;border-collapse: collapse">
                                <tr>
                                    <td style="width:45%">
                                        <table style="margin-top:2px;padding:10px;height:100%;border-collapse: collapse">

                                            <tr>
                                                <td style="font-size:85%;width:37%"><strong>CAI</strong></td>
                                                <td style="font-size:80%;width:63%"><span t-esc="data.get('invoice_cai_shot')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;padding-top:8px"><strong>Fecha Limite</strong></td>
                                                <td style="font-size:85%;"><span t-esc="data.get('invoice_expire_cai')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;padding-top:8px"><strong>Rango Autorizado</strong></td>
                                                <td style="font-size:85%;"><span t-esc="data.get('invoice_min_cai')"/><br/>
                                                    <span t-esc="data.get('invoice_max_cai')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;padding-top:8px"><strong>Teléfono</strong></td>
                                                <td style="font-size:85%;">Tel. <span t-esc="data.get('company').phone"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;padding-top:8px"><strong>email</strong></td>
                                                <td style="font-size:85%;"><span t-esc="data.get('company').email"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;"><strong>No. orden de compra exenta</strong></td>
                                                <td style="font-size:85%;"><span t-esc="data.get('invoice_exempt_purchase')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;"><strong>No. constancia exonerado</strong></td>
                                                <td style="font-size:85%;"><span t-esc="data.get('invoice_exonerated_record')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;"><strong>No. registro S.A.G</strong></td>
                                                <td style="font-size:85%;"><span t-esc="data.get('invoice_reg_sag')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-size:85%;margin-top:5px;padding-top:10px;padding-left:37%" colspan="2"><strong>LA FACTURA ES BENEFICIO DE TODOS, EXIJALA</strong></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding-left:3%;width:55%">
                                        <table style="border:1px solid #000000;width:100%;border-collapse: collapse">
                                            <th style="background-color:rgb(218, 218, 218);padding:5px;border-right:1px solid #000000;font-size:85%;width:38%;text-align:center"><strong>TOTAL</strong></th>
                                            <t t-if="data.get('name_currency') == 'USD'">
                                                <th style="background-color:rgb(218, 218, 218);border-right:1px solid #000000;font-size:85%;width:30%;text-align:center"><strong>USD Dolar</strong></th>
                                            </t>
                                            <t t-if="data.get('name_currency') == 'HNL'">
                                                <th style="background-color:rgb(218, 218, 218);border-right:1px solid #000000;font-size:85%;width:30%;text-align:center"><strong>HNL Lempira</strong></th>
                                            </t>
                                            <t t-if="data.get('name_currency') == 'EUR'">
                                                <th style="background-color:rgb(218, 218, 218);border-right:1px solid #000000;font-size:85%;width:30%;text-align:center"><strong>Euros</strong></th>
                                            </t>
                                        </table>
                                        <table style="border:1px solid #000000;border-bottom:0px;width:100%;margin-top:5px;border-collapse: collapse">
                                        <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:center;width:38%"><strong>Exonerado</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><span t-esc="'{0:,.2f}'.format(data.get('exonerado'))"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:center;width:38%"><strong>Exento</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><span t-esc="'{0:,.2f}'.format(data.get('excento'))"/></td>
                                            </tr>
                                            
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;width:38%;text-align:center"><strong>Sub Total</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><span t-esc="'{0:,.2f}'.format(data.get('subtotal'))"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;width:38%;text-align:center"><strong>Descuentos y rebajas concedidos</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><span t-esc="'{0:,.2f}'.format(data.get('discount'))"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;border-bottom:1px solid #000000;border-right:1px solid #000000;font-size:80%;width:38%;text-align:center"><strong>Gravado</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><span t-esc="data.get('name_currency')"/> <span t-esc="'{0:,.2f}'.format(data.get('gravado'))"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;width:38%;text-align:center"><strong>ISV 15%</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><span t-esc="'{0:,.2f}'.format(data.get('taxes'))"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;width:38%;text-align:center"><strong>Total</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><strong><span t-esc="data.get('name_currency')"/> <span t-esc="'{0:,.2f}'.format(data.get('total'))"/></strong></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding:3px;font-size:80%;border-bottom:1px solid #000000;border-right:1px solid #000000;width:38%;text-align:center"><strong>Total lempiras</strong></td>
                                                <td style="font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000;text-align:right;width:30%"><strong><span t-esc="'{0:,.2f}'.format(data.get('conv_total'))"/></strong></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color:rgb(218, 218, 218);padding-top:3px;font-size:85%;border-bottom:1px solid #000000;border-right:1px solid #000000">Tasa Cambio</td>
                                                <td style="font-size:85%;text-align:right;border-bottom:1px solid #000000;border-right:1px solid #000000"><span t-esc="'{0:,.4f}'.format(data.get('rate'))"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding-top:3px;font-size:85%;border-left:1px solid #000000;border-bottom:1px solid #000000;border-right:1px solid #000000;" colspan="2">
                                                    <div style="width:100%">
                                                        <t t-esc="data.get('amount_text')"/> LEMPIRAS
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <table style="width:100%;border:1px solid black;border-collapse: collapse">
                            <tr>
                                <td style="width:25%;align:center">
                                **Original: Cliente
                                </td>
                                <td style="width:35%;">
                                    Punto de Venta: <span t-esc="data.get('origin_name')"/>
                                </td>
                                <td style="width:20%;text-align:right;font-size:22px">
                                    <strong>Telefono:</strong>
                                </td>
                                <td style="width:20%;text-align:center;font-size:22px;padding:2px;text-align:left">
                                    <strong><span style="font-size:22px;color:#920101;" t-esc="data.get('company').phone"/></strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:25%">
                                    **Copia: Obligado tributario emisor
                                </td>
                                <td style="width:35%;">
                                    Agente: <span t-esc="data.get('user_name')"/>
                                </td>
                                <td style="width:20%;text-align:right;font-size:22px">
                                    <strong>WhatsApp:</strong>
                                </td>
                                <td style="width:20%;text-align:center;font-size:22px;padding:2px;text-align:left">
                                    <strong><span style="font-size:22px;color:#920101;" t-esc="data.get('company').whatsapp"/></strong>
                                </td>
                            </tr>                            
                        </table>
                    </tbody>
                </div>
            </div>
        </t>
    </template>

    <template id="main_template_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <t t-call="{{ invoice_order }}"/>
                </div>
            </t>
        </t>
    </template>
</odoo>