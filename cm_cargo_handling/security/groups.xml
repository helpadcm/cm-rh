<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
<!-- ######################################  VENTAS DE CARGA ############################################## -->

<!-- ######################################  CATEGORY ############################################## -->
		<record model="ir.module.category" id="cargo_handling_category">
			<field name="name">Venta de carga</field>
			<field name="description">Cargo permissions</field>
			<field name="sequence">21</field>
		</record>

<!-- ######################################  PRIVILEGE ############################################## -->
		<record id="privilege_user_handling" model="res.groups.privilege">
            <field name="name">Usuario de carga</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_register_payment_handling" model="res.groups.privilege">
            <field name="name">Registrar pago</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_show_all_payments" model="res.groups.privilege">
            <field name="name">Ver pagos</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_discard_guides" model="res.groups.privilege">
            <field name="name">Desechar guias</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_manager_handling" model="res.groups.privilege">
            <field name="name">Encargado de carga</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_sale_handling" model="res.groups.privilege">
            <field name="name">Venta y carga</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_admin_handling" model="res.groups.privilege">
            <field name="name">Administrador de carga</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_group_guides" model="res.groups.privilege">
            <field name="name">Agrupar Guias</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_print_reports" model="res.groups.privilege">
            <field name="name">Imprimir reportes</field>
            <field name="category_id" ref="cargo_handling_category"/>
            <field name="sequence">10</field>
        </record>

<!-- ######################################  GROUPS ############################################## -->
		<record id="group_cargo_handling_user" model="res.groups">
			<field name="name">Venta de carga usuario</field>
            <field name="privilege_id" ref="privilege_user_handling"/>
		</record>

		<record id="group_pago_contable" model="res.groups">
			<field name="name">Registrar Pago Contable</field>
            <field name="privilege_id" ref="privilege_register_payment_handling"/>
		</record>

		<record id="group_todos_los_pagos" model="res.groups">
			<field name="name">Ver Todos los Pagos de Caja</field>
            <field name="privilege_id" ref="privilege_show_all_payments"/>
		</record>

		<record id="group_desechar_guias" model="res.groups">
			<field name="name">Desechar todas las guias</field>
            <field name="privilege_id" ref="privilege_discard_guides"/>
		</record>
		
		 <record id="group_cargo_handling_manager" model="res.groups">
			<field name="name">Venta de carga manager</field>
            <field name="privilege_id" ref="privilege_manager_handling"/>
		</record>

		<record id="group_cargo_handling_ventas" model="res.groups">
			<field name="name">Venta de carga y ventas</field>
            <field name="privilege_id" ref="privilege_sale_handling"/>
		</record>

		<record id="group_guia_cargar_admin" model="res.groups">
			<field name="name">Administrador de guias de carga</field>
            <field name="privilege_id" ref="privilege_admin_handling"/>
		</record>

        <record id="group_guia_cargar_group_invoice" model="res.groups">
			<field name="name">Agrupar guias (Facturacion)</field>
            <field name="privilege_id" ref="privilege_group_guides"/>
		</record>

		<record id="group_guia_cargar_group_reports" model="res.groups">
			<field name="name">Imprimir Reportes</field>
            <field name="privilege_id" ref="privilege_print_reports"/>
		</record>

<!-- ######################################  MANIFIESTO DE CARGA ############################################## -->

<!-- ######################################  CATEGORY ############################################## -->
		<record model="ir.module.category" id="module_category_cargo_manifest">
		    <field name="name">Manifiestos de carga</field>
		    <field name="description">Helps you in the administration of cargo manifest</field>
		    <field name="sequence">26</field>
		</record>

<!-- ######################################  PRIVILEGE ############################################## -->
		<record id="privilege_create_manifest" model="res.groups.privilege">
            <field name="name">Crear Manifiesto</field>
            <field name="category_id" ref="module_category_cargo_manifest"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_show_logs" model="res.groups.privilege">
            <field name="name">Ver bitacoras</field>
            <field name="category_id" ref="module_category_cargo_manifest"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_superuser_manifest" model="res.groups.privilege">
            <field name="name">SuperUsuario</field>
            <field name="category_id" ref="module_category_cargo_manifest"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_add_guides" model="res.groups.privilege">
            <field name="name">Agregar guias</field>
            <field name="category_id" ref="module_category_cargo_manifest"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_remove_guides" model="res.groups.privilege">
            <field name="name">Remover guias</field>
            <field name="category_id" ref="module_category_cargo_manifest"/>
            <field name="sequence">10</field>
        </record>

		<record id="privilege_cancel_guides" model="res.groups.privilege">
            <field name="name">Cancelar guias</field>
            <field name="category_id" ref="module_category_cargo_manifest"/>
            <field name="sequence">10</field>
        </record>

<!-- ######################################  GROUPS ############################################## -->
        <record id="group_cargo_manifest_create" model="res.groups">
			<field name="name">Crear Manifiesto de carga</field>
            <field name="privilege_id" ref="privilege_create_manifest"/>
		</record>

		<record id="group_cargo_manifest_logs" model="res.groups">
			<field name="name">Ver Bitacora en Manifiestos</field>
            <field name="implied_ids" eval="[(4, ref('cm_cargo_handling.group_cargo_manifest_create'))]"/>
            <field name="privilege_id" ref="privilege_show_logs"/>
		</record>

		<record id="group_cargo_manifest_validate_manifest" model="res.groups">
			<field name="name">SuperUsuario Validar Manifiesto</field>
            <field name="implied_ids" eval="[(4, ref('cm_cargo_handling.group_cargo_manifest_create'))]"/>
            <field name="privilege_id" ref="privilege_superuser_manifest"/>
		</record>

		<record id="group_cargo_manifest_add" model="res.groups">
			<field name="name">Agregar Guia de Carga</field>
            <field name="implied_ids" eval="[(4, ref('cm_cargo_handling.group_cargo_manifest_create'))]"/>
            <field name="privilege_id" ref="privilege_add_guides"/>
		</record>

		<record id="group_cargo_manifest_remove" model="res.groups">
			<field name="name">Remover Guias de Carga</field>
            <field name="implied_ids" eval="[(4, ref('cm_cargo_handling.group_cargo_manifest_create'))]"/>
            <field name="privilege_id" ref="privilege_remove_guides"/>
		</record>

		<record id="group_cargo_manifest_cancel" model="res.groups">
			<field name="name">Cancelar Manifiestos</field>
            <field name="implied_ids" eval="[(4, ref('cm_cargo_handling.group_cargo_manifest_create'))]"/>
            <field name="privilege_id" ref="privilege_cancel_guides"/>
		</record>

<!-- #############################  CARGO HANDLING RULE  ########################################## -->

		 <record id="user_cargo_hardling_rule" model="ir.rule">
            <field name="name">Usuario Cargo Handling</field>
            <field name="model_id" ref="cm_cargo_handling.model_sale_order_handling"/>
            <field name="domain_force">['|','|',('origin_id', '=', user.station_id.id),('user_id', '=', user.id),('destination_id', '=', user.station_id.id)]</field>
            <field name="groups" eval="[(4, ref('cm_cargo_handling.group_cargo_handling_user'))]"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_read" eval="True"/>
        </record>

		<record id="manager_cargo_hardling_rule" model="ir.rule">
            <field name="name">Manager Cargo Handling</field>
            <field name="model_id" ref="cm_cargo_handling.model_sale_order_handling"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_cargo_handling.group_cargo_handling_manager'))]"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_read" eval="True"/>
        </record>

	</data>
</odoo>



