<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_attendance_employee_report_form" model="ir.ui.view">
        <field name="name">hr.attendance.employees.report.form</field>
        <field name="model">hr.attendance.employees.report</field>
        <field name="arch" type="xml">
            <form string="Employee Attendance Report">
                <sheet>
                    <group>
                        <field name="email" string="Correo electrónico"/>
                        <field name="date_from" string="Fecha desde"/>
                        <field name="date_to" string="Fecha hasta"/>
                        <field name="department_id" string="Departamento"/>
                        <field name="employee_ids" string="Empleados"/>
                        <field name="company_id" string="Compañía"/>
                    </group>
                    <footer>
                        <button string="Generar Reporte" type="object"
                                name="export_to_excel_for_multiple_employees" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_attendance_report_action" model="ir.actions.act_window">
        <field name="name">Employee Attendance Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.attendance.employees.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_hr_reporting_timesheet"
            name="Reporte de Asistencia"
            parent="hr_attendance.menu_hr_attendance_reporting"
            sequence="10"
            groups="hr_attendance.group_hr_attendance_officer"
            action="hr_attendance_report_action"/>
</odoo>
