<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_attendance_employee_report_form" model="ir.ui.view">
        <field name="name">hr.attendance.employee.report.form</field>
        <field name="model">hr.attendance.employee.report</field>
        <field name="arch" type="xml">
            <form string="Employee Attendance Report">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="employee_id"/>
                        <field name="department_id"/>
                        <field name="company_id"/>
                        <field name="apply_extra_hour"/>
                    </group>
                    <footer>
                        <button string="Generate Report" type="object"
                                name="get_report_data" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_attendance_report_action" model="ir.actions.act_window">
        <field name="name">Employee Attendance Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.attendance.employee.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_hr_reporting_timesheet"
            name="Reporte de Asistencia"
            parent="hr_attendance.menu_hr_attendance_reporting"
            sequence="10"
            groups="hr_attendance.group_hr_attendance_officer"
            action="hr_attendance_report_action"/>
</odoo>
