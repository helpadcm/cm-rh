<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_internal_category_tree" model="ir.ui.view">
    <field name="name">internal.portal.category.tree</field>
    <field name="model">internal.portal.category</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code" />
        <field name="url_address" widget="url"/>
      </list>
    </field>
  </record>

