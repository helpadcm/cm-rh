  <record id="internal_portal_category_kanban" model="ir.ui.view">
    <field name="name">internal.portal.category.kanban</field>
    <field name="model">internal.portal.category</field>
    <field name="arch" type="xml">
        <kanban create="false">
           <field name="name"/>
           <field name="code"/>
          <field name="name"/>

          <templates>
              <t t-name="card">
                  <div class="oe_kanban_card">
                      <a type="object"
                        name="action_view_documents"
                        style="text-decoration:none;color:inherit;">

                          <div style="font-size:20px;color:#0d6efd;" class="text-center p-3">
                              <i class="fa fa-folder-open fa-3x" title="Categoría"/>
                              <br/>
                              <strong>
                                  <field name="name"/>
                              </strong>
                          </div>

                      </a>
                  </div>
              </t>
          </templates>
      </kanban>
    </field>
</record>
            
  <record id="action_internal_category" model="ir.actions.act_window">
    <field name="name">Categorias</field>
    <field name="res_model">internal.portal.category</field>
    <field name="view_mode">list</field>
  </record>

  <record id="action_internal_category_board" model="ir.actions.act_window">
    <field name="name">Categorias</field>
    <field name="res_model">internal.portal.category</field>
    <field name="view_mode">kanban</field>
  </record>
</odoo>
