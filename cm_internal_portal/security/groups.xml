        </record>

<!-- ######################################  GROUPS ############################################## -->
		<record id="group_internal_portal_user" model="res.groups">
			<field name="name">Usuario Portal Interno</field>
            <field name="privilege_id" ref="privilege_access_internal_portal"/>
		</record>

		<record id="group_internal_portal_manager" model="res.groups">
			<field name="name">Administrador Portal Interno</field>
            <field name="privilege_id" ref="privilege_access_internal_portal"/>
		</record>

