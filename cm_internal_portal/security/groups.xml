		<record model="ir.module.category" id="internal_portal_category">
			<field name="name">Portal Interno</field>
			<field name="description">Accesos para el portal interno</field>
			<field name="sequence">21</field>
		</record>

<!-- ######################################  PRIVILEGE ############################################## -->
