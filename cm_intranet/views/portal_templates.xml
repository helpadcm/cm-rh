<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_portal_intranet" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/cm_intranet/static/src/img/doc_intra.png'"/>
                <t t-set="title">Documentos RRHH</t>
                <t t-set="text">Documentos Informativos RRHH</t>
                <t t-set="url" t-value="'/intranet_rrhh/documents'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_documents" name="Portal Documents">
        <t t-call="website.layout">
        <div class="container mt-4">
            <h2><strong>Documentos</strong></h2>

            <div class="row mt-3">
                <t t-foreach="documents" t-as="doc">
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 bg-success p-2 bg-opacity-50" style="border: 4px solid black">
                            <t t-if="doc.file_type == 'image'">
                                <img class="card-img-top"
                                    t-att-src="'/portal/documents/%s/preview' % doc.id"
                                    style="object-fit: cover; max-height: 200px;"/>
                            </t>

                            <t t-elif="doc.file_type == 'pdf'">
                                <iframe
                                t-att-src="'/portal/documents/%s/preview' % doc.id"
                                style="width:100%; height:200px;"
                                frameborder="0">
                                </iframe>
                            </t>

                            <t t-else="">
                                <div class="card-body text-center">
                                <i class="fa fa-file fa-3x mb-2"></i>
                                </div>
                            </t>

                            <div class="card-body">
                                <h5 class="card-title">
                                    <t t-esc="doc.name"/>
                                </h5>

                                <p class="card-text">
                                    <t t-esc="doc.description"/>
                                </p>

                                <!-- 🔎 ABRIR SIN DESCARGAR -->
                                <a class="btn btn-outline-primary btn-sm"
                                    t-att-href="'/portal/documents/%s/preview' % doc.id"
                                    target="_blank">
                                    Ver
                                </a>

                                <!-- ⬇️ DESCARGAR -->
                                <t t-if="doc.allow_download">
                                    <a class="btn btn-outline-secondary btn-sm"
                                        t-att-href="'/portal/documents/%s/download' % doc.id">
                                        Descargar
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
        </t>
    </template>
</odoo>
