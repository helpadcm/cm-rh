<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_category_tree" model="ir.ui.view">
    <field name="name">intranet.document.category.tree</field>
    <field name="model">intranet.document.category</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_category_form" model="ir.ui.view">
    <field name="name">intranet.document.category.form</field>
    <field name="model">intranet.document.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
            
  <record id="action_intranet_category" model="ir.actions.act_window">
    <field name="name">Categories</field>
    <field name="res_model">intranet.document.category</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
