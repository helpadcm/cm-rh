<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_generalledger_custom" inherit_id="accounting_pdf_reports.report_general_ledger">
            <xpath expr="//div[@class='row mt32']" position="inside">
	    	    <div class="col-xs-4">
					<strong>Partners:</strong>
					<p t-if="not partner_ids" >All</p>
					<p t-if="partner_ids" t-esc="', '.join([ lt.name or '' for lt in partner_ids ])"/>
				</div>
				<div class="col-xs-4">
					<strong>Analitics:</strong>
						<p t-if="not analytic_account_ids" >All</p>
						<p t-if="analytic_account_ids" t-esc="', '.join([ lt.name or '' for lt in analytic_account_ids ])"/>
				</div>
	    	</xpath>
          	<xpath expr="//tr[@class='text-center']" position="replace">
				<tr class="text-center">
					<th>No.</th>
					<th>Date</th>
					<th>JRNL</th>
					<th>Partner</th>
					<th>Analytic</th>
					<th>Ref</th>
					<th>Move</th>
					<th>Entry Label</th>
					<th>Debit</th>
					<th>Credit</th>
					<th>Balance</th>
					<th groups="base.group_multi_currency">Currency</th>
				</tr>       
	    	</xpath>
			<xpath expr="//div[@class='row mb32']" position="inside">
				<div class="col-xs-4">
					<strong>Group By:</strong>
					<p t-if="data.get('group_ledger') == 'partner'">Partner</p>
					<p t-if="data.get('group_ledger') == 'analytic'">Analytic</p>
				</div>
			</xpath>
	     	<xpath expr="//tbody" position="replace">
				<tbody>
					<t t-foreach="Accounts" t-as="account">
						<tr style="font-weight: bold;">
							<td colspan="8">
								<span style="color: white;" t-esc="'..'"/>
								<span t-esc="account['code']"/>
								<span t-esc="account['name']"/>
							</td>
							<td class="text-right">
								<span t-esc="account['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
							</td>
							<td class="text-right">
								<span t-esc="account['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
							</td>
							<td class="text-right">
								<span t-esc="account['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
							</td>
							<td class="text-right" groups="base.group_multi_currency">
								<span t-esc="account.get('amount_currency')"/>
								<span t-esc="account.get('currency_code')"/>
				 			</td>
						</tr>
						<t t-foreach="account['move_lines']" t-as="line">
							<t t-if="line['lid']&gt;0">
								<tr>
									<td></td>
									<td><span t-esc="line['ldate']"/></td>
									<td><span t-esc="line['lcode']"/></td>
									<td><span t-esc="line['partner_name']"/></td>
		                         	<td><span t-esc="line.get('analytic_name')"/></td>
									<td><span t-if="line['lref']" t-esc="line['lref']"/></td>
									<td><span t-esc="line['move_name']"/></td>
									<td><span t-esc="line['lname']"/></td>
									<td class="text-right">
										<span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</td>
									<td class="text-right">
										<span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</td>
									<td class="text-right">
										<span t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</td>
									<td class="text-right" groups="base.group_multi_currency">
										<span t-esc="line.get('amount_currency')"/>
										<span t-esc="line.get('currency_code')"/>
									</td>	
				    			</tr>
							</t>
							<t t-if="line['lid']==0">
								<tr>
									<th colspan="2"><span t-esc="line['ldate']"/></th>
									<th><span t-esc="line['lcode']"/></th>
									<th><span t-esc="line['partner_name']"/></th>
									<th><span t-esc="line.get('analytic_name')"/></th>
									<th><span t-if="line['lref']" t-esc="line['lref']"/></th>
									<th><span t-esc="line['move_name']"/></th>
									<th><span t-esc="line['lname']"/></th>
									<th class="text-right">
								
										<span  t-if="init_balance==1"  t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</th>
									<th class="text-right">
										<span  t-if="init_balance==1" t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</th>
									<th class="text-right">
										<span  t-if="init_balance==1" t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</th>
									<th class="text-right" groups="base.group_multi_currency">
										<span  t-if="init_balance==1" t-esc="line.get('amount_currency')"/>
										<span  t-if="init_balance==1" t-esc="line.get('currency_code')"/>
									</th>	
								</tr>
							</t>
							<t t-if="line['lid']==-1">
								<tr>
									<th colspan="2"><span t-esc="line['ldate']"/></th>
									<th><span t-esc="line['lcode']"/></th>
									<th><span t-esc="line['partner_name']"/></th>
									<th><span t-esc="line.get('analytic_name')"/></th>
									<th><span t-if="line['lref']" t-esc="line['lref']"/></th>
									<th><span t-esc="line['move_name']"/></th>
									<th><span t-esc="line['lname']"/></th>
									<th class="text-right">
										<span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</th>
									<th class="text-right">
										<span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</th>
									<th class="text-right">
										<span t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
									</th>
									<th class="text-right" groups="base.group_multi_currency">
										<span t-esc="line.get('amount_currency')"/>
										<span t-esc="line.get('currency_code')"/>
									</th>	
								</tr>
							</t>
						</t>
					</t>
				</tbody> 
			</xpath>
        </template>
    </data>
</odoo>


