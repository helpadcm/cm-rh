<odoo>
    <data>
        <record id="view_wizard_analytic_ledger" model='ir.ui.view'>
            <field name="name">Cuentas Analiticas</field>
            <field name="model">account.analytic.report.ledger</field>
            <field name="arch" type="xml">
                <form string='Cuentas Analiticas'>
                    <group>
                        <group>
                            <field name="initial_date" required="1"/>
                            <field name="group_by"/>
                        </group>
                        <group>
                            <field name="final_date" required="1"/>
                        </group>
                    </group>
                    <group string="Filtros">
                        <field name="account_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Cuentas contables"/>
                        <field name="analytic_account_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Cuentas analiticas"/>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Seleccione contactos"/>
                    </group>
                    <footer>
                        <button name="print_excel" class="oe_highlight" string="Imprimir" type="object"/>
                        <button special="cancel" string="Cancelar"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="action_wizard_analytic_ledger" model="ir.actions.act_window">
            <field name="name">Cuentas Analiticas</field>
            <field name="res_model">account.analytic.report.ledger</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_wizard_analytic_ledger"/>
            <field name="target">new</field>
            <field name="binding_model_id" ref="account.model_account_account" />
            <field name="binding_type">report</field>
        </record>

        <menuitem id="menu_analytic_account_ledger"
              name="Cuentas Analiticas"
              sequence="50"
              action="action_wizard_analytic_ledger"
              parent="accounting_pdf_reports.menu_finance_audit_reports"/>

    </data>
</odoo>