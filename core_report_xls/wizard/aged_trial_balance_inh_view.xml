<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
		<record id="aged_trial_balance_form_inherit" model="ir.ui.view">
			<field name="name">aged.trial.balance.form.inherit</field>
			<field name="model">account.aged.trial.balance</field>
			<field name="inherit_id" ref="accounting_pdf_reports.account_aged_balance_view"/>
			<field name="arch" type="xml">
				<xpath expr="//form" position="replace">
                    <form>
                        <group>
                            <group>
                                <field name="date_from"/>
                                <field name="result_selection" widget="radio" invisible="context.get('hide_result_selection')"/>
                                <field name="target_move" widget="radio"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="period_length"/>
                                <field name="currency_id" options="{'no_create': True}" required="1"/>
                            </group>
                        </group>
                        <newline/>
                        <group>
                            <field name="partner_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                        </group>

                        <footer>
                            <button name="check_report" class="oe_highlight"
                                    string="Imprimir" type="object"/>
                            <button string="Cancelar" class="btn btn-default" special="cancel"/>
                        </footer>
                    </form>
				</xpath>
			</field>
		</record>
    </data>
</odoo>


