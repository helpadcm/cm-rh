<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

		<!-- <record id="action_deposit_validate_object_submit" model="ir.values">
			<field name="name">Validar</field>
			<field name="model_id" ref="banks.model_banks_deposit"/>
			<field name="model">banks.deposit</field>
			<field name="key2">client_action_multi</field>
			<field eval="'ir.actions.server,%d'%action_deposit_validate" name="value"/>
        </record> -->

		<record model="ir.ui.view" id="view_deposit_form">
			<field name="name">deposit.form</field>
			<field name="model">banks.deposit</field>
			<field name="arch" type="xml">
				<form string="Debits">
					<header>
						<button name="anulate_draft_voucher" string="Invalidar Voucher" type="object" invisible="state != 'draft'" groups="cm_banks.group_banks_banks_anullation"  confirm="Esta seguro de querer invalidar este voucher?"/>	
						<button name="action_validate" type="object" string="Validar" invisible="state != 'draft'" class="oe_highlight"/>
						<button name="unreconciliate_deposit" string="Desconciliar" type="object" invisible="state != 'validated'" confirm="Esta seguro de querer desconciliar este deposito?"/>
						<button name="reset_to_draft" type="object" string="Enviar a Borrador" invisible="state != 'anulated'" groups="cm_banks.group_banks_banks_reset"  class="oe_highlight"/>
						<field name="state" widget="statusbar" statusbar_colors='{"validated":"blue"}'/>
                  	</header>
                   	<sheet string="Voucher Contable">
						<h1><field name="number"  class="oe_inline" readonly='1'/> </h1>
						<group>
							<group>
								<field name="journal_id" options="{'no_quick_create':True,'no_create_edit':True,'limit':1}" domain="[('allow_creditdebit','=',True)]" readonly="state != 'draft' or was_unreconcilied == True" />
								<field name="doc_type" readonly="state != 'draft' or was_unreconcilied == True"/>
								<field name="total"  widget="monetary" readonly="state != 'draft'"/>
							</group> 
							<group>
								<field name="date" readonly="state != 'draft'" />
								<field name="currency"  options="{'no_quick_create':True,'no_create_edit':True,'limit':1}" readonly="1"/>
								<field name="total_equivalent" readonly='1'/>
							</group> 
            	     	</group>
						<group>    
							<field name="name" readonly="state != 'draft'"/>
						</group> 
						<notebook colspan="4">
                        	<page string="Entrada de Voucher">
								<group col="4" colspan="4"> 
									<field name="pay_comp_currency"/>
								</group>
								<field name="mcheck_ids" widget="one2many_list" readonly="state != 'draft'">
									<tree editable="bottom">
										<field name="account_id" options="{'no_quick_create':True,'no_create_edit':True,'limit':1}"/>
										<field name="name"/>
										<field name="name2"/>
										<field name="partner_id" options="{'no_quick_create':True,'no_create_edit':True,'limit':1}"/>
										<field name="chqmanalitics" options="{'no_quick_create':True,'no_create_edit':True,'limit':1}" string="Analiticas"/>
										<field name="amount" sum="amount"/>
										<field name="type"/>
									</tree>
								</field>
							</page>
                        	<page string="Apuntes contables" invisible="state not in ['validated','anulated']">
								<field name="move_ids" readonly="1">
									<tree string="Apuntes contables">
										<field name="move_id"/>
										<field name="date"/>
										<field name="statement_id"/>
										<field name="account_id"/>
										<field name="name"/>
										<field name="debit" sum="Debit"/>
										<field name="credit" sum="Credit"/>
									</tree>
								</field>
							</page>
		       				<page string="Pago de Clientes" invisible="1">
                            	<field name="deposits"  widget="many2many" context="{'set_editable':True}" domain="[('deposit_id','=',False),('payment_type','=','inbound'),('journal_id.comnsolidate_deposit','=',True),('partner_type','=','customer')]" >
									<form>
										<group col="4" colspan="4"> 
											<field name="date"/>
										</group> 
									</form>	                               
									<tree string="Clients Payment"  >
										<field name="date"/>
										<field name="partner_id" />
										<field name="name" />
										<field name="journal_id" />
										<field name="amount" sum="amount"/>
										<field name="state"/>
									</tree>
				
                            	</field>
                        	</page>
							<page string="Otra Informacion" invisible="state not in ['validated']">
								<group col="4" colspan="4"> 
									<field name="move_id" string="Asiento Contable" readonly="1"/>
								</group> 
							</page>
                    	</notebook>
						<group >
	   						<group class="oe_subtotal_footer oe_right">
                                <field name="rest_credit" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state != 'draft'"/>  
            				</group>
							<field name="obs" invisible="state != 'anulated'"/>
							<field name="number"  class="oe_inline" invisible='1'/>     
							<field name="was_unreconcilied" invisible='1'/>													
						</group>
                  	</sheet>
					<div class="oe_chatter">
						<field name="message_ids" widget="mail_thread"/>
					</div>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="view_deposit_tree">
            <field name="name">deposit.tree</field>
            <field name="model">banks.deposit</field>
            <field name="arch" type="xml">
                <tree string="Depositos" default_order="state">  
					<field name="number" />               
					<field name="date" />
					<field name="journal_id"/>
					<field name="name"/>
					<field name="total" sum='total'/>
					<field name="state"/>
                </tree>
            </field>
        </record>
	
		<record model="ir.ui.view" id="view_banks_deposit_search">
			<field name="name">deposit.search</field>
			<field name="model">banks.deposit</field>
			<field name="arch" type="xml">
				<search>
					<field name="number"/>
					<field name="journal_id"/>
					<group expand="1" string="Group By">
						<filter string="Fecha" name="date_group"  context="{'group_by':'date'}"/>
						<filter string="Estado" name="state_group" context="{'group_by':'state'}"/>
						<filter string="Diario" name="journal_group" context="{'group_by':'journal_id'}"/>
					</group>	
				</search>
			</field>
		</record>
	
		<record id="deposit_action_form" model="ir.actions.act_window">
			<field name="name">Depositos</field>
			<field name="res_model">banks.deposit</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				<p class="oe_view_nocontent_create">
					Click para agregar un nuevo deposito.
				</p>
				<p>
					With just a quick glance on the Odoo Deposit screen, you
					can easily find all the information about your each day debit or credit;					
				</p>
			</field>
		</record>

    </data>
</odoo>
