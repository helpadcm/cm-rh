<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
		<record model="ir.ui.view" id="view_account_payment_vendor_form">
			<field name="name">account.payment.form.inherit.costumer</field>
			<field name="model">account.payment</field>
			<field name="inherit_id" ref="account.view_account_payment_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='journal_id']" position="after">
					<field name="was_unreconcilied" invisible="1"/>
				</xpath>

				<xpath expr="//field[@name='journal_id']" position="after" string='Payment type'>
					<field name="pay_method_type"  readonly="was_unreconcilied == True or state != 'draft'" invisible="partner_type == 'customer'"/>
				</xpath>
				<field name="memo" position="after">
					<field name="total_usd" invisible="1"/>
				</field>
			</field>
		</record>

		<record model="ir.ui.view" id="view_account_payment_tree_inherit">
			<field name="name">account.payment.tree.inherit</field>
			<field name="model">account.payment</field>
			<field name="inherit_id" ref="account.view_account_payment_tree"/>
			<field name="arch" type="xml">
				<field name="amount_signed" position="replace">
					<field name="total_usd" sum="Total USD"/>
				</field>
				<field name="amount_company_currency_signed" position="attributes">
					<attribute name="string">HNL</attribute>
				</field>
			</field>
		</record>
    </data>
</odoo>
