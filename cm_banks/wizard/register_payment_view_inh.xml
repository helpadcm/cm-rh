<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
		<record model="ir.ui.view" id="view_account_payment_invoices_form_inherit">
			<field name="name">account.payment.invoices.inherit</field>
			<field name="model">account.payment.register</field>
			<field name="inherit_id" ref="account.view_account_payment_register_form"/>
			<field name="arch" type="xml">
				<field name="line_ids" position="replace">
					<h1><field name="next_number" readonly="1" force_save="1"/></h1>
				</field>

				<xpath expr="//field[@name='payment_method_line_id']" position="replace">
					<field name="pay_method_type" invisible="partner_type == 'customer'"/>
					<field name="analytic_account_id" invisible="journal_id == False or partner_type == 'customer'" options="{'no_quick_create':True,'no_create_edit':True,'no_open':True}" groups="analytic.group_analytic_accounting"/>
					<field name="payment_method_line_id" invisible="1"/>
				</xpath>

				<group name="group3" position="replace">
					<group name="group3" invisible="payment_difference == 0.0 or early_payment_discount_mode or not can_edit_wizard or can_group_payments and not group_payment">
                            <label for="payment_difference"/>
                            <div>
                                <field name="payment_difference"/>
                                <field name="payment_difference_handling" widget="radio" nolabel="1"/>
                                <div invisible="hide_writeoff_section or payment_difference_handling == 'open'">
                                    <label for="writeoff_account_id" invisible="1" string="Post Difference In" class="oe_edit_only"/>
                                    <field name="writeoff_account_id"
                                           string="Post Difference In"
                                           options="{'no_create': True}"
                                           invisible="1"/>
                                    <label for="writeoff_label"
                                           class="oe_edit_only"
                                           string="Label"
                                           invisible="1"/>
                                    <field name="writeoff_label"
                                           invisible="1"/>
                                </div>
                            </div>
                        </group>
				</group>

				<xpath expr="//group" position="after">
					<field name="partner_id"/>
					<notebook>
						<page string="Lineas de Pago">
							<field name="line_ids">
								<tree delete="false" create="false">
									<field name="move_id" readonly="1"/>
									<field name="account_id" readonly="1"/>
									<field name="date" readonly="1"/>
									<field name="date_maturity" readonly="1"/>	
									<field name="amount_residual" readonly="1"/>
									<field name="reconciled"/>
								</tree>
							</field>
							<field name="payment_line_ids" invisible="1" widget="one2many" context="{'partner':partner_id}">
								<tree string="Lines" editable="bottom" create="false" delete="false">
									<field name="move_line_id" options="{'no_open': True}" readonly="1" force_save="1"/>
									<field name="account_id" optional="hide" readonly="1" force_save="1"/>
									<field name="chqmanalitics" options="{'no_quick_create':True,'no_create_edit':True,'limit':1}" string="Analitica"/>
									<field name="date_original" readonly="1" optional="hide" force_save="1"/>
									<field name="date_due" optional="hide" readonly="1" force_save="1"/>
									<field name="currency_id" column_invisible="1"/>
									<field name="amount_original" readonly="1" force_save="1"/>
									<field name="amount_unreconcilied" readonly="1" force_save="1"/>
									<field name="reconcile"/>
									<field name="amount" force_save="1" readonly="reconcile" sum="Total"/>
								</tree>
							</field>
						</page>
						<page string="Distribuir Saldo" invisible="payment_difference_handling != 'reconcile'">
							<separator string="Diferencia" />
							<field name="writeoff_amount" widget="monetary"/>
							<separator string="Distribucion de cuentas"/>
							<field name="write_off_lines">
								<tree editable="bottom">
									<field name="account_id" domain="[('deprecated','=',False)]" options="{'no_create': True}"/>
									<field name="partner_id" options="{'no_create': True}"/>
									<field name="analytic_account_id" options="{'no_create': True}"/>
									<field name="description"/>
									<field name="currency_id" column_invisible="1"/>
									<field name="debit"/>
									<field name="credit"/>
								</tree>
							</field>
						</page>
					</notebook>
				</xpath>
			</field>
		</record>
    </data>
</odoo>
