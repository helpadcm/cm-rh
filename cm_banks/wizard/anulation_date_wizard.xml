<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<data>
		<record model="ir.ui.view" id="banks_anullation_date_wizard_form">
			<field name="name">Anullation Date</field>
			<field name="model">anullation_date_wizard</field>
			<field name="arch" type="xml">
				<form string="Fecha de Anulacion">
					<sheet>
						<group>
							<group>
								<field name="only_one"/>
								<field name="date" invisible="0"/>
							</group>
							<group>
								<field name="journal_id" invisible="1"/>
								<field name="debit_credit_id" domain="[('state','=','validated'),('doc_type','=','credit'),('journal_id','=',journal_id),('date','&lt;',date),('linked_voucher','=',False)]" invisible="only_one == False" required="only_one != False"/>
							</group>
						</group>
					</sheet>
					<footer>
						<button string="Aceptar" name="anulate_doc" type="object" context="{'only_one':only_one,'debit_credit_id':debit_credit_id}" class="oe_highlight"/>
						<button string="Cancelar" class="oe_link" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="anullation_date_action" model="ir.actions.act_window">
			<field name="name">Fecha de Anulacion</field>
			<field name="res_model">anullation_date_wizard</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="banks_anullation_date_wizard_form"/> 
			<field name="target">new</field>
		</record>
		
	</data>
</odoo>
