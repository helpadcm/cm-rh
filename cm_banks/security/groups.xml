<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
		 <record model="ir.module.category" id="module_category_banks">
		    <field name="name">Bancos</field>
		    <field name="description">Helps you carry out accounting operations.</field>
		    <field name="sequence">20</field>
		</record>
		
		<record id="group_check_manager" model="res.groups">
			<field name="name">Checks Manager</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>
		
		<record id="group_debit_credit_deposit" model="res.groups">
			<field name="name">Debitos, Creditos y depositos</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>


		<record id="group_deposit" model="res.groups">
			<field name="name">Depositos</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

		<record id="group_banks_banks_transferences" model="res.groups">
			<field name="name">Transacciones bancarias</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

		<record id="group_banks_archive_deposit" model="res.groups">
			<field name="name">Archivar Depositos</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>
		

		<record id="group_banks_banks_mostrar_check_writting" model="res.groups">
			<field name="name">Mostrar Writte Checks</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

		<record id="group_banks_banks_anullation" model="res.groups">
			<field name="name">Permitir Anular</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

		
		<record id="group_banks_banks_reset" model="res.groups">
			<field name="name">Re-abrir transacciones bancarias</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>


		<record id="group_banks_sequence_edit" model="res.groups">
			<field name="name">Editar Secuencia</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

		<record id="group_banks_user" model="res.groups">
			<field name="name">Usuarios Bancos</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

		<record id="group_banks_manager" model="res.groups">
			<field name="name">Administrador Bancos</field>
			<field name="category_id" ref="module_category_banks"/>
		</record>

<!-- ####################################  DEBIT / CREDIT RULES  #################################### -->
		<record id="debit_credit_user_rule" model="ir.rule">
            <field name="name">Regla usuario Debitos/Creditos</field>
            <field name="model_id" ref="cm_banks.model_debit_credit"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cm_banks.group_banks_user'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="debit_credit_manager_rule" model="ir.rule">
            <field name="name">Regla Administrador Debitos/Creditos</field>
            <field name="model_id" ref="cm_banks.model_debit_credit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_banks.group_banks_manager'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

<!-- ####################################  MCHECKS RULES  #################################### -->
		<record id="mcheks_user_rule" model="ir.rule">
            <field name="name">Regla usuario pagos miscelaneos</field>
            <field name="model_id" ref="cm_banks.model_mcheck_mcheck"/>
            <field name="domain_force">[('user_creator', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cm_banks.group_banks_user'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="mcheks_manager_rule" model="ir.rule">
            <field name="name">Regla Administrador pagos miscelaneos</field>
            <field name="model_id" ref="cm_banks.model_mcheck_mcheck"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_banks.group_banks_manager'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

<!-- ####################################  DEPOSIT RULES  #################################### -->
		<record id="deposit_user_rule" model="ir.rule">
            <field name="name">Regla usuario depositos</field>
            <field name="model_id" ref="cm_banks.model_banks_deposit"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cm_banks.group_banks_user'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="deposit_manager_rule" model="ir.rule">
            <field name="name">Regla Administrador depositos</field>
            <field name="model_id" ref="cm_banks.model_banks_deposit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_banks.group_banks_manager'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
	</data>
</odoo>


