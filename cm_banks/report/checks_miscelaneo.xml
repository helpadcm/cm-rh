<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="check_template">
            <t t-call="web.html_container">
                <t t-foreach="info_account" t-as="o">
                    <div class="page">
                        <table style="width:85%;margin-left:7.5%">
                            <tr>
                                <td><h3><span t-esc="o.get('company_name')"/></h3></td>
                            </tr>
                            <tr>
                                <td>
                                    <h4>BANCO: <span t-esc="o.get('bank_name')"/></h4>
                                </td>
                                <td style="text-align:right;font-size:16px">
                                <strong>CHEQUE No.<span t-esc="o.get('check_number')"/></strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>