<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="external_request_tree_view" model="ir.ui.view">
            <field name="name">Personas Externas</field>
            <field name="model">cm.ticket.request.external</field>
            <field name="arch" type="xml">
                <tree string="Externos" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="id_number" required="1"/>
                    <field name="email" required="1"/>
                    <field name="phone" />
                    <field name="class_name" />
                    <field name="nationality" />
                    <field name="birthdate" />
                </tree>
            </field>
        </record>

        <record id="program_request_tree_view" model="ir.ui.view">
            <field name="name">Programas</field>
            <field name="model">cm.ticket.request.program</field>
            <field name="arch" type="xml">
                <tree string="Programas" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="default_program" />
                </tree>
            </field>
        </record>

        <record id="external_request_cm" model="ir.actions.act_window">            
            <field name="name">Externos</field>
            <field name="res_model">cm.ticket.request.external</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

        <record id="program_request_cm_action" model="ir.actions.act_window">            
            <field name="name">Programas</field>
            <field name="res_model">cm.ticket.request.program</field>
            <field name="view_mode">tree</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>