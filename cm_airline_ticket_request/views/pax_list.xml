<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="pax_form_view" model="ir.ui.view">
            <field name="name">Solicitud</field>
            <field name="model">cm.ticket.request.line</field>
            <field name="arch" type="xml">
                <form string="Soicitud de Boletos" create="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="user_external" invisible="1"/>
                                <field name="passenger_type" required="1" readonly="state != 'draft'"/>
                                <field name="employee_id" required="passenger_type == 'internal'" invisible="passenger_type != 'internal'" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                                <field name="external_user_id" required="passenger_type == 'external'" invisible="passenger_type != 'external'" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                                <field name="name" invisible="passenger_type != 'manual'" required="passenger_type == 'manual'"/>
                                <field name="email" readonly="state != 'draft'" required="passenger_type == 'manual'"/>
                                <field name="phone" readonly="state != 'draft'" required="passenger_type == 'manual'"/>
                                <field name="birthdate" readonly="state != 'draft'" required="passenger_type == 'manual'"/>
                                <field name="user_id" invisible="1" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="id_number" readonly="state != 'draft'" required="passenger_type == 'manual'"/>
                                <field name="nationality" readonly="state != 'draft'" required="passenger_type == 'manual'"/>
                                <field name="more_luggage" readonly="state != 'draft'"/>
                                <field name="class_name" invisible="not more_luggage" readonly="state != 'draft'" required="more_luggage"/>
                                <field name="pnr" invisible="state in ['send','draft']" readonly="state != 'received'"/>
                                <field name="only_pnr" invisible="1"/>
                                <field name="split" invisible="state in ['finalized','canceled']"/>
                                <field name="state" invisible="1"/>
                            </group>
                        </group>
                        <group string="Documentos">
                            <group>
                                <field name="id_file" readonly="state != 'draft'" required="1" filename="id_file_name" widget="binary"/>
                                <field name="id_file_name" invisible="1"/>
                            </group>
                            <group>
                                <field name="pnr_file" readonly="state != 'received'" required="not only_pnr and state == 'received' and not split" invisible="only_pnr or state in ['draft','send']" filename="pnr_file_name" widget="binary"/>
                                <field name="pnr_file_name" invisible="1"/>
                            </group>
                        </group>
                        <label for="description" string="Breve descripcion acerca de la razon del pase o descuento"/>
                        <field name="description" required="1" readonly="state != 'draft'"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="pax_tree_view" model="ir.ui.view">
            <field name="name">Solicitudes</field>
            <field name="model">cm.ticket.request.line</field>
            <field name="arch" type="xml">
                <list string="Solicitudes" create="false" delete="false">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone" />
                    <field name="pnr" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="pax_request_cm" model="ir.actions.act_window">            
            <field name="name">Solicitudes</field>
            <field name="res_model">cm.ticket.request.line</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>