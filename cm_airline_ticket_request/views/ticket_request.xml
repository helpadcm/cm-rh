<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ticket_request_cm_form_view" model="ir.ui.view">
            <field name="name">Solicitud de Boletos</field>
            <field name="model">cm.ticket.request</field>
            <field name="arch" type="xml">
                <form string="Soicitud de Boletos">
                    <header>
                        <button name="change_state" context="{'state': 'send'}" class="oe_highlight" type="object" string="Enviar" invisible="state != 'draft'"/>
                        <button name="change_state" context="{'state': 'draft'}" class="oe_highlight" type="object" string="Regresar a Borrador" invisible="state not in ['send','received']"/>
                        <button name="change_state" context="{'state': 'received'}" class="oe_highlight" type="object" string="Recibir" invisible="state not in ['send']" groups="cm_airline_ticket_request.group_ticket_request_manager,cm_airline_ticket_request.group_ticket_request_admin"/>
                        <button name="change_state" context="{'state': 'finalized'}" class="oe_highlight" type="object" string="Finalizar" invisible="state not in ['received']" groups="cm_airline_ticket_request.group_ticket_request_manager,cm_airline_ticket_request.group_ticket_request_admin"/>
                        <button name="change_state" context="{'state': 'canceled'}" class="oe_highlight" type="object" string="Cancelar" invisible="state in ['finalized','canceled']" confirm="¿Esta seguro de querer cancelar la solicitud?"/>
                        <button name="split_request"  class="oe_highlight" type="object" string="Dividir Solicitud" invisible="state in ['draft','finalized','canceled']"/>
                        <field name="state" widget="statusbar"/>
                  	</header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                                <field name="program_id" required="1" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                                <field name="airline_id" required="1" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                                <field name="request_type" required="1" readonly="state != 'draft'"/>
                                <field name="notifications_select" required="1" readonly="state != 'draft'"/>
                                <field name="ticket_type_request" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="date" readonly="1"/>
                                <field name="assigned_user_id" invisible="state in ['draft','send']" readonly="1" options="{'no_open': True}"/>
                                <field name="only_pnr" invisible="state in ['draft','send']" readonly="state != 'received'"/>
                                <field name="pnr" invisible="not only_pnr" required="only_pnr" readonly="state != 'received'"/>
                                <field name="pnr_file" required="only_pnr" invisible="not only_pnr" filename="pnr_file_name" widget="binary"/>
                                <field name="pnr_file_name" invisible="1"/>
                                <field name="request_date" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Rutas de Vuelo">
                                <field name="list_routes_ids" readonly="state != 'draft'" >
                                    <list editable="bottom">
                                        <field name="sequence" column_invisible="1" readonly="1"/>
                                        <field name="ticket_type" column_invisible="1" readonly="1" force_save="1"/>
                                        <field name="route_id" options="{'no_create': True}" required="1"/>
                                        <field name="date" required="1"/>
                                        <field name="flight_select" required="1"/>
                                        <field name="observations" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <notebook>
                            <page string="Pasajeros">
                                <field name="list_request_ids" readonly="state in ['finalized','canceled']" context="{'default_user_id': user_id}">
                                    <list>
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="phone" />
                                        <field name="split"/>
                                        <field name="pnr" />
                                        <field name="pnr_file" filename="pnr_file_name" widget="binary"/>
                                        <field name="pnr_file_name" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
					<chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="ticket_request_tree_view" model="ir.ui.view">
            <field name="name">Solicitud de Boletos</field>
            <field name="model">cm.ticket.request</field>
            <field name="arch" type="xml">
                <list string="Solicitud de Boletos">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="assigned_user_id"/>
                    <field name="date" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="ticket_request_search_view" model="ir.ui.view">
            <field name="name">Solicitud de Boletos search</field>
            <field name="model">cm.ticket.request</field>
            <field name="arch" type="xml">
                <search string="Solicitud de Boletos">
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="assigned_user_id" filter_domain="[('assigned_user_id', 'ilike', self)]"/>
                    <field name="program_id" filter_domain="[('program_id', 'ilike', self)]"/>
                    <field name="user_id" filter_domain="[('user_id', 'ilike', self)]"/>
                    <separator/>
                    <filter string="Enviadas" name="sending_filter" domain="[('state','=','send')]"/>
                    <filter string="Recibidas" name="received_filter" domain="[('state','=','received')]"/>
                    <filter string="Finalizadas" name="finalized_filter" domain="[('state','=','finalized')]"/>
                    <group>
                        <filter name="group_date" string="Fecha de Creacion" domain="[]" context="{'group_by':'date'}"/>
                        <filter name="group_program" string="Programa" domain="[]" context="{'group_by':'program_id'}"/>
                        <filter name="group_user" string="Solicitante" domain="[]" context="{'group_by':'user_id'}"/>
                        <filter name="group_state" string="Estado" domain="[]" context="{'group_by':'state'}"/>
                        <filter name="group_assigned" string="Asignado a " domain="[]" context="{'group_by':'assigned_user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_ticket_request_cm" model="ir.actions.act_window">            
            <field name="name">Solicitud de Boletos</field>
            <field name="res_model">cm.ticket.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>         
            <field name="domain" eval=""/>
        </record>

    </data>
</odoo>