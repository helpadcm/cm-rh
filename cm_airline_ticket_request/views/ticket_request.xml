        <record id="action_ticket_request_cm" model="ir.actions.act_window">            
            <field name="name">Solicitud de Boletos</field>
            <field name="res_model">cm.ticket.request</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>         
