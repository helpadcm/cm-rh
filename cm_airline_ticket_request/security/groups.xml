<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
		 <record model="ir.module.category" id="request_ticket_category">
		    <field name="name">Solicitud de Boletos</field>
		    <field name="description">Permisos para Solicitud de boletos</field>
		    <field name="sequence">20</field>
		</record>
		
		<record id="group_ticket_request_manager" model="res.groups">
			<field name="name">Encargado Gestion de boletos</field>
			<field name="category_id" ref="request_ticket_category"/>
		</record>
		
		<record id="group_ticket_request_user" model="res.groups">
			<field name="name">Usuario Solicitud de Boletos</field>
			<field name="category_id" ref="request_ticket_category"/>
		</record>

		<record id="group_ticket_request_admin" model="res.groups">
			<field name="name">Administrador Solicitud de Boletos</field>
			<field name="category_id" ref="request_ticket_category"/>
		</record>


<!-- ####################################  DEBIT / CREDIT RULES  #################################### -->
		<record id="ticket_request_user_rule" model="ir.rule">
            <field name="name">Regla usuario Boletos</field>
            <field name="model_id" ref="cm_airline_ticket_request.model_cm_ticket_request"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cm_airline_ticket_request.group_ticket_request_user'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

		<record id="ticket_request_manager_rule" model="ir.rule">
            <field name="name">Regla Administrador Boletos</field>
            <field name="model_id" ref="cm_airline_ticket_request.model_cm_ticket_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cm_airline_ticket_request.group_ticket_request_manager')),(4, ref('cm_airline_ticket_request.group_ticket_request_admin'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
	</data>
</odoo>


