<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_hours_record" model="ir.ui.view">
        <field name="name">hr.hour.record.form</field>
        <field name="model">hr.hours.employees</field>
        <field name="arch" type="xml">
            <form string="Employee Attendance Report">
                <sheet>
                    <group cols="4">
                        <group>
                            <field name="date_from" string="Fecha desde"/>
                            <field name="department_id" string="Departamento"/>
                            <field name="payslip_date_from" string="Fecha Inicio Nomina" readonly="1" force_save="1"/>
                        </group>
                        <group >
                            <field name="date_to" string="Fecha hasta"/>
                            <field name="employee_ids" string="Empleados" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="payslip_date_to" string="Fecha Fin Nomina" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Obtener Registros" type="object"
                                name="get_records" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hours_record_employee_action" model="ir.actions.act_window">
        <field name="name">Hours Employee Records</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hours.employees</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
