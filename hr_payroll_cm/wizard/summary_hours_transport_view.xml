<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_incomes_deductions_summary" model="ir.ui.view">
        <field name="name">hours.transport.summary.form</field>
        <field name="model">hours.transport.summary</field>
        <field name="arch" type="xml">
            <form string="Resumen Horas y Transporte">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                        </group>
                        <group >    
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Imprimir" type="object" name="print_report" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hours_transport_summary_action" model="ir.actions.act_window">
        <field name="name">Resumen Horas y Transporte</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hours.transport.summary</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
