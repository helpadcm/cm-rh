<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_historical_deductions_tree" model="ir.ui.view">
        <field name="name">historical.deductions.tree</field>
        <field name="model">hr.historical.deductions</field>
        <field name="arch" type="xml">
            <tree string="Deducciones" create="false" delete="false">
                <field name="name" />
                <field name="payslip_id" readonly="1"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="action_historical_ded" model="ir.actions.act_window">
        <field name="name">Deducciones</field>
        <field name="res_model">hr.historical.deductions</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
