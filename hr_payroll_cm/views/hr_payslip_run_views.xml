<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cm_payslip_run_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//header" position="inside">
                <button name="action_load_nomina_from_excel_wizard"
                        string="Cargar nomina desde Excel"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['draft', 'verify']"/>
                <button name="action_load_catorceavo_from_excel_wizard"
                        string="Cargar catorceavo desde Excel"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['draft', 'verify']"/>
                <button name="action_hr_payroll_payslips_report"
                        string="Generar Reporte"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['draft', 'verify']"/>
                />
            </xpath> -->
            <field name="schedule_pay" position="after">
                <field name="type_lot" required="1"/>
                <field name="journal_id" required="1" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="payslip_run_kanban_inherit" model="ir.ui.view">
        <field name="name">payslip.run.kanban.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <button name="action_draft" position="after">
                <button name="print_payslip_report" type="object" class="btn btn-secondary" string="Planilla XLS"/>
            </button>
        </field>
    </record>

    <record id="hr_work_entry_type_inherit" model="ir.ui.view">
        <field name="name">work.entry.type.inherit</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="hide_in_payslip" />
            </field>
        </field>
    </record>

    <record id="hr_payslip_input_type_inh" model="ir.ui.view">
        <field name="name">ht.payslip.input.inherit</field>
        <field name="model">hr.payslip.input.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_input_type_view_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="entry_type" />
            </field>
        </field> 
    </record>
</odoo>
