<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_payroll_cm.payslip_run_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_load_nomina_from_excel_wizard"
                        string="Load Nomina from Excel"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['draft', 'verify']"/>
                />
            </xpath>
        </field>
    </record>
</odoo>
