<odoo>
    <record id="hr_contract_inherit_cm" model="ir.ui.view">
        <field name="name">hr_payroll_cm.hr_historical.ded</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <button name="action_open_contract_list" position="after">
                <button name="show_historical" context="{'code': 'DED'}" class="oe_stat_button" icon="fa-list" type="object">
                    <div class="o_stat_info">
                        <!-- <span class="o_stat_value">
                            <field name="contracts_count"/>
                        </span> -->
                        <span class="o_stat_text" >
                            Deducciones
                        </span>
                    </div>
                </button>
            </button>
            <group name="contract_details_2" position="after">
                <group>
                    <field name="skip_rules_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </group>
            <field name="country_code" position="after">
                <field name="check_type" help="Campo utilizado para revision en nomina"/>
            </field>
        </field>
    </record>

    <record id="hr_department_inherit_cm" model="ir.ui.view">
        <field name="name">hr.department.inherit.list</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <field name="color" position="before">
                <field name="calculate_hours"/>
            </field>
        </field>
    </record>
</odoo>
