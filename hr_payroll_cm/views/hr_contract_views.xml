    <record id="hr_department_inherit_cm" model="ir.ui.view">
        <field name="name">hr.department.inherit.list</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <field name="color" position="before">
                <field name="analytic_account_id" options="{'no_create': True}"/>
                <field name="calculate_hours"/>
                <field name="priority_level"/>
            </field>
        </field>
    </record>

    <record id="hr_department_form_inherit_cm" model="ir.ui.view">
        <field name="name">hr.department.inherit.form</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <field name="color" position="before">
                <field name="analytic_account_id" options="{'no_create': True}"/>
                <field name="calculate_hours"/>
                <field name="priority_level"/>
            </field>
        </field>
    </record>

    <record id="cm_hr_employee_inherit" model="ir.ui.view">
        <field name="name">hr.employee.inherit.list</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <button name="action_open_versions" position="after">
                <button name="show_historical" context="{'code': 'DED'}" class="oe_stat_button" icon="fa-list" type="object">
                    <div class="o_stat_info">
                        <span class="o_stat_text" >
                            Deducciones
                        </span>
                    </div>
                </button>
            </button>
            <field name="version_id" position="before">
                <button string="Agregar Historial de salario" groups="hr_payroll_cm.manager_rrhh_cm" name="add_salarial_historical" type="object" class="oe_highlight"/>
            </field>
            <group name="user" position="inside">
                <field name="analytic_account_id" options="{'no_create': True}"/>
            </group>
            <field name="wage_type" position="after">
                <field name="monthly_wage"/>
                <field name="is_user_active" groups="hr.group_hr_user" invisible="1"/>
            </field>

            <xpath expr="//group[@name='identification_group']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='payroll_information']" position="attributes">
                <attribute name="groups">hr_payroll_cm.manager_rrhh_cm</attribute>
            </xpath>

            <xpath expr="//page[@name='work_information']//group[field[@name='parent_id']]" position="inside">
                <field name="pin" string="Codigo en Reloj" groups="hr.group_hr_user"/>
                <label for="barcode" groups="hr.group_hr_user" string="Codigo de empleado"/>
                <div class="o_row" groups="hr.group_hr_user" >
                    <field name="barcode" string="Codigo de empleado"/>
                    <button string="Generar" class="btn btn-link" type="object" name="generate_random_barcode" invisible="barcode"/>
                    <button name="%(hr.hr_employee_print_badge)d" string="Imprimir Insignia" class="btn btn-link" type="action" invisible="not barcode"/>
                </div>
            </xpath>

            <group name="note" position="before">   
                <group string="APROBADORES">
                    <field name="leave_manager_id" widget="many2one_avatar_user" string="Vacaciones" options="{'no_create': True}"/>
                    <field name="attendance_manager_id" widget="many2one_avatar_user" string="Asistencia" options="{'no_create': True}"/>
                </group>
            </group>


            <field name="registration_number" position="after">
                <field name="check_type" />
            </field>
            <field name="resource_calendar_id" position="after">
                <field name="skip_rules_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="level_number"/>
            </field>
        </field>
    </record>

    <record id="payroll_employee_form_inherit" model="ir.ui.view">
        <field name="name">payroll_employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <page name="salary_attachment" position="after">
                <page name="historica_salaries" string="Historial Salarios">
                    <field name="historical_salaries_ids">
                        <list editable="bottom" create="0">
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="end_date_payroll" />
                            <field name="amount" readonly="1" force_save="1"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="payroll_emp_form_inherit" model="ir.ui.view">
        <field name="name">payroll_emp.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <field name="is_non_resident" position="after">
                <field name="resident_number" invisible="not is_non_resident" required="is_non_resident"/>
            </field>

            <field name="is_non_resident" position="attributes">
                <attribute name="string">¿Posee carné de residente?</attribute>
            </field>
        </field>
    </record>

    <record id="teams_view_form_inherit" model="ir.ui.view">
        <field name="name">teams.form.inherit</field>
        <field name="model">hr.work.teams</field>
        <field name="inherit_id" ref="hr_turns_cm.view_turn_work_teams"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='member_employees_ids']/list/field[@name='job_id']" position="after">
                <field name="compensatory_day_string"/>
                <field name="available_vacations"/>
            </xpath>
        </field>
    </record>

    <record id="hr_account_view_form_inherit" model="ir.ui.view">
        <field name="name">account.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="calculate_type"/>
            </xpath>
        </field>
    </record>
</odoo>
