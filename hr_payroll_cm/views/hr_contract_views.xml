<odoo>
    <record id="hr_contract_inherit_cm" model="ir.ui.view">
        <field name="name">hr_payroll_cm.hr_historical.ded</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <button name="action_open_contract_list" position="after">
                <button name="show_historical" context="{'code': 'DED'}" class="oe_stat_button" icon="fa-list" type="object">
                    <div class="o_stat_info">
                        <!-- <span class="o_stat_value">
                            <field name="contracts_count"/>
                        </span> -->
                        <span class="o_stat_text" >
                            Deducciones
                        </span>
                    </div>
                </button>
            </button>
            <field name="state" position="before">
                <button string="Agregar Historial de salario" groups="hr_payroll_cm.manager_rrhh_cm" name="add_salarial_historical" type="object" class="oe_highlight"/>
            </field>
            <group name="contract_details_2" position="after">
                <group>
                    <field name="skip_rules_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </group>
            <field name="country_code" position="after">
                <field name="check_type" help="Campo utilizado para revision en nomina"/>
            </field>
            <notebook position="inside">
                <page name="historica_salaries" string="Historial Salarios">
                    <field name="historical_salaries_ids">
                        <tree create="0" edit="0">
                            <field name="date" />
                            <field name="amount" />
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="hr_department_inherit_cm" model="ir.ui.view">
        <field name="name">hr.department.inherit.list</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <field name="color" position="before">
                <field name="analytic_account_id" options="{'no_create': True}"/>
                <field name="calculate_hours"/>
            </field>
        </field>
    </record>

    <record id="hr_employee_inherit_cm" model="ir.ui.view">
        <field name="name">hr.employee.inherit.list</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="coach_id" position="after">
                <field name="analytic_account_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="teams_view_form_inherit" model="ir.ui.view">
        <field name="name">teams.form.inherit</field>
        <field name="model">hr.work.teams</field>
        <field name="inherit_id" ref="hr_turns_cm.view_turn_work_teams"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='member_employees_ids']/tree/field[@name='job_id']" position="after">
                <field name="compensatory_day_string"/>
            </xpath>
        </field>
    </record>

    <record id="account_view_form_inherit" model="ir.ui.view">
        <field name="name">account.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allowed_journal_ids']" position="after">
                <field name="calculate_type"/>
            </xpath>
        </field>
    </record>
</odoo>
