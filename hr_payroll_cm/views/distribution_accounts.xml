<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_distribution_expense_accounts_form" model="ir.ui.view">
        <field name="name">distribution.accounts.form</field>
        <field name="model">hr.distribution.expense.accounts</field>
        <field name="arch" type="xml">
            <form string="Distribución de cuentas de gastos">
                <sheet>
                    <h1><field name="name" required="1" placeholder="Descripcion"/></h1>
                    <group>
                        <field name="account_id" required="1" options="{'no_create': True}" />
                    </group>
                    <notebook>
                        <page name="distribution_lines" string="Distribucion">
                            <field name="distribution_line_ids">
                                <list editable="bottom">
                                    <field name="department_id" options="{'no_create': True}" required="1"/>
                                    <field name="account_budget_id" options="{'no_create': True}" required="1"/>
                                    <field name="process_id" options="{'no_create': True}" required="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>
    
    <record id="view_distribution_expense_accounts_list" model="ir.ui.view">
        <field name="name">distribution.expense.accounts.list</field>
        <field name="model">hr.distribution.expense.accounts</field>
        <field name="arch" type="xml">
            <list string="Distribución de cuentas de gastos">
                <field name="name"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="action_distribution_expense_accounts" model="ir.actions.act_window">
        <field name="name">Distribución de cuentas de gastos</field>
        <field name="res_model">hr.distribution.expense.accounts</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
