<odoo>
    <record id="hr_payroll_deduccion_view_form" model="ir.ui.view">
        <field name="name">hr_payroll_cm.HrSalaryAttachmentDeduction.inherit</field>
        <field name="model">hr.salary.attachment</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_attachment_view_form"/>
        <field name="arch" type="xml">
            <button name="action_done" position="before">
                <button string="Crear Plan" name="create_plan" invisible="state != 'open' or not by_quotes" type="object" class="oe_highlight"/>
            </button>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="first_date_payment" readonly="1" invisible="1"/>
            </xpath>
            <field name="paid_amount" position="after">
                <field name="remaining_amount"/>
                <field name="by_quotes"/>
            </field>
            <xpath expr="//sheet/group" position="after">
                <group name="name" string="Configuracion plan" invisible="not by_quotes">
                    <group>
                        <field name="payment_type" required="1"/>
                        <field name="monthly_type" invisible="payment_type != 'monthly'" required="payment_type == 'monthly'"/>
                    </group>
                    <group>
                        <field name="quotes_number" readonly="state != 'open'"/>
                        <field name="fixed_fee" readonly="state != 'open'"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="payment_plan" string="Plan de pago" invisible="not by_quotes">
                        <field name="payment_plan_ids">
                            <tree editable="bottom" create="false">
                                <field name="number" readonly="1"/>
                                <field name="date" readonly="1"/>
                                <field name="amount" readonly="1" sum="Total"/>
                                <field name="state" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
