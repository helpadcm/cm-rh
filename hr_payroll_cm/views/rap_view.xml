<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_rap_settings_tree" model="ir.ui.view">
        <field name="name">rap.settings.tree</field>
        <field name="model">hr.settings.rap</field>
        <field name="arch" type="xml">
            <tree string="Configuracion RAP" editable="bottom">
                <field name="name" readonly="1"/>
                <field name="min_salary"/>
                <field name="percentage"/>
            </tree>
        </field>
    </record>

    <record id="action_rap_settings" model="ir.actions.act_window">
        <field name="name">Configuraciones RAP</field>
        <field name="res_model">hr.settings.rap</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
