<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_payroll_payslips_report_form" model="ir.ui.view">
        <field name="name">hr.payroll.payslips.report.form</field>
        <field name="model">hr.payroll.payslips.report</field>
        <field name="arch" type="xml">
            <form string="Payroll Payslips Report">
                <group>
                    <field name="payslip_run_id"/>
                    <field name="payslips_ids" readonly="1"/>
                    <field name="file" readonly="1"/>
                    <field name="name" readonly="1"/>
                </group>
                <footer>
                    <button string="Process" type="object" name="process_payslip" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_payslips_report" model="ir.actions.act_window">
        <field name="name">Payroll Payslips Report</field>
        <field name="res_model">hr.payroll.payslips.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" 
               ref="view_hr_payroll_payslips_report_form"/>
        <field name="target">new</field>
    </record>
</odoo>
