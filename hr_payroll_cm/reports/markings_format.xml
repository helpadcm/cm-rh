<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="marking_format_cm">
        <t t-call="web.html_container">
            <head>
                <meta charset="utf-8"/>
            </head>
            <t t-foreach="docs" t-as="o">
                <div class="page" style="page-break-before: always; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; font-size: 11px;">
                    <style>
                        .banner-box {
                            background-color: #72B944;
                            color: #ffffff;
                            border-radius: 8px;
                            padding: 14px 18px;
                            margin-bottom: 12px;
                        }
                        .limit-badge {
                            background-color: #ffffff;
                            color: #162b44;
                            border-radius: 6px;
                            padding: 8px 14px;
                            font-size: 13px;
                        }
                        .kpi-table {
                            width: 100%;
                            border-collapse: separate;
                            border-spacing: 8px 0;
                            margin: 0 -8px 12px -8px;
                        }
                        .kpi-card {
                            background-color: #f8fafc;
                            border: 1px solid #e2e8f0;
                            border-radius: 8px;
                            padding: 10px 12px;
                            vertical-align: top;
                            width: 25%;
                        }
                        .kpi-card-green {
                            background-color: #72a880;
                            border: 1px solid #5f946d;
                            border-radius: 8px;
                            padding: 10px 12px;
                            vertical-align: top;
                            width: 25%;
                            color: #ffffff;
                        }
                        .kpi-title {
                            font-size: 11px;
                            font-weight: bold;
                            text-transform: uppercase;
                            text-align: center;
                            margin-bottom: 8px;
                            letter-spacing: 0.4px;
                        }
                        .kpi-inner {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .kpi-inner td {
                            padding: 2px 0;
                            font-size: 12px;
                        }
                        .main-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 10px;
                        }
                        .th-group-turn {
                            background-color: #1A9AA2;
                            color: #ffffff;
                            font-weight: bold;
                            text-align: center;
                            padding: 5px;
                            border: 1px solid #ffffff;
                            border-top-left-radius: 6px;
                            border-top-right-radius: 6px;
                        }
                        .th-group-auth {
                            background-color: #e2e8f0;
                            color: #1e293b;
                            font-weight: bold;
                            text-align: center;
                            padding: 5px;
                            border: 1px solid #cbd5e1;
                            border-top-left-radius: 6px;
                            border-top-right-radius: 6px;
                        }
                        .th-sub {
                            background-color: #1A9AA2;
                            color: #ffffff;
                            font-weight: bold;
                            text-align: center;
                            padding: 6px 4px;
                            border-right: 1px solid #7ca0cc;
                        }
                        .td-row {
                            padding: 5px 4px;
                            border-bottom: 1px solid #e2e8f0;
                            text-align: center;
                            vertical-align: middle;
                        }
                        .row-free {
                            background-color: #f8fafc;
                            color: #94a3b8;
                        }
                        .badge-plan {
                            background-color: #e2e8f0;
                            color: #475569;
                            padding: 2px 7px;
                            border-radius: 4px;
                            font-weight: bold;
                            font-size: 9px;
                            display: inline-block;
                        }
                        .badge-mark {
                            background-color: #e2e8f0;
                            color: #475569;
                            padding: 2px 7px;
                            border-radius: 4px;
                            font-weight: bold;
                            font-size: 9px;
                            display: inline-block;
                        }
                        .badge-obs {
                            background-color: #e2e8f0;
                            color: #475569;
                            padding: 2px 8px;
                            border-radius: 4px;
                            font-size: 9px;
                            display: inline-block;
                        }
                        .notes-box {
                            border: 1px solid #cbd5e1;
                            border-radius: 8px;
                            padding: 10px 14px;
                            min-height: 55px;
                            background-color: #ffffff;
                        }
                    </style>

                    <!-- 1. BANNER SUPERIOR -->
                    <div class="banner-box">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 12%; vertical-align: middle;">
                                    <img t-if="o.employee_id.company_id.logo" t-att-src="image_data_uri(o.employee_id.company_id.logo)" style="max-height: 45px; max-width: 90px; background: #ffffff; padding: 4px; border-radius: 4px;"/>
                                </td>
                                <td style="width: 66%; vertical-align: middle; padding-left: 10px;">
                                    <div style="font-size: 18px; font-weight: bold; letter-spacing: 0.5px; margin-bottom: 4px;">
                                        <span t-field="o.employee_id.name"/>
                                    </div>
                                    <div style="font-size: 11px; color: #000000;">
                                        <span>Depto: <strong style="color: #ffffff;"><span t-field="o.department_id.name"/></strong></span>
                                        <span style="margin-left: 20px;">PERÍODO DE REPORTE: <strong style="color: #ffffff;"><span t-field="o.start_date"/> - <span t-field="o.end_date"/></strong></span>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- 2. TARJETAS DE RESUMEN (KPIs) -->
                    <table class="kpi-table">
                        <tr>
                            <!-- Card 1: Resumen de Horas -->
                            <td class="kpi-card">
                                <div class="kpi-title" style="color: #1e293b;">Resumen de Horas</div>
                                <table class="kpi-inner">
                                    <tr>
                                        <td style="color: #475569;">Horas Totales:</td>
                                        <td style="text-align: right; font-weight: bold;"><span t-esc="'{0:,.2f}'.format(o.total_hours)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #475569;">Horas Esperadas:</td>
                                        <td style="text-align: right; font-weight: bold;"><span t-field="o.esperated_hours"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #475569;">Diferencia:</td>
                                        <td style="text-align: right; font-weight: bold;"><span t-esc="'{0:,.2f}'.format(o.diff_hours)"/></td>
                                    </tr>
                                </table>
                            </td>

                            <!-- Card 2: Resumen de Bonos -->
                            <td class="kpi-card">
                                <div class="kpi-title" style="color: #1e293b;">Limites</div>
                                <table class="kpi-inner">
                                    <tr>
                                        <td style="color: #475569;">HE Limite:</td>
                                        <td style="text-align: right; font-weight: bold;"><span t-esc="'{0:,.2f}'.format(o.eh_limit)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #475569;">ST Limite:</td>
                                        <td style="text-align: right; font-weight: bold;"><span t-esc="'{0:,.2f}'.format(o.tb_max)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #475569;">Valor ST:</td>
                                        <td style="text-align: right; font-weight: bold;"><span t-esc="'{0:,.2f}'.format(o.tb_bonus)"/></td>
                                    </tr>
                                </table>
                            </td>

                            <!-- Card 3: Totales a Pagar -->
                            <td class="kpi-card-green">
                                <div class="kpi-title" style="color: #ffffff;">Totales a pagar</div>
                                <table class="kpi-inner" style="margin-top: 10px;">
                                    <tr>
                                        <td style="font-size: 12px;">Horas Extras:</td>
                                        <td style="text-align: right; font-weight: bold; font-size: 13px;"><span t-esc="'{0:,.2f}'.format(o.pay_extra_hours)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-size: 12px; padding-top: 6px;">Subsidio de Transporte:</td>
                                        <td style="text-align: right; font-weight: bold; font-size: 13px; padding-top: 6px;"><span t-esc="'{0:,.2f}'.format(o.tb_pay)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-size: 12px; padding-top: 6px;">HO Feriado Trabajado:</td>
                                        <td style="text-align: right; font-weight: bold; font-size: 13px; padding-top: 6px;"><span t-esc="'{0:,.2f}'.format(o.eh_holiday)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-size: 12px; padding-top: 6px;">HE Feriado Trabajado:</td>
                                        <td style="text-align: right; font-weight: bold; font-size: 13px; padding-top: 6px;"><span t-esc="'{0:,.2f}'.format(o.eh_holiday_extra)"/></td>
                                    </tr>
                                </table>
                            </td>

                            <!-- Card 4: Recargos y Feriados -->
                            <td class="kpi-card">
                                <div class="kpi-title" style="color: #1e293b;">Distribucion HE</div>
                                <table class="kpi-inner">
                                    <tr>
                                        <td style="color: #475569;">HE 25%:</td>
                                        <td style="text-align: right; font-weight: bold; padding-right: 6px;"><span t-esc="'{0:,.2f}'.format(o.hours_25)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #475569;">HE 50%:</td>
                                        <td style="text-align: right; font-weight: bold; padding-right: 6px;"><span t-esc="'{0:,.2f}'.format(o.hours_50)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #475569;">HE 75%:</td>
                                        <td style="text-align: right; font-weight: bold; padding-right: 6px;"><span t-esc="'{0:,.2f}'.format(o.hours_75)"/></td>
                                        <td colspan="2"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- 3. TABLA DE REGISTRO DIARIO -->
                    <table class="main-table">
                        <tr>
                            <th colspan="3"></th>
                            <th colspan="2" class="th-group-turn"><strong>Turno 1</strong></th>
                            <th colspan="2" class="th-group-turn"><strong>Turno 2</strong></th>
                            <th colspan="2" class="th-group-turn"><strong>Turno 3</strong></th>
                        </tr>
                        <tr>
                            <th class="th-sub" style="width: 7.5%;">Fecha</th>
                            <th class="th-sub" style="width: 7.5%;">Día</th>
                            <th class="th-sub" style="width: 8%;">Revisado por</th>
                            <th class="th-sub" style="width: 6.5%;">Entrada</th>
                            <th class="th-sub" style="width: 6.5%;">Salida</th>
                            <th class="th-sub" style="width: 6.5%;">Entrada</th>
                            <th class="th-sub" style="width: 6.5%;">Salida</th>
                            <th class="th-sub" style="width: 6.5%;">Entrada</th>
                            <th class="th-sub" style="width: 6.5%;">Salida</th>
                            <th class="th-sub" style="width: 7%;">Trabajadas</th>
                            <th class="th-sub" style="width: 5.5%; border-left: 2px solid #94a3b8;">HO</th>
                            <th class="th-sub" style="width: 5.5%;">HE</th>
                            <th class="th-sub" style="width: 14.5%;">Observaciones</th>
                            <th class="th-sub" style="width: 5.5%; border-right: none;">BT</th>
                        </tr>
                        <tbody>
                            <t t-foreach="o.record_line_ids" t-as="line">
                                <tr t-att-class="'row-free' if line.total_hours == 0 else ''">
                                    <td class="td-row" style="color: #1e293b;"><span t-field="line.date"/></td>
                                    <td class="td-row" style="color: #1e293b;">
                                        <t t-if="line.date.weekday() == 0">Lunes</t>
                                        <t t-if="line.date.weekday() == 1">Martes</t>
                                        <t t-if="line.date.weekday() == 2">Miércoles</t>
                                        <t t-if="line.date.weekday() == 3">Jueves</t>
                                        <t t-if="line.date.weekday() == 4">Viernes</t>
                                        <t t-if="line.date.weekday() == 5">Sábado</t>
                                        <t t-if="line.date.weekday() == 6">Domingo</t>
                                    </td>
                                    <td class="td-row">
                                        <span t-if="line.check_type == 'turn'" class="badge-plan">Planificación</span>
                                        <span t-if="line.check_type == 'mark'" class="badge-mark">Marcaje</span>
                                    </td>

                                    <!-- Horarios Marcaje -->
                                    <t t-if="line.check_type == 'mark'">
                                        <td class="td-row"><span t-field="line.check_in_1"/></td>
                                        <td class="td-row"><span t-field="line.check_out_1"/></td>
                                        <td class="td-row"><span t-field="line.check_in_2"/></td>
                                        <td class="td-row"><span t-field="line.check_out_2"/></td>
                                        <td class="td-row"><span t-field="line.check_in_3"/></td>
                                        <td class="td-row"><span t-field="line.check_out_3"/></td>
                                    </t>

                                    <!-- Horarios Planificación -->
                                    <t t-if="line.check_type == 'turn'">
                                        <td class="td-row"><span t-field="line.schedule1_in_date"/></td>
                                        <td class="td-row"><span t-field="line.schedule1_out_date"/></td>
                                        <td class="td-row"><span t-field="line.schedule2_in_date"/></td>
                                        <td class="td-row"><span t-field="line.schedule2_out_date"/></td>
                                        <td class="td-row"></td>
                                        <td class="td-row"></td>
                                    </t>

                                    <td class="td-row" style="font-weight: bold;"><span t-esc="'{0:,.2f}'.format(line.total_hours)"/></td>
                                    <td class="td-row" style="border-left: 1px solid #cbd5e1;"><span t-esc="'{0:,.2f}'.format(line.ordinary_hours)"/></td>
                                    <td class="td-row"><span t-esc="'{0:,.2f}'.format(line.extra_hours)"/></td>
                                    <td class="td-row" style="text-align: left; padding-left: 8px;">
                                        <t t-if="line.personal_action or line.turn_note">
                                            <span class="badge-obs">
                                                <span t-field="line.personal_action"/><t t-if="line.personal_action and line.turn_note">, </t><span t-field="line.turn_note"/>
                                            </span>
                                        </t>
                                    </td>
                                    <td class="td-row"><span t-esc="'{0:,.2f}'.format(line.bonus)"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- 4. PIE DE PÁGINA: NOTAS Y FIRMAS -->
                    <table style="width: 100%; margin-top: 16px; border-collapse: collapse;">
                        <tr>
                            <td style="width: 100%; vertical-align: top;">
                                <div style="font-weight: bold; font-size: 11px; margin-bottom: 4px; color: #1e293b;">Notas Registradas</div>
                                <div class="notes-box">
                                    <t t-if="o.message_ids">
                                        <ul style="margin: 0; padding-left: 16px; font-size: 10px; color: #334155;">
                                            <t t-foreach="o.message_ids.filtered(lambda m: m.message_type == 'comment')" t-as="note">
                                                <li style="margin-bottom: 2px;">
                                                    <t t-out="note.body"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>
</odoo>