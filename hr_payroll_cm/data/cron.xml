<odoo>
    <data noupdate="1">
        <record id="ir_cron_finalize_other_incomes" model="ir.cron">
            <field name="name">Otros Ingresos: Finalizar ingresos</field>
            <field name="model_id" ref="hr_payroll_cm.model_hr_other_incomes"/>
            <field name="state">code</field>
            <field name="code">model.finalize_incomes()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_finalize_deductions" model="ir.cron">
            <field name="name">Deducciones: Finalizar deducciones</field>
            <field name="model_id" ref="hr_payroll_cm.model_hr_other_deductions"/>
            <field name="state">code</field>
            <field name="code">model.finalize_deductions()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_delete_conflits" model="ir.cron">
            <field name="name">Entradas de trabajo: Eliminar registros en conflicto</field>
            <field name="model_id" ref="hr_work_entry.model_hr_work_entry"/>
            <field name="state">code</field>
            <field name="code">model.delete_conflict()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="action_server_finalize_incomes" model="ir.actions.server">
            <field name="name">Finalizar Ingreso</field>
            <field name="model_id" ref="hr_payroll_cm.model_hr_other_incomes"/>
            <field name="binding_model_id" ref="hr_payroll_cm.model_hr_other_incomes"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.write({'state': 'completed'})
            </field>
        </record>
    </data>
</odoo>